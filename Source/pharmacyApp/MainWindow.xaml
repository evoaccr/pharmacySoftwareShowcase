<Window x:Class="pharmacyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Pharmacy" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TopMenu" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#92979D"/>
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    Padding="{TemplateBinding Padding}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="TabFocus" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    Margin="3" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFocus" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#425466"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#E7EDF1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#D6E0E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TopMenuHost" Grid.Row="0" Background="White" BorderBrush="#C8CDD2" BorderThickness="0,0,0,1">
            <Grid>
                <Menu x:Name="TopMenuBar" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Minimize">
                        <Path Data="M 2,7.5 L 12,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Maximize or restore">
                        <Grid Width="14" Height="14">
                            <Path x:Name="MaximizeGlyph" Data="M 2.5,2.5 L 11.5,2.5 L 11.5,11.5 L 2.5,11.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                            <Path x:Name="RestoreGlyph" Visibility="Collapsed"
                                  Data="M 4.5,2.5 L 11.5,2.5 L 11.5,9.5 M 2.5,4.5 L 9.5,4.5 L 9.5,11.5 L 2.5,11.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Close">
                        <Path Data="M 2.5,2.5 L 11.5,11.5 M 11.5,2.5 L 2.5,11.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="TabBarHost" Grid.Row="1" Background="#E4E7EA" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" AllowDrop="True"
                PreviewMouseWheel="TabScrollViewerMouseWheel">
            <DockPanel LastChildFill="True">
                <StackPanel x:Name="SettingsTabStrip" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,8,12,0"/>
                <StackPanel x:Name="HomeTabStrip" DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,8,5,0"/>
                <ScrollViewer x:Name="NormalTabsScrollViewer"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="0,8,12,0" AllowDrop="True"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Border Margin="0" Background="White" BorderBrush="#C8CDD2" BorderThickness="0" CornerRadius="0">
                <Grid x:Name="WorkspaceDropHost" AllowDrop="True" ClipToBounds="True">
                    <ContentControl x:Name="Workspace" Margin="0"/>
                    <Border x:Name="EmptyState" Background="White" CornerRadius="0" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="No open panels" FontSize="14" Foreground="{StaticResource Ink}" Margin="0,0,0,4"/>
                            <TextBlock Text="Open a module from the top menu." Foreground="{StaticResource MutedInk}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DropIndicator" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="#66315A73" BorderBrush="#315A73" BorderThickness="2" CornerRadius="0" Margin="8">
                        <TextBlock x:Name="DropIndicatorText" Foreground="White" Background="#CC294C62"
                                   FontSize="13" FontWeight="SemiBold" Padding="12,7" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
