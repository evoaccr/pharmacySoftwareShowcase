<UserControl x:Class="pharmacyApp.Modules.Sales.RetailSalesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sales="clr-namespace:pharmacyApp.Modules.Sales"
             Background="#F2F3F4" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65717E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#F0F2F4"/>
            <Setter Property="Foreground" Value="#315A73"/>
            <Setter Property="BorderBrush" Value="#C6D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SalesGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8CDD2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8ECEF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style x:Key="SaleRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}">
            <Setter Property="Background" Value="#EAF7EE"/>
            <Setter Property="Foreground" Value="#27343E"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TransactionType}" Value="{x:Static sales:RetailTransactionTypes.PrescriptionSale}">
                    <Setter Property="Background" Value="#E4EFFA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TransactionType}" Value="{x:Static sales:RetailTransactionTypes.RetailRefund}">
                    <Setter Property="Background" Value="#EFE0D1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TransactionType}" Value="{x:Static sales:RetailTransactionTypes.PrescriptionRefund}">
                    <Setter Property="Background" Value="#F0E8F8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TransactionType}" Value="{x:Static sales:RetailTransactionTypes.ConsignmentSale}">
                    <Setter Property="Background" Value="#FFF2CC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TransactionType}" Value="{x:Static sales:RetailTransactionTypes.ConsignmentCancellation}">
                    <Setter Property="Background" Value="#F8D7C9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                    <Setter Property="BorderBrush" Value="#D8A419"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="DetailsVisibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="DetailsVisibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MovementCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SuggestionListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MaxHeight" Value="145"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="ArrowButton" TargetType="ToggleButton" BasedOn="{StaticResource SquareToggleButtonStyle}">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Path Data="M0,0 L6,6.5 L0,13" Stroke="#50616B" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="SalesRowContextMenu" x:Shared="False">
            <MenuItem Tag="Patient" Header="Go to Patient" Click="OnGoToPatientClicked"/>
            <MenuItem Tag="Mark" Header="Mark Sale" Click="OnToggleMarkClicked"/>
            <MenuItem Tag="Refund" Header="Return Sale" Click="OnRefundSaleClicked"/>
            <Separator Tag="ConsignmentSeparator"/>
            <MenuItem Tag="ReturnConsignment" Header="Return Consignment" Click="OnReturnConsignmentClicked"/>
            <MenuItem Tag="SettleConsignment" Header="Complete Retail Sale" Click="OnSettleConsignmentClicked"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#C8CDD2" BorderThickness="1"
                CornerRadius="0" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Width="42" Height="32"
                        Margin="12,15,0,8" VerticalAlignment="Top"
                        Background="#294C62" Foreground="White" BorderBrush="#294C62"
                        ToolTip="Refresh" Click="OnRefreshClicked">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="ClearFiltersButton" DockPanel.Dock="Right" Width="42" Height="32"
                        Margin="6,15,0,8" VerticalAlignment="Top"
                        Background="#B42318" Foreground="White" BorderBrush="#B42318"
                        ToolTip="Clear Filters" Click="OnClearFiltersClicked">
                    <Viewbox Width="17" Height="17">
                        <Path Data="M2,3 H18 L12,10 V17 L8,19 V10 Z" Fill="White" Stretch="Uniform"/>
                    </Viewbox>
                </Button>
                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="QR Code" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="QrFilterBox" Style="{StaticResource FilterBox}" Width="180" TextChanged="OnSimpleFilterChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Barcode, product name or brand" Style="{StaticResource FilterLabel}"/>
                        <Grid>
                            <TextBox x:Name="ProductFilterBox" Style="{StaticResource FilterBox}" Width="265"
                                     TextChanged="OnProductFilterTextChanged"/>
                            <Popup x:Name="ProductSuggestionPopup" PlacementTarget="{Binding ElementName=ProductFilterBox}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Width="360" MaxHeight="380" Background="White" BorderBrush="#AEBCC4"
                                        BorderThickness="1" CornerRadius="0" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Medicine Names" Foreground="#65717E" FontSize="11"
                                                   FontWeight="SemiBold" Margin="5,2,5,3"/>
                                        <ListBox x:Name="MedicineSuggestionList" Style="{StaticResource SuggestionListStyle}"
                                                 SelectionChanged="OnProductSuggestionSelected">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type sales:SaleProductSuggestion}">
                                                    <TextBlock Text="{Binding DisplayText}" Margin="7,5" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#18212B"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasStock}" Value="False"><Setter Property="Foreground" Value="#98A1A8"/></DataTrigger></Style.Triggers>
                                                        </Style></TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Separator Margin="4,5"/>
                                        <TextBlock Text="Brands" Foreground="#65717E" FontSize="11"
                                                   FontWeight="SemiBold" Margin="5,2,5,3"/>
                                        <ListBox x:Name="BrandSuggestionList" Style="{StaticResource SuggestionListStyle}"
                                                 SelectionChanged="OnProductSuggestionSelected">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type sales:SaleProductSuggestion}">
                                                    <TextBlock Text="{Binding DisplayText}" Foreground="#18212B" FontWeight="Bold"
                                                               Margin="7,5" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Quick Date" Style="{StaticResource FilterLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Today" Tag="Day" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClicked"/>
                            <Button Content="This Week" Tag="Week" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClicked"/>
                            <Button Content="This Month" Tag="Month" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClicked"/>
                            <Button Content="This Year" Tag="Year" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClicked"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8"><TextBlock Text="Start" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="StartDatePicker" Width="130" Height="32" SelectedDateChanged="OnDateChanged"/></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="End" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="EndDatePicker" Width="130" Height="32" SelectedDateChanged="OnDateChanged"/></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="User" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="UserFilter" Width="175" Height="32" DisplayMemberPath="DisplayText" SelectionChanged="OnComboFilterChanged"/></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="Sale type" Style="{StaticResource FilterLabel}"/>
                        <Button x:Name="SaleTypeFilterButton" Width="150" Height="32" Content="All"
                                HorizontalContentAlignment="Left" Padding="9,4" Click="OnSaleTypeFilterClicked"/>
                        <Popup x:Name="SaleTypeFilterPopup" PlacementTarget="{Binding ElementName=SaleTypeFilterButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="235" Margin="0,4,0,0" Padding="10" Background="White"
                                    BorderBrush="#AEBCC4" BorderThickness="1" CornerRadius="0">
                                <StackPanel>
                                    <CheckBox x:Name="PrescriptionRefundTypeCheckBox" Content="Prescription Return" Margin="4"
                                              Checked="OnSaleTypeChanged" Unchecked="OnSaleTypeChanged"/>
                                    <CheckBox x:Name="PrescriptionSaleTypeCheckBox" Content="Prescription Sale" Margin="4"
                                              Checked="OnSaleTypeChanged" Unchecked="OnSaleTypeChanged"/>
                                    <CheckBox x:Name="RetailSaleTypeCheckBox" Content="Retail Sale" Margin="4"
                                              Checked="OnSaleTypeChanged" Unchecked="OnSaleTypeChanged"/>
                                    <CheckBox x:Name="RetailRefundTypeCheckBox" Content="Retail Return" Margin="4"
                                              Checked="OnSaleTypeChanged" Unchecked="OnSaleTypeChanged"/>
                                    <CheckBox x:Name="ConsignmentSaleTypeCheckBox" Content="Consignment Sale" Margin="4"
                                              Checked="OnSaleTypeChanged" Unchecked="OnSaleTypeChanged"/>
                                    <CheckBox x:Name="ConsignmentCancellationTypeCheckBox" Content="Cancel Consignment" Margin="4"
                                              Checked="OnSaleTypeChanged" Unchecked="OnSaleTypeChanged"/>
                                    <Separator Margin="2,7"/>
                                    <UniformGrid Columns="2">
                                        <Button Content="Select All" Margin="0,0,4,0" Padding="5,4"
                                                Click="OnSelectAllSaleTypesClicked"/>
                                        <Button Content="Clear Selection" Margin="4,0,0,0" Padding="5,4"
                                                Click="OnDeselectAllSaleTypesClicked"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="On Account" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="DebtFilter" Width="125" Height="32" SelectedIndex="0" SelectionChanged="OnComboFilterChanged">
                            <ComboBoxItem Content="All" Tag="All"/><ComboBoxItem Content="With On-account Balance" Tag="Debted"/><ComboBoxItem Content="Without On-account Balance" Tag="NotDebted"/>
                        </ComboBox></StackPanel>
                    <StackPanel Margin="0,0,12,8" VerticalAlignment="Bottom">
                        <CheckBox x:Name="MarkedOnlyCheckBox" Content="Marked items only" Height="32"
                                  VerticalContentAlignment="Center" Checked="OnMarkedFilterChanged" Unchecked="OnMarkedFilterChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="Patient" Style="{StaticResource FilterLabel}"/>
                        <Grid><TextBox x:Name="PatientFilterBox" Style="{StaticResource FilterBox}" Width="195" TextChanged="OnPatientFilterTextChanged"/>
                            <Popup x:Name="PatientSuggestionPopup" PlacementTarget="{Binding ElementName=PatientFilterBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Width="330" MaxHeight="260" Background="White" BorderBrush="#AEBCC4" BorderThickness="1" CornerRadius="0" Padding="6">
                                    <ListBox x:Name="PatientSuggestionList" Style="{StaticResource SuggestionListStyle}" DisplayMemberPath="DisplayText" SelectionChanged="OnPatientSuggestionSelected"/>
                                </Border>
                            </Popup>
                        </Grid></StackPanel>
                    <StackPanel Margin="0,0,8,8"><TextBlock Text="Minimum total" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="MinimumTotalBox" Style="{StaticResource FilterBox}" Width="90" TextChanged="OnSimpleFilterChanged"/></StackPanel>
                    <StackPanel Margin="0,0,0,8"><TextBlock Text="Maximum total" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="MaximumTotalBox" Style="{StaticResource FilterBox}" Width="90" TextChanged="OnSimpleFilterChanged"/></StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="SalesGrid" Style="{StaticResource SalesGridStyle}" RowStyle="{StaticResource SaleRowStyle}"
                      SelectionChanged="OnSaleSelectionChanged"
                      PreviewMouseRightButtonDown="OnSalesGridRightClick"
                      ContextMenuOpening="OnSalesGridContextMenuOpening"
                      ContextMenu="{StaticResource SalesRowContextMenu}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Medicine Quantity" Binding="{Binding MedicineQuantity}" Width="95"/>
                    <DataGridTemplateColumn Header="Patient Name" Width="*" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type sales:RetailSaleListItem}">
                                <TextBlock Text="{Binding PatientDisplay}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Background="Transparent"
                                           MouseLeftButtonDown="OnPatientNameMouseDown"
                                           ToolTip="Double-click to open patient details"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Prescription No." Binding="{Binding PrescriptionDisplay}" Width="105"/>
                    <DataGridTextColumn Header="Cash" Binding="{Binding CashDisplay}" Width="82"/>
                    <DataGridTextColumn Header="Card" Binding="{Binding CreditDisplay}" Width="82"/>
                    <DataGridTextColumn Header="Bank Transfer" Binding="{Binding TransferDisplay}" Width="82"/>
                    <DataGridTextColumn Header="On Account" Binding="{Binding DebtDisplay}" Width="82"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding DiscountDisplay}" Width="82"/>
                    <DataGridTextColumn Header="Public" Binding="{Binding InstitutionDisplay}" Width="82"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="88"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding NotesDisplay}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MovementCellText}">
                                <Setter Property="ToolTip" Value="{Binding NotesDisplay}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="User" Binding="{Binding UserDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Date + Time" Binding="{Binding TimestampDisplay}" Width="145"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid x:Name="SplitGridHost" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Incoming Operations" Margin="2,0,0,7" Foreground="#27343E" FontWeight="SemiBold"/>
                    <DataGrid x:Name="EntrySalesGrid" Grid.Row="1" Style="{StaticResource SalesGridStyle}" RowStyle="{StaticResource SaleRowStyle}"
                              SelectionChanged="OnSaleSelectionChanged" PreviewMouseRightButtonDown="OnSalesGridRightClick"
                              ContextMenuOpening="OnSalesGridContextMenuOpening" ContextMenu="{StaticResource SalesRowContextMenu}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Medicine Quantity" Binding="{Binding MedicineQuantity}" Width="95"/>
                            <DataGridTextColumn Header="Patient Name" Binding="{Binding PatientDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Prescription No." Binding="{Binding PrescriptionDisplay}" Width="105"/>
                            <DataGridTextColumn Header="Cash" Binding="{Binding CashDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Card" Binding="{Binding CreditDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Bank Transfer" Binding="{Binding TransferDisplay}" Width="82"/>
                            <DataGridTextColumn Header="On Account" Binding="{Binding DebtDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Discount" Binding="{Binding DiscountDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Public" Binding="{Binding InstitutionDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="88"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding NotesDisplay}" Width="160"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Date + Time" Binding="{Binding TimestampDisplay}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EntryCountText" Grid.Row="2" Margin="2,7,0,0" Foreground="#53636D" Text="Total records: 0"/>
                </Grid>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#C8CDD2" ShowsPreview="True"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Outgoing Operations" Margin="10,0,0,7" Foreground="#27343E" FontWeight="SemiBold"/>
                    <DataGrid x:Name="ExitSalesGrid" Grid.Row="1" Margin="10,0,0,0" Style="{StaticResource SalesGridStyle}" RowStyle="{StaticResource SaleRowStyle}"
                              SelectionChanged="OnSaleSelectionChanged" PreviewMouseRightButtonDown="OnSalesGridRightClick"
                              ContextMenuOpening="OnSalesGridContextMenuOpening" ContextMenu="{StaticResource SalesRowContextMenu}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Medicine Quantity" Binding="{Binding MedicineQuantity}" Width="95"/>
                            <DataGridTextColumn Header="Patient Name" Binding="{Binding PatientDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Prescription No." Binding="{Binding PrescriptionDisplay}" Width="105"/>
                            <DataGridTextColumn Header="Cash" Binding="{Binding CashDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Card" Binding="{Binding CreditDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Bank Transfer" Binding="{Binding TransferDisplay}" Width="82"/>
                            <DataGridTextColumn Header="On Account" Binding="{Binding DebtDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Discount" Binding="{Binding DiscountDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Public" Binding="{Binding InstitutionDisplay}" Width="82"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="88"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding NotesDisplay}" Width="160"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Date + Time" Binding="{Binding TimestampDisplay}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ExitCountText" Grid.Row="2" Margin="12,7,0,0" Foreground="#53636D" Text="Total records: 0"/>
                </Grid>
            </Grid>

            <Border x:Name="DetailPanel" Grid.Row="1" Height="285" Margin="0,12,0,0" Visibility="Collapsed"
                    Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DetailTitle" Text="Sale Contents" Foreground="#27343E" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <DataGrid x:Name="SaleDetailGrid" Grid.Row="1" Style="{StaticResource SalesGridStyle}" RowStyle="{StaticResource DetailRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Product Name" Width="*" MinWidth="260">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type sales:RetailSaleProductGroup}">
                                    <DockPanel LastChildFill="True">
                                        <ToggleButton Style="{StaticResource ArrowButton}" DockPanel.Dock="Left" Margin="0,0,7,0"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}" Click="OnProductExpandClicked"/>
                                        <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockDisplay}" Width="75"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="70"/>
                            <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCostDisplay}" Width="115"/>
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPriceDisplay}" Width="115"/>
                            <DataGridTextColumn Header="Total Price" Binding="{Binding TotalPriceDisplay}" Width="125"/>
                            <DataGridTextColumn Header="Discount" Binding="{Binding TotalDiscountDisplay}" Width="105"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate><DataTemplate DataType="{x:Type sales:RetailSaleProductGroup}">
                            <ItemsControl ItemsSource="{Binding QrCodes}" Margin="37,0,0,4">
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type sales:RetailSaleQrEntry}">
                                    <Border Background="#F4F8F9" BorderBrush="#E0E9EB" BorderThickness="0,1,0,0" Padding="12,8">
                                        <Border.ContextMenu><ContextMenu>
                                            <MenuItem Header="View Movements" Click="OnOpenQrMovementsClicked"/>
                                            <MenuItem Header="Copy QR Code" Click="OnCopyQrClicked"/>
                                        </ContextMenu></Border.ContextMenu>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="70"/><ColumnDefinition Width="115"/><ColumnDefinition Width="115"/><ColumnDefinition Width="125"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                                            <DockPanel><TextBlock Text="{Binding ExpiryDateDisplay}" DockPanel.Dock="Right" Margin="12,0,8,0" Foreground="#6B7B84"/>
                                                <TextBlock Text="{Binding QrCode}" FontFamily="Consolas" Foreground="#52636D" TextTrimming="CharacterEllipsis"/></DockPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding EntryCostDisplay}" Foreground="#53656F" Padding="10,0"/>
                                            <TextBlock Grid.Column="6" Text="{Binding DiscountDisplay}" Foreground="#53656F" Padding="10,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate></DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#DFFFFFFF" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="310">
                    <TextBlock x:Name="LoadingText" Text="Loading sales..." TextAlignment="Center" Foreground="#53636D" Margin="0,0,0,10"/>
                    <ProgressBar Height="7" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,9,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="CountText" Foreground="#53636D" Text="Total records: 0"/>
                <TextBlock x:Name="LaunchFilterText" Foreground="#0F766E" TextWrapping="Wrap" Margin="0,4,12,0" Visibility="Collapsed"/>
            </StackPanel>
            <CheckBox x:Name="SplitDirectionToggle" Grid.Column="1" Content="Separate Incoming / Outgoing"
                      VerticalAlignment="Center" Checked="OnSplitDirectionChanged" Unchecked="OnSplitDirectionChanged"/>
        </Grid>
    </Grid>
</UserControl>
