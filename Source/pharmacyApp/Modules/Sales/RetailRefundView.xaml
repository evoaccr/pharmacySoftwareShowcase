<UserControl x:Class="pharmacyApp.Modules.Sales.RetailRefundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sales="clr-namespace:pharmacyApp.Modules.Sales"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <sales:SaleGroupIndexToBrushConverter x:Key="SaleGroupIndexToBrushConverter"/>
        <Style x:Key="EntryButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="#315A73"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="11,7"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="BorderBrush" Value="#CBD7DB"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#71808A"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#263640"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,2,0,12"/>
        </Style>
        <Style x:Key="PaymentCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#65717E"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>
        <Style x:Key="PaymentCardToggle" TargetType="ToggleButton" BasedOn="{StaticResource SquareToggleButtonStyle}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="CardBorder" Background="#F9FBFB" BorderBrush="#C8CDD2" BorderThickness="1"
                                CornerRadius="0" MinWidth="150" MinHeight="46"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#9FC3C0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F0F2F4"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#315A73"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/>
                <ColumnDefinition Width="270"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QrCodeInput" Style="{StaticResource InputBox}" ToolTip="Sold QR code"
                     KeyDown="OnQrCodeKeyDown"/>
            <Button Grid.Column="1" Style="{StaticResource EntryButton}" Content="+" ToolTip="Add QR code to return"
                    Click="OnAddItemClicked"/>
            <Grid Grid.Column="3">
                <TextBox x:Name="PatientSearchBox" Style="{StaticResource InputBox}"
                         ToolTip="Patient name, surname or national ID"
                         TextChanged="OnPatientSearchTextChanged"
                         PreviewKeyDown="OnPatientSearchKeyDown"/>
                <TextBlock x:Name="PatientPlaceholder" Text="Select a patient (at least 3 characters)" Margin="12,0"
                           VerticalAlignment="Center" Foreground="#8A98A1" IsHitTestVisible="False"/>
                <Popup x:Name="PatientSuggestionPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=PatientSearchBox}"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Width="340" MaxHeight="280" Margin="0,4,0,0" Padding="4" Background="White"
                            BorderBrush="#CAD7DB" BorderThickness="1" CornerRadius="0">
                        <ListBox x:Name="PatientSuggestionList" BorderThickness="0" DisplayMemberPath="DisplayText"
                                 SelectionChanged="OnPatientSuggestionSelected"/>
                    </Border>
                </Popup>
            </Grid>
            <Button Grid.Column="4" Style="{StaticResource EntryButton}" Content="+" ToolTip="Add new patient"
                    Click="OnAddPatientClicked"/>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,8" MinHeight="18" Foreground="#B33A32"
                   FontSize="13" TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560"/><ColumnDefinition Width="14"/><ColumnDefinition Width="260"/>
                <ColumnDefinition Width="14"/><ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D5E0E3" BorderThickness="1" CornerRadius="0" ClipToBounds="True">
                <DataGrid x:Name="RefundGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E7EDEF" BorderThickness="0" SelectionMode="Single" SelectionUnit="FullRow"
                          RowHeight="44" ColumnHeaderHeight="38" PreviewMouseRightButtonDown="OnRefundGridRightClick"
                          ContextMenuOpening="OnRefundGridContextMenuOpening" SelectionChanged="OnRefundGroupSelected">
                    <DataGrid.ContextMenu><ContextMenu>
                        <MenuItem Header="Remove Medicine" Click="OnRemoveGroupClicked"/>
                        <MenuItem Header="Open medicine information" Click="OnOpenGroupProductClicked"/>
                    </ContextMenu></DataGrid.ContextMenu>
                    <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}">
                        <Setter Property="DetailsVisibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="DetailsVisibility" Value="Visible"/>
                        </DataTrigger></Style.Triggers>
                    </Style></DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Product Name" Width="*" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type sales:RetailRefundGroup}">
                                <DockPanel LastChildFill="True">
                                    <ToggleButton DockPanel.Dock="Left" Width="28" Height="28" Margin="4,0,7,0"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}" Click="OnRefundGroupExpandClicked"
                                                  Background="Transparent" BorderThickness="0">
                                        <Path Data="M0,0 L6,6.5 L0,13" Stroke="#4F626D" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                    <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="#273740" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockDisplay}" Width="70"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="65"/>
                        <DataGridTextColumn Header="Current Unit Cost" Binding="{Binding UnitCostDisplay}" Width="145"/>
                        <DataGridTextColumn Header="Total Issue Value" Binding="{Binding TotalExitPriceDisplay}" Width="150"/>
                        <DataGridTextColumn Header="Total Due" Binding="{Binding TotalPayableDisplay}" Width="140"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate><DataTemplate DataType="{x:Type sales:RetailRefundGroup}">
                        <ItemsControl ItemsSource="{Binding Entries}" Margin="37,0,0,4">
                            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type sales:RetailRefundEntry}">
                                <Border Background="{Binding SaleGroupIndex, Converter={StaticResource SaleGroupIndexToBrushConverter}}"
                                        BorderBrush="#E0E9EB" BorderThickness="0,1,0,0" Padding="12,8"
                                        MouseLeftButtonDown="OnRefundEntrySelected"
                                        ToolTip="{Binding Item.OriginalSaleId, StringFormat='Satış Referansı: P{0}'}">
                                    <Border.ContextMenu><ContextMenu>
                                        <MenuItem Header="Remove QR Code" Click="OnRemoveEntryClicked"/>
                                        <MenuItem Header="Open medicine information" Click="OnOpenEntryProductClicked"/>
                                        <Separator/>
                                        <MenuItem Header="View Movements" Click="OnOpenQrMovementsClicked"/>
                                        <MenuItem Header="Copy QR Code" Click="OnCopyQrClicked"/>
                                    </ContextMenu></Border.ContextMenu>
                                    <Grid><Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="145"/><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding QrCode}" Foreground="#53656F" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding EntryCostDisplay}" Foreground="#53656F"
                                                   VerticalAlignment="Center" Padding="10,0"/>
                                        <TextBlock Grid.Column="4" Text="{Binding ExitPriceDisplay}" Foreground="#53656F"
                                                   VerticalAlignment="Center" Padding="10,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate></DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D5E0E3" BorderThickness="1" CornerRadius="0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Customer Summary" FontSize="17" FontWeight="SemiBold" Foreground="#263640"/>
                    <TextBlock x:Name="CustomerName" Grid.Row="1" Text="No Patient Selected" FontSize="16" FontWeight="SemiBold"
                               Foreground="#263640" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="National ID" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="CustomerTc" Text="—" Style="{StaticResource SummaryValue}"/>
                        <TextBlock Text="Phone" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="CustomerPhone" Text="—" Style="{StaticResource SummaryValue}"/>
                        <TextBlock Text="Debt Amount" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="CustomerDebt" Text="—" Style="{StaticResource SummaryValue}"/>
                        <TextBlock Text="Debt Credit" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="CustomerCredit" Text="—" Style="{StaticResource SummaryValue}"/>
                    </StackPanel></ScrollViewer>
                    <Button x:Name="EditPatientButton" Grid.Row="3" Height="38" Content="View / Edit Patient"
                            Background="#E0F2F0" Foreground="#294C62" BorderBrush="#9DD9D2" BorderThickness="1"
                            FontWeight="SemiBold" IsEnabled="False" Click="OnEditPatientClicked"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="White" BorderBrush="#D5E0E3" BorderThickness="1" CornerRadius="0" Padding="18">
                <Grid><Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                    <TextBlock Text="Product Summary" FontSize="17" FontWeight="SemiBold" Foreground="#263640"/>
                    <Border Grid.Row="1" Margin="0,12" Background="#F3F6F7" CornerRadius="0">
                        <Grid><Image x:Name="SummaryPhoto" Stretch="Uniform" Margin="8"/>
                            <TextBlock x:Name="NoPhotoText" Text="No Medicine Selected" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#89959C"/></Grid>
                    </Border>
                    <TextBlock x:Name="SummaryProductName" Grid.Row="2" Text="Select a product" FontSize="16"
                               FontWeight="SemiBold" Foreground="#263640" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Current Wholesale Purchase Price" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="SummaryWarehousePrice" Text="—" Style="{StaticResource SummaryValue}"/>
                        <TextBlock Text="Public Price" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="SummaryPublicPrice" Text="—" Style="{StaticResource SummaryValue}"/>
                        <TextBlock Text="Prescription Color" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="SummaryPrescriptionColor" Text="—" Style="{StaticResource SummaryValue}"/>
                        <TextBlock Text="Stock" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="SummaryStock" Text="—" Style="{StaticResource SummaryValue}"/>
                        <Expander Header="Indication" Foreground="#71808A" FontSize="12" Margin="0,0,0,10">
                            <TextBlock x:Name="SummaryIndication" Text="—" Foreground="#263640" FontSize="13"
                                       Margin="10,6,4,2" TextWrapping="Wrap"/>
                        </Expander>
                    </StackPanel></ScrollViewer>
                    <Button x:Name="EquivalentsButton" Grid.Row="4" Height="38" Content="Equivalents" Background="#E0F2F0"
                            Foreground="#294C62" BorderBrush="#9DD9D2" BorderThickness="1" FontWeight="SemiBold"
                            IsEnabled="False" Click="OnOpenEquivalentsClicked"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="14,10" Background="White" BorderBrush="#D5E0E3"
                BorderThickness="1" CornerRadius="0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Cash" Style="{StaticResource PaymentCardTitle}"/>
                        <Grid>
                            <ToggleButton x:Name="CashPaymentCheckBox" Tag="Cash" Style="{StaticResource PaymentCardToggle}"
                                          Checked="OnPaymentSelectionChanged" Unchecked="OnPaymentSelectionChanged"/>
                            <sales:MoneyEntryControl x:Name="CashPaymentBox" Tag="Cash" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     AmountChanged="OnPaymentAmountChanged" GotKeyboardFocus="OnPaymentEntryActivated"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Card" Style="{StaticResource PaymentCardTitle}"/>
                        <Grid>
                            <ToggleButton x:Name="CreditPaymentCheckBox" Tag="Credit" Style="{StaticResource PaymentCardToggle}"
                                          Checked="OnPaymentSelectionChanged" Unchecked="OnPaymentSelectionChanged"/>
                            <sales:MoneyEntryControl x:Name="CreditPaymentBox" Tag="Credit" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     AmountChanged="OnPaymentAmountChanged" GotKeyboardFocus="OnPaymentEntryActivated"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Bank Transfer" Style="{StaticResource PaymentCardTitle}"/>
                        <Grid>
                            <ToggleButton x:Name="TransferPaymentCheckBox" Tag="BankTransfer" Style="{StaticResource PaymentCardToggle}"
                                          Checked="OnPaymentSelectionChanged" Unchecked="OnPaymentSelectionChanged"/>
                            <sales:MoneyEntryControl x:Name="TransferPaymentBox" Tag="BankTransfer" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     AmountChanged="OnPaymentAmountChanged" GotKeyboardFocus="OnPaymentEntryActivated"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="PaymentStatusText" Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Right"
                           Foreground="#B33A32" FontWeight="SemiBold" Text="Return payment total: TRY 0.00"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Note" FontSize="11" Foreground="#65717E" Margin="2,0,0,4"/>
                    <TextBox x:Name="RefundNotesBox" Width="300" Height="36" Padding="9,6" MaxLength="300"
                             VerticalContentAlignment="Center" BorderBrush="#CBD7DB" BorderThickness="1" Background="White"/>
                    <CheckBox x:Name="SendItsNotificationCheckBox" Margin="2,7,0,0" IsChecked="True"
                              Content="Send ITS Notification" Foreground="#33464F"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="DebtReductionBorder" Padding="8,6" Margin="0,0,10,0" CornerRadius="0" Background="#E7EBED">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="UseDebtReductionCheckBox" IsChecked="True" IsEnabled="False" Margin="0,0,6,0"
                                      Checked="OnUseDebtReductionChanged" Unchecked="OnUseDebtReductionChanged"/>
                            <TextBlock x:Name="DebtReductionText" Text="Debt to Remove: TRY 0.00" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#465760"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="DiscountTotalText" Text="Discount: TRY 0.00" Margin="0,0,14,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#7A5B18"/>
                    <TextBlock x:Name="PaymentTotalText" Text="Payment Total: TRY 0.00" Margin="0,0,14,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#294C62"/>
                    <TextBlock x:Name="TotalText" VerticalAlignment="Center" Text="Return Total: TRY 0.00"
                               FontSize="20" FontWeight="SemiBold" Foreground="#21323C"/>
                </StackPanel>
            </DockPanel>
            <Button x:Name="CompleteRefundButton" Grid.Column="2" Height="48" Content="Complete Return" Background="#168B52"
                    Foreground="White" BorderThickness="0" FontSize="16" FontWeight="SemiBold" IsEnabled="False"
                    ToolTipService.ShowOnDisabled="True" Click="OnCompleteRefundClicked"/>
        </Grid>
    </Grid>
</UserControl>
