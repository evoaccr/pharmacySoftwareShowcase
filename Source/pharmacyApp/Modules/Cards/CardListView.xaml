<UserControl x:Class="pharmacyApp.Modules.Cards.CardListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="CardRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#27343E"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="FilterPanel" Grid.Row="0" Margin="0,0,0,9"
                   Orientation="Horizontal" VerticalAlignment="Center"/>

        <Grid Grid.Row="1">
            <DataGrid x:Name="CardGrid" Background="White" BorderBrush="#C8CDD2" BorderThickness="1"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeColumns="True" CanUserSortColumns="True"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8ECEF"
                      HeadersVisibility="Column" RowHeight="33" ColumnHeaderHeight="36"
                      SelectionMode="Single" RowStyle="{StaticResource CardRowStyle}"
                      ScrollViewer.ScrollChanged="OnGridScrollChanged"
                      Sorting="OnGridSorting"
                      PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                      MouseDoubleClick="OnGridDoubleClicked"/>
            <Border x:Name="StatusOverlay" Background="#F2FFFFFF" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="#4E5B66" FontSize="14"
                               TextAlignment="Center" MaxWidth="540" TextWrapping="Wrap"/>
                    <Button x:Name="RetryButton" Content="Retry" Width="110" Height="32"
                            Margin="0,12,0,0" Click="OnRetryClicked"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" VerticalAlignment="Center"
                       Foreground="#65717E" FontWeight="SemiBold"/>
            <Button x:Name="AddButton" Grid.Column="1" Width="145" Height="34"
                    Background="#18864B" Foreground="White" BorderBrush="#18864B"
                    FontWeight="SemiBold" Click="OnAddClicked"/>
        </Grid>

        <Border x:Name="HistoryOverlay" Grid.RowSpan="3" Panel.ZIndex="20"
                Visibility="Collapsed" Background="#5A16232B">
            <Border Width="1120" MaxWidth="1120" MaxHeight="720"
                    Margin="24" Padding="0" CornerRadius="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="#CBD5DC" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#DCEAF3" CornerRadius="0" Padding="17,12">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="HistoryTitleText" FontSize="19" FontWeight="SemiBold"
                                           Foreground="#173B4A"/>
                                <TextBlock x:Name="HistoryPatientText" Margin="0,3,40,0"
                                           Foreground="#526773"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="30" Height="30" Content="×" FontSize="19"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#314B57" ToolTip="Close"
                                    Click="OnCloseHistoryOverlay"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="15">
                        <DataGrid x:Name="MedicationHistoryGrid" Visibility="Collapsed"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5EBEF"
                                  RowHeight="36" ColumnHeaderHeight="38"
                                  Background="White" BorderBrush="#C8CDD2" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Prescription No." Binding="{Binding PrescriptionNo}" Width="105"/>
                                <DataGridTextColumn Header="Barcode" Binding="{Binding MedicationBarcode}" Width="125"/>
                                <DataGridTextColumn Header="Medicine Name" Binding="{Binding MedicationName}" Width="2*"/>
                                <DataGridTextColumn Header="Dispensing Date" Binding="{Binding MedicationPurchaseDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                                <DataGridTextColumn Header="Dispensing Date" Binding="{Binding AvailableDate, StringFormat={}{0:dd.MM.yyyy}}" Width="135"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="Medicine Usage" Binding="{Binding MedicationUsage}" Width="140"/>
                                <DataGridTextColumn Header="Report Diagnosis / Tracking No." Binding="{Binding ReportDiagnosisNo}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="ReportHistoryGrid" Visibility="Collapsed"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5EBEF"
                                  RowHeight="36" ColumnHeaderHeight="38"
                                  Background="White" BorderBrush="#C8CDD2" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Report Tracking No." Binding="{Binding ReportTrackingNo}" Width="160"/>
                                <DataGridTextColumn Header="Report No." Binding="{Binding ReportNo}" Width="160"/>
                                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="135"/>
                                <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}" Width="135"/>
                                <DataGridTextColumn Header="Diagnosis" Binding="{Binding Diagnosis}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="HistoryEmptyText" Visibility="Collapsed"
                                   Text="No imported records found."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#8B4D4D" FontSize="14"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
