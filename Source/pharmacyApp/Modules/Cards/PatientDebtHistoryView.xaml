<UserControl x:Class="pharmacyApp.Modules.Cards.PatientDebtHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,9">
            <StackPanel Width="430">
                <TextBlock Text="Patient (Full Name / National ID)" FontSize="11.5" Foreground="#52606B" Margin="1,0,0,3"/>
                <Grid x:Name="PatientLookupHost" Height="30"/>
            </StackPanel>
            <Button Content="Clear" Width="76" Height="30" Margin="8,20,0,0" Click="OnClearClicked"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <DataGrid x:Name="HistoryGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" IsReadOnly="True" SelectionMode="Single"
                      Background="White" BorderBrush="#C8CDD2" BorderThickness="1"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8ECEF"
                      HeadersVisibility="Column" RowHeight="33" ColumnHeaderHeight="36"
                      ScrollViewer.ScrollChanged="OnGridScrollChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date / Time" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="145"/>
                    <DataGridTextColumn Header="National ID No." Binding="{Binding TcIdentityNo}" Width="110"/>
                    <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="45"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="Debt after Operation" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceCode}" Width="90"/>
                    <DataGridTextColumn Header="Description / Note" Binding="{Binding Description}" Width="*" MinWidth="180"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="StatusOverlay" Background="#F2FFFFFF" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#4E5B66" FontSize="14" TextAlignment="Center"
                           MaxWidth="540" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <TextBlock x:Name="CountText" Grid.Row="2" Margin="2,10,0,0"
                   VerticalAlignment="Center" Foreground="#65717E" FontWeight="SemiBold"/>
    </Grid>
</UserControl>
