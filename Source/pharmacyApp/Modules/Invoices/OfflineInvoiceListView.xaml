<UserControl x:Class="pharmacyApp.Modules.Invoices.OfflineInvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="#F2F3F4"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <Style x:Key="InvoiceRowStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource SubtleDataGridRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowState}" Value="Unsaved">
                    <Setter Property="Background" Value="#FECACA"/>
                    <Setter Property="Foreground" Value="#7F1D1D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RowState}" Value="Saved">
                    <Setter Property="Background" Value="#BBF7D0"/>
                    <Setter Property="Foreground" Value="#14532D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RowState}" Value="Sent">
                    <Setter Property="Background" Value="#BFDBFE"/>
                    <Setter Property="Foreground" Value="#1E3A5F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvoiceLineRowStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource SubtleDataGridRowStyle}">
            <Setter Property="DetailsVisibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="DetailsVisibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvoiceLineArrowButton" TargetType="ToggleButton" BasedOn="{StaticResource SquareToggleButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTip" Value="Show individual DataMatrix codes"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Path Data="M0,0 L6,6.5 L0,13" Stroke="#4F626D" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White"
                BorderBrush="#C8CDD2"
                BorderThickness="1"
                CornerRadius="0"
                Padding="12"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Width="42"
                        Height="32"
                        Margin="12,15,0,0"
                        Background="#294C62"
                        Foreground="White"
                        BorderBrush="#294C62"
                        ToolTip="Refresh from database"
                        automation:AutomationProperties.Name="Fatura listesini veritabanından yenile"
                        Click="OnRefreshClicked">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>

                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Invoice type" Foreground="#65717E" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TypeBox"
                                  Width="170"
                                  Height="32"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="OnFilterChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Start Date" Foreground="#65717E" FontSize="11" Margin="0,0,0,4"/>
                        <DatePicker x:Name="StartDatePicker"
                                    Width="145"
                                    Height="32"
                                    SelectedDateChanged="OnFilterChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="End Date" Foreground="#65717E" FontSize="11" Margin="0,0,0,4"/>
                        <DatePicker x:Name="EndDatePicker"
                                    Width="145"
                                    Height="32"
                                    SelectedDateChanged="OnFilterChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Search" Foreground="#65717E" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="SearchBox"
                                 Width="280"
                                 Height="32"
                                 Padding="9,5"
                                 ToolTip="Invoice ID, sender, recipient or identification number"
                                 KeyDown="OnSearchKeyDown"
                                 LostFocus="OnSearchLostFocus"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid x:Name="InvoiceGrid"
                      ItemsSource="{Binding Invoices}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="38"
                      ColumnHeaderHeight="38"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8ECEF"
                      BorderBrush="#C8CDD2"
                      BorderThickness="1"
                      RowStyle="{StaticResource InvoiceRowStyle}"
                      ScrollViewer.ScrollChanged="OnInvoiceGridScrollChanged"
                      SelectionChanged="OnInvoiceSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceUuid}" Width="260"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding InvoiceType}" Width="120"/>
                    <DataGridTextColumn Header="Editing" Binding="{Binding IssueDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                    <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat={}{0:dd.MM.yyyy}, TargetNullValue=—}" Width="100"/>
                    <DataGridTextColumn Header="Sender" Binding="{Binding SenderName}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Sender tax/national ID" Binding="{Binding SenderIdentityNo}" Width="130"/>
                    <DataGridTextColumn Header="Recipient" Binding="{Binding ReceiverName}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Recipient tax/national ID" Binding="{Binding ReceiverIdentityNo}" Width="130"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalCost, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}" Width="95"/>
                    <DataGridTextColumn Header="VAT" Binding="{Binding KdvAmount, StringFormat={}{0:N2}, TargetNullValue=—}" Width="90"/>
                    <DataGridTextColumn Header="Due" Binding="{Binding PayableAmount, StringFormat={}{0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="Database Sign In" Binding="{Binding DatabaseEntryAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="BusyLayer" Background="#EFFFFFFF" Visibility="Collapsed">
                <StackPanel Width="310" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Height="6" IsIndeterminate="True"/>
                    <TextBlock Margin="0,10,0,0"
                               TextAlignment="Center"
                               Foreground="#60717B"
                               Text="Loading invoices from the database…"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="White"
                BorderBrush="#C8CDD2"
                BorderThickness="1"
                CornerRadius="0">
            <Grid>
                <DataGrid x:Name="LineGrid"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          RowHeight="34"
                          ColumnHeaderHeight="36"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8ECEF"
                          BorderThickness="0"
                          RowStyle="{StaticResource InvoiceLineRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource InvoiceLineArrowButton}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  Visibility="{Binding HasQrTrackingDetails, Converter={StaticResource BooleanVisibility}}"
                                                  Click="OnInvoiceLineExpandClicked"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="42"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding ItemCode}" Width="110"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="125"/>
                        <DataGridTextColumn Header="Goods / Services" Binding="{Binding ItemName}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Tracking" Binding="{Binding TrackingDisplay}" Width="190"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N0}}" Width="85"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65"/>
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="VAT %" Binding="{Binding VatRate, StringFormat={}{0:N2}}" Width="70"/>
                        <DataGridTextColumn Header="VAT Amount" Binding="{Binding VatAmount, StringFormat={}{0:N2}}" Width="95"/>
                        <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="Line Amount" Binding="{Binding LineAmount, StringFormat={}{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="55"/>
                        <DataGridCheckBoxColumn Header="Medicine" Binding="{Binding IsMedication}" Width="55"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <StackPanel Margin="38,0,0,5">
                                <Border x:Name="TrackingWarningPanel" Visibility="Collapsed"
                                        Background="#FFF7E8" BorderBrush="#E8C986"
                                        BorderThickness="0,1,0,0" Padding="12,7">
                                    <TextBlock Text="{Binding TrackingWarning}" Foreground="#785B1F" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding QrCodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E9EB" BorderThickness="0,1,0,0" Padding="12,7">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F4F8F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPartiallyRefunded}" Value="True">
                                                                <Setter Property="Background" Value="#FFF3BF"/>
                                                                <Setter Property="BorderBrush" Value="#E8C15D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Copy QR Code" Click="OnCopyInvoiceQrClicked"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="135"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="105"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding QrCode}" FontFamily="Consolas"
                                                               Foreground="#3F5661" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SerialNumber, StringFormat=SN: {0}}"
                                                               Foreground="#53656F"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding BatchNumber, StringFormat=Parti: {0}}"
                                                               Foreground="#53656F"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ExpiryDateDisplay}"
                                                               Foreground="#53656F"/>
                                                    <TextBlock Grid.Column="4" Text="Partial return"
                                                               Foreground="#785B1F" FontWeight="SemiBold"
                                                               Visibility="{Binding IsPartiallyRefunded, Converter={StaticResource BooleanVisibility}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasTrackingWarning}" Value="True">
                                    <Setter TargetName="TrackingWarningPanel" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <TextBlock x:Name="LineEmptyText"
                           Text="Select an invoice to view its contents."
                           Foreground="#5E6770"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,9,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StockActionButton" MinWidth="155" Height="34" Padding="14,5"
                    Background="#294C62" Foreground="White" BorderBrush="#294C62"
                    Visibility="Collapsed" IsEnabled="False" Click="OnStockActionClicked"/>
            <StackPanel x:Name="MovementNotePanel" Grid.Column="1" Margin="12,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Movement note" Foreground="#65717E" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="MovementNoteBox" Height="32" Padding="9,5"
                         MaxLength="500" ToolTip="Note shown on invoice and QR movements"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                <TextBlock x:Name="ActionHintText" Foreground="#65717E" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusText" Foreground="#8D2E2E" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LoadedCountText" Foreground="#5E6770"/>
                <Border Width="1" Height="18" Margin="10,0" Background="#CBD5DB"/>
                <TextBlock x:Name="TotalCountText" Foreground="#314A56" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
