<UserControl x:Class="pharmacyApp.Modules.Invoices.InvoiceStockLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65717E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#F0F2F4"/>
            <Setter Property="Foreground" Value="#315A73"/>
            <Setter Property="BorderBrush" Value="#C6D0D8"/>
        </Style>
        <Style x:Key="LogRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}">
            <Setter Property="Background" Value="#EAF7F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActionCode}" Value="REFUND">
                    <Setter Property="Background" Value="#FFF0E4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionCode}" Value="PARTIAL_REFUND">
                    <Setter Property="Background" Value="#FFF3BF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#C8CDD2" BorderThickness="1"
                CornerRadius="0" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Width="42" Height="32"
                        Margin="12,15,0,8" Background="#294C62" Foreground="White"
                        BorderBrush="#294C62" ToolTip="Refresh" Click="OnRefreshClicked">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Search" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="SearchBox" Width="240" Style="{StaticResource FilterBox}"
                                 ToolTip="Invoice, party, reference, QR code or barcode"
                                 TextChanged="OnFilterChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Movement" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="ActionFilter" Width="165" Height="32"
                                  DisplayMemberPath="DisplayText" SelectionChanged="OnFilterChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="User" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="UserFilter" Width="185" Height="32"
                                  DisplayMemberPath="DisplayText" SelectionChanged="OnFilterChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Quick Date" Style="{StaticResource FilterLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Today" Tag="Day" Style="{StaticResource PresetButton}" Click="OnPresetClicked"/>
                            <Button Content="This Week" Tag="Week" Style="{StaticResource PresetButton}" Click="OnPresetClicked"/>
                            <Button Content="This Month" Tag="Month" Style="{StaticResource PresetButton}" Click="OnPresetClicked"/>
                            <Button Content="This Year" Tag="Year" Style="{StaticResource PresetButton}" Click="OnPresetClicked"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Start" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="StartDatePicker" Width="130" Height="32" SelectedDateChanged="OnFilterChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="End" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="EndDatePicker" Width="130" Height="32" SelectedDateChanged="OnFilterChanged"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="White" BorderBrush="#C8CDD2" BorderThickness="1"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8ECEF"
                      RowHeight="38" ColumnHeaderHeight="38" SelectionMode="Single"
                      RowStyle="{StaticResource LogRowStyle}" SelectionChanged="OnLogSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Record" Binding="{Binding RecordId}" Width="72"/>
                    <DataGridTextColumn Header="Movement" Binding="{Binding ActionDisplay}" Width="145"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding OccurredAtDisplay}" Width="145"/>
                    <DataGridTextColumn Header="Invoices" Binding="{Binding InvoiceUuidsDisplay}" Width="260"/>
                    <DataGridTextColumn Header="Sender" Binding="{Binding SenderName}" Width="*" MinWidth="175"/>
                    <DataGridTextColumn Header="Recipient" Binding="{Binding ReceiverName}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Movement Type" Binding="{Binding MovementTypeName}" Width="150"/>
                    <DataGridTextColumn Header="QR Code" Binding="{Binding SerializedQuantity}" Width="75"/>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding BarcodeQuantity}" Width="75"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserDisplay}" Width="135"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding NotesDisplay}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="LoadingOverlay" Background="#DFFFFFFF" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="210" Height="5" IsIndeterminate="True"/>
                    <TextBlock x:Name="LoadingText" Text="Loading invoice movements..."
                               Margin="0,10,0,0" Foreground="#65717E"/>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeDirection="Rows"/>

        <Border Grid.Row="3" Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DetailTitle" Text="Select an invoice movement."
                           Margin="12,9" Foreground="#314A56" FontWeight="SemiBold"/>
                <DataGrid x:Name="DetailGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8ECEF"
                          RowHeight="36" ColumnHeaderHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="QR Code / Barcode Movement" Binding="{Binding QrCode}" Width="2*"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding BarcodeDisplay}" Width="140"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductDisplay}" Width="2*"/>
                        <DataGridTextColumn Header="Movement Type" Binding="{Binding MovementTypeName}" Width="160"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding NotesDisplay}" Width="180"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding MovementDateDisplay}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="2,9,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#5E6770"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0" HorizontalAlignment="Center">
                <TextBlock Text="User Note" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#65717E"/>
                <TextBox x:Name="NotesBox" Width="360" Height="32" Padding="9,5" IsEnabled="False"/>
                <Button x:Name="SaveNotesButton" Content="Save Note" Height="32" Margin="7,0,0,0"
                        Padding="12,4" Background="#294C62" Foreground="White" BorderBrush="#294C62"
                        IsEnabled="False" Click="OnSaveNotesClicked"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Foreground="#65717E"/>
        </Grid>
    </Grid>
</UserControl>
