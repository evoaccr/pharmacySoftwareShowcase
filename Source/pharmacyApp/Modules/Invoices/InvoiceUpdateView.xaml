<UserControl x:Class="pharmacyApp.Modules.Invoices.InvoiceUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4" Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="UpdateCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C8CDD2"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="14"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Update Invoices" FontSize="18" FontWeight="SemiBold" Foreground="#18323B"/>
            </StackPanel>
                <Button x:Name="PauseButton" Grid.Column="1" Content="Pause" Width="110" Height="38"
                        IsEnabled="False" Background="#E3EAED" Click="OnPauseClicked"/>
                <Button x:Name="StartButton" Grid.Column="3" Content="Start / Resume" Width="155" Height="38"
                        Background="#294C62" Foreground="White" BorderBrush="#294C62" Click="OnStartClicked"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
            <Border Style="{StaticResource UpdateCard}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Last successful import" Foreground="#5E6770"/><TextBlock x:Name="LastSuccessText" Text="—" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource UpdateCard}" Margin="6,0"><StackPanel><TextBlock Text="Status" Foreground="#5E6770"/><TextBlock x:Name="PhaseText" Text="Ready" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource UpdateCard}" Margin="6,0"><StackPanel><TextBlock Text="Current type" Foreground="#5E6770"/><TextBlock x:Name="CurrentTypeText" Text="—" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource UpdateCard}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Current invoice" Foreground="#5E6770"/><TextBlock x:Name="CurrentInvoiceText" Text="—" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="18" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel><TextBlock x:Name="ProgressCountText" DockPanel.Dock="Right" Text="0 / 0" Foreground="#5E6770"/><TextBlock x:Name="MessageText" Text="Loading tracking status…" Foreground="#334A55"/></DockPanel>
                <ProgressBar x:Name="ProgressBar" Height="12" Minimum="0" Maximum="1" Margin="0,10,0,0" Foreground="#294C62"/>
                <UniformGrid Columns="3" Margin="0,14,0,0">
                    <TextBlock x:Name="ImportedText" Text="Imported: 0" Foreground="#17643A"/>
                    <TextBlock x:Name="FailedText" Text="Errors: 0" Foreground="#9B2C2C" TextAlignment="Center"/>
                    <TextBlock x:Name="UpdatedText" Text="Updated: —" Foreground="#5E6770" TextAlignment="Right"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" x:Name="ErrorPanel" Background="#FFF1F0" BorderBrush="#E6A5A0" BorderThickness="1"
                CornerRadius="0" Padding="14" Margin="0,12,0,0" Visibility="Collapsed" VerticalAlignment="Top">
            <TextBlock x:Name="ErrorText" Foreground="#8D2E2E" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
