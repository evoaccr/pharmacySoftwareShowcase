<UserControl x:Class="pharmacyApp.Modules.Invoices.PartialInvoiceRefundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:invoices="clr-namespace:pharmacyApp.Modules.Invoices"
             Background="#F2F3F4" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD7DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EntryButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#315A73"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#71808A"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#263640"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SelectableFieldValue" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#263640"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GroupRow" TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}">
            <Setter Property="DetailsVisibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="DetailsVisibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QrCodeInput" Style="{StaticResource InputBox}"
                     ToolTip="QR code of the box to return"
                     KeyDown="OnQrCodeKeyDown"/>
            <Button x:Name="AddItemButton" Grid.Column="1" Style="{StaticResource EntryButton}"
                    Content="+" ToolTip="Add QR code to return list" Click="OnAddItemClicked"/>
            <Button Grid.Column="3" Content="Clear List" Height="38" Padding="13,5"
                    Background="#F0F2F4" Foreground="#315A73" BorderBrush="#C6D0D8"
                    Click="OnClearCartClicked"/>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,8,0,8" MinHeight="18"
                   Foreground="#B33A32" FontSize="13" TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Border Background="White" BorderBrush="#D5E0E3" BorderThickness="1"
                        CornerRadius="0" ClipToBounds="True">
                    <DataGrid x:Name="RefundGrid" ItemsSource="{Binding Groups}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8ECEF" BorderThickness="0"
                              RowHeight="44" ColumnHeaderHeight="38" SelectionMode="Single"
                              RowStyle="{StaticResource GroupRow}" SelectionChanged="OnGroupSelected"
                              PreviewMouseRightButtonDown="OnGridRightClick"
                              ContextMenuOpening="OnGridContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Remove Product from Return List" Click="OnRemoveGroupClicked"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Product Name" Width="*" MinWidth="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <ToggleButton DockPanel.Dock="Left" Width="28" Height="28" Margin="4,0,7,0"
                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          Click="OnGroupExpandClicked" Background="Transparent"
                                                          BorderThickness="0" ToolTip="Show QR codes">
                                                <Path Data="M0,0 L6,6.5 L0,13" Stroke="#4F626D" StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </ToggleButton>
                                            <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="#273740"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="150"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding QrCodes}" Margin="38,0,0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type invoices:PartialInvoiceRefundQrRow}">
                                            <Border Background="#F4F8F9" BorderBrush="#E0E9EB"
                                                    BorderThickness="0,1,0,0" Padding="12,8"
                                                    MouseLeftButtonDown="OnQrSelected">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Remove QR Code from Return List" Click="OnRemoveQrClicked"/>
                                                        <Separator/>
                                                        <MenuItem Header="Copy QR Code" Click="OnCopyQrClicked"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="105"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding QrCode}" FontFamily="Consolas"
                                                               Foreground="#3F5661" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding InvoiceUuid}" Foreground="#53656F"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SenderName}" Foreground="#53656F"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ExpiryDateDisplay}" Foreground="#53656F"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Border>
                <TextBlock x:Name="EmptyText"
                           Text="Scan QR codes to add them to the return list."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#71808A" FontSize="14" IsHitTestVisible="False"/>
            </Grid>

            <Border Grid.Column="2" Background="White" BorderBrush="#D5E0E3" BorderThickness="1"
                    CornerRadius="0" Padding="17">
                <StackPanel>
                    <TextBlock Text="Selected QR Code" FontSize="16" FontWeight="SemiBold"
                               Foreground="#263640" Margin="0,0,0,16"/>
                    <TextBlock Text="QR Code" Style="{StaticResource SummaryLabel}"/>
                    <TextBox x:Name="SelectedQrText" Text="—" Style="{StaticResource SelectableFieldValue}"
                             FontFamily="Consolas" Margin="0,2,0,14"/>
                    <TextBlock Text="Product" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="SelectedProductText" Text="—" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Text="Invoice" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="SelectedInvoiceText" Text="—" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Text="Warehouse (Depot)" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="SelectedDepotText" Text="—" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Text="Invoice Date" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="SelectedIssueDateText" Text="—" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Text="Expiry" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="SelectedExpiryText" Text="—" Style="{StaticResource SummaryValue}"/>
                </StackPanel>
            </Border>

            <Border x:Name="LoadingOverlay" Grid.ColumnSpan="3" Background="#EFFFFFFF" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="6" IsIndeterminate="True"/>
                    <TextBlock x:Name="LoadingText" Text="Validating QR code…" Margin="0,10,0,0"
                               Foreground="#60717B"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Movement note" VerticalAlignment="Center" Foreground="#65717E" Margin="0,0,8,0"/>
                <TextBox x:Name="NotesBox" Width="390" Height="32" Padding="9,5" MaxLength="500"
                         ToolTip="Note shown on invoice and QR movements"/>
                <Button x:Name="RefundButton" Content="Complete Partial Return" Height="32"
                        Padding="14,5" Margin="8,0,0,0" Background="#B45309" Foreground="White"
                        BorderBrush="#B45309" IsEnabled="False" Click="OnRefundClicked"/>
            </StackPanel>
            <TextBlock x:Name="SelectionText" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="#314A56" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</UserControl>
