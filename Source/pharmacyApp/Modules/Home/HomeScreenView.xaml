<UserControl x:Class="pharmacyApp.Modules.Home.HomeScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#315A73"/><Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E7EEF1"/><Setter Property="Foreground" Value="#334E5C"/>
        </Style>
        <DataTemplate x:Key="WorkflowForwardCellTemplate">
            <Button Content="➜" Width="30" Height="26" Padding="0" Margin="3"
                    ToolTip="Open record in chat" Cursor="Hand"
                    Background="#E6F2F6" Foreground="#0C5E88" BorderBrush="#B8D2DC"
                    Click="OnWorkflowRowForwardClicked"/>
        </DataTemplate>
        <Style x:Key="CopyableMessageText" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="WorkflowSelectionCard" TargetType="ToggleButton" BasedOn="{StaticResource SquareToggleButtonStyle}">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CED2D6"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border x:Name="CheckCircle" Width="20" Height="20" CornerRadius="0" Background="#F3F6F7"
                                        BorderBrush="#B8C7CD" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CheckMark" Text="✓" Visibility="Collapsed" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="3,0,10,0">
                                    <TextBlock Text="{Binding Name}" Foreground="#243444" FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Barcode}" Foreground="#70818A" FontFamily="Consolas" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#FBE7E9" CornerRadius="0" Padding="7,3"
                                        VerticalAlignment="Center" Visibility="{Binding PassiveVisibility}">
                                    <TextBlock Text="Inactive" Foreground="#A33A45" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#8AA5B8"/><Setter TargetName="Card" Property="Background" Value="#F5F7F9"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#315A73"/><Setter TargetName="Card" Property="Background" Value="#E9EFF3"/>
                                <Setter TargetName="CheckCircle" Property="Background" Value="#315A73"/><Setter TargetName="CheckCircle" Property="BorderBrush" Value="#315A73"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkflowBranchChoice" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D3DEE2"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Choice" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="13,11">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border x:Name="RadioRing" Width="18" Height="18" CornerRadius="0" Background="White"
                                        BorderBrush="#AFC0C7" BorderThickness="1.5" VerticalAlignment="Center">
                                    <Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="#315A73" Visibility="Collapsed"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#243444" FontWeight="SemiBold"
                                           FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="›" Foreground="#78909A" FontSize="21" Margin="12,-2,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="#F6FAFA"/>
                                <Setter TargetName="Choice" Property="BorderBrush" Value="#8AA5B8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Choice" Property="Background" Value="#E9EFF3"/>
                                <Setter TargetName="Choice" Property="BorderBrush" Value="#315A73"/>
                                <Setter TargetName="RadioRing" Property="BorderBrush" Value="#315A73"/>
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkflowGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1F2"/><Setter Property="Foreground" Value="#33434E"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="11,7"/>
            <Setter Property="BorderBrush" Value="#D7E0E4"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="WorkflowGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#2F414B"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}"/>
        </Style>
        <Style x:Key="WorkflowDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E7ECEF"/>
            <Setter Property="RowHeight" Value="36"/><Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFB"/><Setter Property="AlternationCount" Value="2"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource WorkflowGridHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource WorkflowGridCell}"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/><Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/><Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="AssistantTitle" Text="Assistant" FontSize="18" FontWeight="SemiBold" Foreground="#20252B" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ModelSelectorBorder" Visibility="Collapsed" Margin="0,0,8,0"
                        Background="#F7F9FA" BorderBrush="#CED2D6" BorderThickness="1" CornerRadius="0"
                        ToolTip="Select the router model for this chat in Debug mode">
                    <ComboBox x:Name="RouterModelSelector" Width="230" Height="32" Padding="8,0"
                              Background="Transparent" BorderThickness="0" FontWeight="SemiBold"
                              Foreground="#263D49" DisplayMemberPath="SelectorLabel"/>
                </Border>
                <Button x:Name="CopyConversationButton" Content="Copy Chat" Style="{StaticResource SecondaryButton}" Click="OnCopyConversationClicked"/>
                <Button Content="New Chat" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnNewConversationClicked"/>
                <Button x:Name="LegacyAiButton" Content="Legacy AI" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnLegacyAiClicked" Visibility="Collapsed"/>
                <Button x:Name="DiagnosticsButton" Content="Diagnostics" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnDiagnosticsClicked" Visibility="Collapsed"/>
                <Button x:Name="MissingToolsButton" Content="Missing Capabilities" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnMissingToolsClicked" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0">
            <Grid>
                <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" BorderThickness="0" Background="Transparent"
                         Padding="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False" ScrollViewer.PanningMode="VerticalOnly"
                         PreviewMouseWheel="OnMessageListPreviewMouseWheel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="0" Padding="13,10" MaxWidth="{Binding BubbleMaxWidth}"
                                    HorizontalAlignment="{Binding BubbleAlignment}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding MutedForeground}" Margin="0,0,0,4"/>
                                    <Border Background="#DCEAEF" CornerRadius="0" Padding="7,3" Margin="0,0,0,7"
                                            HorizontalAlignment="Left" Visibility="{Binding ModelVisibility}">
                                        <TextBlock Text="{Binding ModelText}" Foreground="#365866" FontFamily="Consolas" FontSize="10"/>
                                    </Border>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource CopyableMessageText}"
                                             FontSize="14" TextBlock.LineHeight="21" Foreground="{Binding Foreground}"/>
                                    <Border Margin="0,12,0,0" Background="White" BorderBrush="#C8DADF"
                                            BorderThickness="1" CornerRadius="0" ClipToBounds="True"
                                            Visibility="{Binding PrescriptionVisibility}">
                                        <StackPanel>
                                            <Border Padding="13,10" Background="#EAF3F6" BorderBrush="#C8DADF" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Prescription No.:" FontSize="15" FontWeight="SemiBold" Foreground="#0C5E88"/>
                                                        <Border Padding="6,2" CornerRadius="0" ToolTip="Blue: active in Medula · White: local/offline">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="White"/>
                                                                    <Setter Property="BorderBrush" Value="#D7E0E4"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Prescription.IsLiveOnMedula}" Value="True">
                                                                            <Setter Property="Background" Value="#DCEFFC"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Prescription.PrescriptionNumber}" FontSize="15" FontWeight="Bold" Foreground="#0C5E88"/>
                                                        </Border>
                                                        <TextBlock Text="  •  E-Prescription No.: " FontSize="13" Foreground="#526E79" Margin="12,1,0,0"/>
                                                        <TextBlock Text="{Binding Prescription.ElectronicPrescriptionNumber}" FontSize="13" FontWeight="SemiBold" Foreground="#315A69" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="{Binding}" Height="30" Padding="11,0"
                                                            Background="White" Foreground="#0C5E88" BorderBrush="#B8D2DC"
                                                            FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                            Content="↗ Open in Prescription Module" Click="OnOpenPrescriptionPresentationClicked"/>
                                                </Grid>
                                            </Border>
                                            <Grid Margin="12,11,12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderBrush="#D7E2E6" BorderThickness="1" CornerRadius="0" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Patient Information" Foreground="#1769AA" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                                        <DockPanel><TextBlock Text="Patient:" Foreground="#657882" FontWeight="SemiBold"/><TextBlock Text="{Binding Prescription.PatientName}" Foreground="#263D49" FontWeight="SemiBold"/></DockPanel>
                                                        <DockPanel Margin="0,5,0,0"><TextBlock Text="National ID No.:" Foreground="#657882" FontWeight="SemiBold"/><TextBlock Text="{Binding Prescription.PatientTc}" Foreground="#263D49" FontFamily="Consolas"/></DockPanel>
                                                        <ItemsControl ItemsSource="{Binding Prescription.PrescriptionFields}" Margin="0,7,0,0">
                                                            <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3,0,0"><TextBlock Text="{Binding Label, StringFormat={}{0}: }" Foreground="#657882" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" Foreground="#263D49" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" BorderBrush="#D7E2E6" BorderThickness="1" CornerRadius="0" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Doctor Information" Foreground="#1769AA" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                                        <ItemsControl ItemsSource="{Binding Prescription.DoctorFields}">
                                                            <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3,0,0"><TextBlock Text="{Binding Label, StringFormat={}{0}: }" Foreground="#657882" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" Foreground="#263D49" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Border Margin="12,10,12,0" BorderBrush="#D7E2E6" BorderThickness="1" CornerRadius="0" ClipToBounds="True">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <Border Background="#EEF5F6" Padding="11,7"><TextBlock Text="Medicine Information" Foreground="#1769AA" FontWeight="SemiBold" FontSize="14"/></Border>
                                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Prescription.Drugs}" Style="{StaticResource WorkflowDataGrid}"
                                                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                                              MaxHeight="300" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="125"/>
                                                            <DataGridTextColumn Header="Medicine" Binding="{Binding Name}" Width="*" MinWidth="250"/>
                                                            <DataGridTextColumn Header="Boxes" Binding="{Binding Quantity}" Width="70"/>
                                                            <DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="145"/>
                                                            <DataGridTextColumn Header="Report" Binding="{Binding Report}" Width="120"/>
                                                            <DataGridTextColumn Header="Available Date" Binding="{Binding AvailableDate}" Width="125"/>
                                                            <DataGridTextColumn Header="Information" Binding="{Binding Message}" Width="180"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                            <Grid Margin="12,10,12,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderBrush="#D7E2E6" BorderThickness="1" CornerRadius="0" ClipToBounds="True">
                                                    <StackPanel><Border Background="#EEF5F6" Padding="11,7"><TextBlock Text="Diagnosis Information" Foreground="#1769AA" FontWeight="SemiBold"/></Border>
                                                        <ItemsControl ItemsSource="{Binding Prescription.Diagnoses}" Margin="11,7"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Code}" Width="85" FontFamily="Consolas" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" BorderBrush="#D7E2E6" BorderThickness="1" CornerRadius="0" ClipToBounds="True">
                                                    <StackPanel><Border Background="#EEF5F6" Padding="11,7"><TextBlock Text="Payment Information" Foreground="#1769AA" FontWeight="SemiBold"/></Border>
                                                        <ItemsControl ItemsSource="{Binding Prescription.Payments}" Margin="11,7"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label, StringFormat={}{0}: }" Foreground="#657882" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" Foreground="#263D49"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                Visibility="{Binding ResultViewOptionsVisibility}">
                                        <TextBlock Text="View" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="#637780" FontSize="12" FontWeight="SemiBold"/>
                                        <Button Content="Table" Tag="{Binding}" Click="OnShowWorkflowTableClicked"
                                                Height="30" Padding="12,0" Margin="0,0,6,0"
                                                Background="{Binding TableViewButtonBackground}" Foreground="{Binding TableViewButtonForeground}"
                                                BorderBrush="#BFD1D6"/>
                                        <Button Content="Records" Tag="{Binding}" Click="OnShowWorkflowCardsClicked"
                                                Height="30" Padding="12,0"
                                                Background="{Binding CardViewButtonBackground}" Foreground="{Binding CardViewButtonForeground}"
                                                BorderBrush="#BFD1D6"/>
                                    </StackPanel>
                                    <Border Margin="0,12,0,0" Background="White" BorderBrush="#D3DEE2"
                                            BorderThickness="1" CornerRadius="0" ClipToBounds="True" Visibility="{Binding TableVisibility}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Background="#F3F7F8" BorderBrush="#D8E2E5" BorderThickness="0,0,0,1" Padding="13,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Table.Title}" FontWeight="SemiBold" FontSize="14" Foreground="#243444"/>
                                                        <Border Background="#DDEAE9" CornerRadius="0" Padding="8,3" Margin="9,0,0,0">
                                                            <TextBlock Text="{Binding Table.RowCountText}" Foreground="#49646B" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding Table.HiddenColumnsButtonText}" Tag="{Binding}"
                                                            Click="OnToggleHiddenWorkflowColumnsClicked" Visibility="{Binding Table.HiddenColumnsButtonVisibility}"
                                                            Height="30" Padding="10,0" Margin="12,0,0,0" Background="White"
                                                            Foreground="#48606B" BorderBrush="#CBD8DD"/>
                                                    <Border Grid.Column="2" Height="30" Margin="14,0,12,0" Background="White" BorderBrush="#CBD8DD"
                                                            BorderThickness="1" CornerRadius="0" Padding="9,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="⌕" Foreground="#71858E" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Table.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="Search table" BorderThickness="0" Background="Transparent"
                                                                     VerticalContentAlignment="Center" Foreground="#334E5C"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding Table.ColorSelectorVisibility}">
                                                        <TextBlock Text="Row color" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="#637780" FontSize="11"/>
                                                        <ComboBox ItemsSource="{Binding Table.ColorModes}" DisplayMemberPath="Label"
                                                                  SelectedItem="{Binding Table.SelectedColorMode, Mode=TwoWay}"
                                                                  MinWidth="175" Height="29" Padding="7,2"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding Table.Rows}" AutoGenerateColumns="True"
                                                      AutoGeneratingColumn="OnWorkflowTableAutoGeneratingColumn"
                                                      AutoGeneratedColumns="OnWorkflowTableAutoGeneratedColumns"
                                                      Style="{StaticResource WorkflowDataGrid}"
                                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                                      HeadersVisibility="Column" MaxHeight="420" HorizontalAlignment="Stretch"
                                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                      SelectionChanged="OnWorkflowTableSelectionChanged"
                                                      PreviewMouseLeftButtonUp="OnWorkflowTableLeftClick"
                                                      PreviewMouseRightButtonDown="OnWorkflowTableRightClick"
                                                      ContextMenuOpening="OnWorkflowTableContextMenuOpening">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Tag="open" Header="Open in App" Click="OnWorkflowTableOpenClicked"/>
                                                        <MenuItem Tag="chat" Header="Open in Chat" Click="OnWorkflowTableChatOpenClicked"/>
                                                    </ContextMenu>
                                                </DataGrid.ContextMenu>
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="Background" Value="{Binding [__row_color]}"/>
                                                        <Setter Property="BorderBrush" Value="#E1E8EB"/>
                                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                            </DataGrid>
                                            <Border Grid.Row="2" Margin="12,10,12,12" Padding="12"
                                                    Background="#F7F7F7" BorderBrush="#CEDDE2" BorderThickness="1"
                                                    CornerRadius="0" Visibility="{Binding Table.DetailVisibility}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Table.DetailTitle}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="#244A5A" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="Row details" Foreground="#71858E"
                                                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Table.DetailMessage}" Foreground="#5B707A"
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Visibility="{Binding Table.DetailMessageVisibility}"/>
                                                    <ProgressBar Height="3" Margin="0,7,0,0" IsIndeterminate="True"
                                                                 Foreground="#315A73" Background="#CFE7E3"
                                                                 Visibility="{Binding Table.DetailLoadingVisibility}"/>
                                                    <DataGrid ItemsSource="{Binding Table.InlineDetail.Rows}"
                                                              Tag="{Binding Table.InlineDetail}"
                                                              AutoGenerateColumns="True"
                                                              AutoGeneratingColumn="OnWorkflowTableAutoGeneratingColumn"
                                                              Style="{StaticResource WorkflowDataGrid}"
                                                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                                              HeadersVisibility="Column" MaxHeight="280" Margin="0,8,0,0"
                                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                              Visibility="{Binding Table.DetailGridVisibility}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Margin="0,10,0,0" Padding="12" Background="#F8F8F8" BorderBrush="#D5E5E3"
                                            BorderThickness="1" CornerRadius="0" Visibility="{Binding WorkflowContentVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding WorkflowContent.Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#214B49" Margin="0,0,0,9"/>
                                            <ItemsControl ItemsSource="{Binding WorkflowContent.Items}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MinWidth="320" MaxWidth="640" Margin="0,0,10,10" Padding="17"
                                                                Background="White" BorderBrush="#D9E5E7" BorderThickness="1" CornerRadius="0">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="#243444" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Subtitle}" Foreground="#5E737D" FontSize="15" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Value}" Foreground="#0D7E75" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                                <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource CopyableMessageText}"
                                                                             Foreground="#344F5C" FontSize="15" TextBlock.LineHeight="22" Margin="0,9,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <ProgressBar Height="3" Margin="0,9,0,0" IsIndeterminate="True"
                                                 Foreground="#315A73" Background="#CFE7E3"
                                                 Visibility="{Binding LoadingVisibility}"/>
                                    <Border Margin="0,10,0,0" Padding="10" Background="#12212A" CornerRadius="0"
                                            Visibility="{Binding DebugVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="Debug Trace" Foreground="#8DE3D8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding DebugText, Mode=OneWay}" Style="{StaticResource CopyableMessageText}"
                                                     Foreground="#D6E6EB" FontFamily="Consolas" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding RequestCaptureFiles}" Margin="0,9,0,0"
                                                  Visibility="{Binding RequestCaptureFilesVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}" Margin="0,0,8,7" Height="32" Padding="11,0"
                                                        Background="#EEF5FF" Foreground="#245A8D" BorderBrush="#C8DAEC"
                                                        BorderThickness="1" FontWeight="SemiBold" Click="OnAiRequestCaptureClicked"
                                                        ToolTip="{Binding FilePath}">
                                                    <TextBlock Text="{Binding Label}"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="AnswerFooter" Margin="0,9,0,0" FontSize="11"
                                               Foreground="{Binding MutedForeground}" TextWrapping="Wrap"
                                               Visibility="{Binding FooterVisibility}">
                                        <Run Text="{Binding UsageFooterText, Mode=OneWay}"/><Run Text="{Binding WorkflowFooterText, Mode=OneWay}" Foreground="Red"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding SuggestedActions}" Margin="0,9,0,0"
                                                  Visibility="{Binding ActionsVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}" Tag="{Binding}" Margin="0,0,8,7"
                                                        Height="32" Padding="12,0" Background="#315A73" Foreground="White"
                                                        BorderThickness="0" FontWeight="SemiBold"
                                                        Click="OnSuggestedActionClicked"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding ModuleActions}" Margin="0,9,0,0"
                                                  Visibility="{Binding ModuleActionsVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}" Margin="0,0,8,7" Height="34" Padding="12,0"
                                                        Background="#E5F1F0" Foreground="#315A73" BorderBrush="#BFD8D5"
                                                        BorderThickness="1" FontWeight="SemiBold" Click="OnWorkflowModuleActionClicked">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="↗" FontSize="14" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding Label}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Margin="0,11,0,0" Padding="11" Background="#F8FAFB" BorderBrush="#D7E1E5"
                                            BorderThickness="1" CornerRadius="0" Visibility="{Binding WorkflowSelectionVisibility}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WorkflowSelectionTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#243444"/>
                                                    <TextBlock Text="{Binding WorkflowSelectionSummary}" Foreground="#6B7D86" FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding MultiSelectionVisibility}">
                                                    <Button Content="Select All" Tag="{Binding}" Click="OnSelectAllWorkflowOptionsClicked"
                                                            Height="28" Padding="9,0" Background="#E5EFEE" Foreground="#315A73" BorderBrush="#C8DAD8"/>
                                                    <Button Content="Clear" Tag="{Binding}" Click="OnClearWorkflowOptionsClicked" Margin="6,0,0,0"
                                                            Height="28" Padding="9,0" Background="White" Foreground="#586C76" BorderBrush="#D0DBDF"/>
                                                </StackPanel>
                                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="{Binding WorkflowSelectionToolsVisibility}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Height="32" Background="White" BorderBrush="#CBD8DD" BorderThickness="1" CornerRadius="0" Padding="9,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="⌕" Foreground="#71858E" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBox Grid.Column="1" Text="{Binding WorkflowSelectionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="{Binding WorkflowSelectionSearchHint}" BorderThickness="0" Background="Transparent"
                                                                     VerticalContentAlignment="Center" Foreground="#334E5C"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="1" Content="{Binding PassiveToggleText}" Tag="{Binding}"
                                                            Click="OnTogglePassiveWorkflowOptionsClicked" Visibility="{Binding PassiveToggleVisibility}"
                                                            Margin="8,0,0,0" Height="32" Padding="11,0" Background="#FFF5F5"
                                                            Foreground="#9A3D46" BorderBrush="#E7C7CB"/>
                                                </Grid>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding WorkflowSelectionOptions}"
                                                          Visibility="{Binding WorkflowBranchSelectionVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton Style="{StaticResource WorkflowBranchChoice}"
                                                                     GroupName="WorkflowBranch"
                                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding WorkflowSelectionView}"
                                                          Visibility="{Binding WorkflowPickerVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Columns="{Binding WorkflowSelectionColumnCount}"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Style="{StaticResource WorkflowSelectionCard}" Margin="0,0,7,7"
                                                                      MinWidth="260" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        <TextBlock Text="{Binding WorkflowSelectionError}" Foreground="#B42318" FontSize="11"
                                                   Margin="0,5,0,7" Visibility="{Binding WorkflowSelectionErrorVisibility}"/>
                                            <Button Content="{Binding WorkflowSelectionConfirmText}" Tag="{Binding}" HorizontalAlignment="Right" Margin="0,8,0,0"
                                                    Height="36" Padding="18,0" Background="#315A73" Foreground="White"
                                                    BorderThickness="0" FontWeight="SemiBold" Click="OnWorkflowSelectionCompleteClicked"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ConfirmationPanel" Grid.Row="2" Margin="0,12,0,0" Padding="14" Background="#FFF8E8" BorderBrush="#E7C66D" BorderThickness="1" CornerRadius="0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ConfirmationTitle" Text="Confirmation Required" FontWeight="SemiBold" Foreground="#6F4E00"/>
                    <TextBlock x:Name="ConfirmationSummary" Margin="0,4,12,0" TextWrapping="Wrap" Foreground="#5D4A18"/>
                    <TextBox x:Name="ConfirmationArguments" Margin="0,8,12,0" MaxHeight="90" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="RejectButton" Content="Reject" Style="{StaticResource SecondaryButton}" Click="OnRejectClicked"/>
                    <Button x:Name="ConfirmButton" Content="Confirm" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Click="OnConfirmClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#C9D6DC" BorderThickness="1" CornerRadius="0" Padding="1">
                <TextBox x:Name="MessageBox" MinHeight="44" MaxHeight="120" Padding="12,9" BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnMessageBoxPreviewKeyDown"/>
            </Border>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnCancelClicked" Visibility="Collapsed"/>
            <Button x:Name="SendButton" Grid.Column="2" Content="Send" Margin="10,0,0,0" Style="{StaticResource ActionButton}" Click="OnSendClicked"/>
        </Grid>
    </Grid>
</UserControl>
