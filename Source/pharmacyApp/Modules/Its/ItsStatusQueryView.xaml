<UserControl x:Class="pharmacyApp.Modules.Its.ItsStatusQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Background="{StaticResource Canvas}">
    <UserControl.Resources>
        <Style x:Key="ResultCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedInk}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="ResultCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E2E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30" MaxWidth="1180" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="ITS Query" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource ResultCard}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Medicine QR code" Style="{StaticResource ResultCaption}"/>
                        <TextBox x:Name="QrCodeBox" Height="42" Padding="11,7" FontSize="14"
                                 VerticalContentAlignment="Center" BorderBrush="#BCCCD3" BorderThickness="1"
                                 PreviewKeyDown="OnQrCodeKeyDown"
                                 ToolTip="Accepts the ]d2 prefix, parenthesized GS1 fields, FNC1/GS and supported unseparated ITS formats."/>
                    </StackPanel>
                    <Button x:Name="QueryButton" Grid.Column="2" Width="46" Height="42" VerticalAlignment="Bottom"
                            Background="{StaticResource Accent}" BorderThickness="0" ToolTip="Query"
                            Click="OnQueryClicked">
                        <Viewbox Width="21" Height="21">
                            <Canvas Width="20" Height="20">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="11" Height="11"
                                         Stroke="White" StrokeThickness="2.2"/>
                                <Line X1="11" Y1="11" X2="18" Y2="18" Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="ResultsPanel" Grid.Row="3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource ResultCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PRODUCT INFORMATION" Style="{StaticResource ResultCaption}"/>
                        <TextBlock x:Name="ProductNameText" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProductIdentifiersText" Margin="0,10,0,0" Foreground="#53636C"
                                   FontSize="13" LineHeight="21" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProductQrText" Margin="0,3,0,0" Foreground="{StaticResource MutedInk}"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#F6F8F9" BorderBrush="#D8E2E7"
                        BorderThickness="1" CornerRadius="0" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LATEST MOVEMENT" Style="{StaticResource ResultCaption}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LatestMovementText" Grid.Column="1" Foreground="{StaticResource Ink}"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ResultCard}">
                    <StackPanel>
                        <TextBlock Text="LOCAL DATABASE" Style="{StaticResource ResultCaption}"/>
                        <TextBlock x:Name="LocalSummaryText" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                        <Separator Margin="0,16,0,14" Background="#E3E9EC"/>
                        <TextBlock x:Name="LocalDetailsText" Foreground="#53636C" FontSize="13"
                                   LineHeight="21" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ResultCard}">
                    <StackPanel>
                        <TextBlock Text="MEDICINE TRACKING SYSTEM" Style="{StaticResource ResultCaption}"/>
                        <TextBlock x:Name="ItsSummaryText" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                        <Separator Margin="0,16,0,14" Background="#E3E9EC"/>
                        <TextBlock x:Name="ItsDetailsText" Foreground="#53636C" FontSize="13"
                                   LineHeight="21" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="ComparisonPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,16,0,0"
                    Background="#F6F8F9" BorderBrush="#D8E2E7" BorderThickness="1" CornerRadius="0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="COMPARISON" Style="{StaticResource ResultCaption}"/>
                    <TextBlock x:Name="ComparisonText" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="QueryMetaText" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,16,0,0" Foreground="{StaticResource MutedInk}"
                       TextWrapping="Wrap"/>
        </Grid>
    </ScrollViewer>
</UserControl>
