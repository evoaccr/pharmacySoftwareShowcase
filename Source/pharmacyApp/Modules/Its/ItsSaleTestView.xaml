<UserControl x:Class="pharmacyApp.Modules.Its.ItsSaleTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             Background="{StaticResource Canvas}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedInk}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="BorderBrush" Value="#C9D4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E8EFF1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#CAD6DC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="ITS Sale Test" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Connection" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,14"/>
                            <TextBlock Text="ITS environment" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="EnvironmentBox" Height="36" DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnConfigurationChanged"/>
                            <TextBlock Text="Access token endpoint" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                            <TextBox x:Name="TokenEndpointBox" Style="{StaticResource InputBox}" IsReadOnly="True" Background="#F2F3F4"/>
                            <TextBlock Text="ITS credentials are read from Settings > ITS Settings. Access tokens are not stored permanently."
                                       Foreground="{StaticResource MutedInk}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Button x:Name="TestConnectionButton" Content="Test Connection (Token Only)"
                                    Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" Click="OnTestConnectionClicked"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Notification" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,14"/>
                            <TextBlock Text="Movement" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="OperationBox" Height="36" DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnConfigurationChanged"/>
                            <TextBlock Text="Notification endpoint" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                            <TextBox x:Name="NotificationEndpointBox" Style="{StaticResource InputBox}" IsReadOnly="True" Background="#F2F3F4"/>
                            <TextBlock Text="Pharmacy GLN" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                            <TextBox x:Name="PharmacyGlnBox" Style="{StaticResource InputBox}" MaxLength="13" TextChanged="OnQrOrGlnChanged"/>
                            <TextBlock Text="QR Code / GS1 QR Code content" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                            <TextBox x:Name="QrCodeBox" Style="{StaticResource InputBox}" TextChanged="OnQrOrGlnChanged"
                                     ToolTip="Supports the ]d2 prefix, parenthesized AI format and the ASCII 29 FNC1/GS separator."/>
                            <TextBlock Text="The standard unseparated ITS order is supported: 01 + GTIN, 21 + 16-digit serial, 17 + expiry, 10 + batch. Other orders require FNC1/GS after variable fields; &lt;GS&gt; or [GS] may also be used."
                                       Foreground="{StaticResource MutedInk}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,7,10">
                                    <TextBlock Text="GTIN" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="GtinBox" Style="{StaticResource InputBox}" IsReadOnly="True" Background="#F2F3F4"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="7,0,0,10">
                                    <TextBlock Text="Serial number" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SerialNumberBox" Style="{StaticResource InputBox}" IsReadOnly="True" Background="#F2F3F4"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,7,0">
                                    <TextBlock Text="Batch number" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BatchNumberBox" Style="{StaticResource InputBox}" IsReadOnly="True" Background="#F2F3F4"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="7,0,0,0">
                                    <TextBlock Text="Expiry date" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ExpiryDateBox" Style="{StaticResource InputBox}" IsReadOnly="True" Background="#F2F3F4"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ValidationText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#B33A32"/>
                            <Button x:Name="SendButton" Content="Send ITS Sale Notification"
                                    Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" MinWidth="240"
                                    HorizontalAlignment="Stretch" Click="OnSendClicked" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="JSON to Send" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        <TextBox x:Name="RequestPreviewBox" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="#F8FAFB" BorderBrush="#C8CDD2" Padding="10"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="ITS response" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        <TextBox x:Name="ResponseBox" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#F8FAFB" BorderBrush="#C8CDD2" Padding="10"
                                 Text="No requests sent yet."/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,16,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
