<UserControl x:Class="pharmacyApp.Modules.Its.ItsDrugListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Canvas}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="ITS Medicine List" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}"/>
                </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8E2E7" BorderThickness="1"
                CornerRadius="0" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ITS environment" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,0,0,5"/>
                    <ComboBox x:Name="EnvironmentBox" Height="36" DisplayMemberPath="DisplayName"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Search list" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="SearchBox" Height="36" Padding="9,5" VerticalContentAlignment="Center"
                             TextChanged="OnSearchTextChanged" ToolTip="Search by medicine name, GTIN, manufacturer name or GLN"/>
                </StackPanel>
                <CheckBox x:Name="IncludeInactiveBox" Grid.Column="4" VerticalAlignment="Bottom" Height="36"
                          VerticalContentAlignment="Center" Content="Include inactive medicines"/>
                <Button x:Name="LoadButton" Grid.Column="6" MinWidth="148" Height="36" VerticalAlignment="Bottom"
                        Padding="14,5" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                        Content="Load List" Click="OnLoadClicked"/>
                <Button x:Name="CancelButton" Grid.Column="6" MinWidth="148" Height="36" VerticalAlignment="Bottom"
                        Padding="14,5" Visibility="Collapsed" Content="Cancel" Click="OnCancelClicked"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#D8E2E7" BorderThickness="1" CornerRadius="0">
            <DataGrid x:Name="DrugGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="GTIN" Binding="{Binding Gtin}" Width="150"/>
                    <DataGridTextColumn Header="Medicine Name" Binding="{Binding DrugName}" Width="2.3*" MinWidth="240"/>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding ManufacturerName}" Width="1.7*" MinWidth="190"/>
                    <DataGridTextColumn Header="Manufacturer GLN" Binding="{Binding ManufacturerGln}" Width="145"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding ActiveDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Origin" Binding="{Binding ImportedDisplay}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CountText" Grid.Column="1" Foreground="{StaticResource MutedInk}" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</UserControl>
