<UserControl x:Class="pharmacyApp.Modules.WebDepots.Cooperative.CooperativeWebDepotTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E8EFF1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#CAD6DC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#B43434"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}"/>
            </StackPanel>
            <Border Padding="12,7" CornerRadius="0" Background="#E8F5F2"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="ConnectionStateText" Text="Disconnected"
                           VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="#5E6770"/>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
            <Button x:Name="LoginButton" Content="Sign In" Style="{StaticResource PrimaryButton}"
                    Click="LoginClick"/>
            <Button Content="Show Browser" Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Click="ShowBrowserClick"/>
            <Button x:Name="RestartBrowserButton" Content="Restart Browser"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Click="RestartBrowserClick"/>
        </WrapPanel>

        <Border Grid.Row="2" Margin="0,0,0,12" Padding="16" Background="#FAFAFA"
                BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Barcode" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBox x:Name="BasketBarcodeTextBox" Height="36" Margin="0,6,0,0"
                             MaxLength="13" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Quantity" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBox x:Name="DecreaseAmountTextBox" Height="36" Margin="0,6,0,0"
                             Text="1" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="BasketButton" Content="View Basket" Style="{StaticResource PrimaryButton}"
                        Click="BasketClick"/>
                <Button x:Name="PriceInfoButton" Content="View Prices / Promotions"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Click="PriceInfoClick"/>
                <Button x:Name="AddBasketButton" Content="Add to Basket"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Click="AddBasketClick"/>
                <Button x:Name="DecreaseBasketButton" Content="Reduce Quantity"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Click="DecreaseBasketClick"/>
                <Button x:Name="RemoveBasketButton" Content="Remove Barcode"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Click="RemoveBasketClick"/>
                <Button x:Name="ClearBasketButton" Content="Clear Basket"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Click="ClearBasketClick"/>
                <Button x:Name="PurchaseButton" Content="Place Order"
                        Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                        Click="PurchaseClick"/>
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="4" Background="#FAFAFA" BorderBrush="#C8CDD2"
                BorderThickness="1" CornerRadius="0" Padding="18" MinHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Connection log" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}"/>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="StatusLogText"
                               Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Name="SettingsHintText" Grid.Row="5" Margin="0,18,0,0"
                   Foreground="{StaticResource MutedInk}"/>
    </Grid>
</UserControl>
