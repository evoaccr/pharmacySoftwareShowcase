<UserControl x:Class="pharmacyApp.Modules.WebDepots.Selcuk.SelcukTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E8EFF1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#CAD6DC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#B43434"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Selcuk Test" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
            </StackPanel>
            <Border Padding="12,7" CornerRadius="0" Background="#E8F5F2"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="ConnectionStateText" Text="Disconnected" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="#5E6770"/>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
            <Button x:Name="LoginButton" Content="Sign In" Style="{StaticResource PrimaryButton}"
                    Click="LoginClick"/>
            <Button Content="Show Browser" Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Click="ShowBrowserClick"/>
            <Button x:Name="BasketButton" Content="View Basket" Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Click="BasketClick"/>
            <Button x:Name="RestartBrowserButton" Content="Restart Browser"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Click="RestartBrowserClick"/>
        </WrapPanel>

        <Border Grid.Row="2" Margin="0,0,0,18" Padding="16" Background="#FAFAFA"
                BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0">
            <StackPanel>
                <TextBlock Text="Product and Basket Operations" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}"/>
                <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Barcode" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}"/>
                    <TextBox x:Name="BasketBarcodeTextBox" Width="170" Height="34" Margin="8,0,14,0"
                             VerticalContentAlignment="Center" MaxLength="14"/>
                    <TextBlock Text="Quantity" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedInk}"/>
                    <TextBox x:Name="DecreaseAmountTextBox" Width="70" Height="34" Margin="8,0,10,0"
                             VerticalContentAlignment="Center" Text="1" MaxLength="6"/>
                    <Button x:Name="AddButton" Content="Add to Basket" Style="{StaticResource PrimaryButton}"
                            Click="AddBasketClick"/>
                    <Button x:Name="PriceInfoButton" Content="View Prices / Promotions" Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" Click="PriceInfoClick"/>
                    <Button x:Name="DecreaseButton" Content="Reduce Quantity" Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" Click="DecreaseBasketClick"/>
                    <Button x:Name="RemoveButton" Content="Remove Barcode" Style="{StaticResource DangerButton}"
                            Margin="10,0,0,0" Click="RemoveBasketClick"/>
                    <Button x:Name="ClearButton" Content="Clear Basket" Style="{StaticResource DangerButton}"
                            Margin="10,0,0,0" Click="ClearBasketClick"/>
                    <Button x:Name="PurchaseButton" Content="Place Order" Style="{StaticResource DangerButton}"
                            Margin="10,0,0,0" Click="PurchaseClick"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#C8CDD2" BorderThickness="1"
                CornerRadius="0" Padding="18" MinHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Connection log" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="StatusLogText" Text="The browser will be visible while Selcuk Test is open."
                               Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,18,0,0" Foreground="{StaticResource MutedInk}"
                   Text="Credentials are read from Settings → Selcuk Warehouse (Depot)."/>
    </Grid>
</UserControl>
