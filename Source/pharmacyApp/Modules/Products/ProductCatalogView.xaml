                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border Width="40" Height="40" Margin="0,0,0,6" Padding="5" Background="#E61D2A33" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="0" Cursor="Help" ToolTipService.InitialShowDelay="120" ToolTipService.BetweenShowDelay="60" ToolTipService.ShowDuration="30000">
                                                        <Border.ToolTip><ToolTip Placement="Right" HorizontalOffset="7" Background="Transparent" BorderThickness="0" Padding="0"><Border MaxWidth="360" Background="#F51D2A33" BorderBrush="#52636E" BorderThickness="1" CornerRadius="0" Padding="13"><StackPanel><TextBlock Text="{Binding Header}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/><Border Height="1" Background="#566873" Margin="0,8,0,7"/><TextBlock Text="{Binding Description}" Foreground="#EDF3F6" FontSize="12" LineHeight="18" TextWrapping="Wrap"/></StackPanel></Border></ToolTip></Border.ToolTip>
