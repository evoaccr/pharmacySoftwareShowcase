<UserControl x:Class="pharmacyApp.Modules.Products.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:products="clr-namespace:pharmacyApp.Modules.Products"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#F2F3F4" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <products:WarningIconConverter x:Key="WarningIconConverter"/>
        <ContextMenu x:Key="ProductActionMenu" x:Shared="False">
            <MenuItem Header="Compare Medicines" Click="OnCompareProductMenuItemClicked"/>
            <MenuItem Header="Edit Product" IsEnabled="False" ToolTip="Product editing is not available yet."/>
        </ContextMenu>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65717E"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#18212B"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SelectableFieldValue" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="Foreground" Value="#18212B"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="FieldCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CED2D6"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="ArrowToggle" TargetType="ToggleButton" BasedOn="{StaticResource SquareToggleButtonStyle}">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="22"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6,-3,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Background" Value="#F0F2F4"/><Setter Property="Foreground" Value="#315A73"/><Setter Property="BorderBrush" Value="#C6D0D8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ArrowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="0">
                            <Grid>
                                <Path x:Name="ArrowDown" Data="M 1,2 L 6,7 L 11,2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="ArrowUp" Data="M 1,7 L 6,2 L 11,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions>
                                <Setter TargetName="ArrowBorder" Property="Background" Value="#E5E9ED"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ArrowBorder" Property="Background" Value="#DCE5ED"/>
                                <Setter TargetName="ArrowDown" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ArrowUp" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterChip" TargetType="Border">
            <Setter Property="Background" Value="#B42318"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="QrPresetButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#F0F2F4"/><Setter Property="Foreground" Value="#315A73"/><Setter Property="BorderBrush" Value="#C6D0D8"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource SquareToggleButtonStyle}">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="#F3F6F7"/><Setter Property="BorderBrush" Value="#CDD7DC"/>
            <Setter Property="ToolTip" Value="Show or hide filters"/><Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="FilterBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="0">
                        <Path Data="M 1,1 L 13,1 L 8.4,6.2 L 8.4,11 L 5.6,12.5 L 5.6,6.2 Z" Fill="#40535E" Width="14" Height="13" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="FilterBorder" Property="Background" Value="#E8EFF1"/></MultiTrigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="FilterBorder" Property="Background" Value="#DCE7E8"/><Setter TargetName="FilterBorder" Property="BorderBrush" Value="#9CB4B4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderFilterButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Width" Value="22"/><Setter Property="Height" Value="20"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="5,-3,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="ToolTip" Value="Filter by this value"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="HeaderFilterBorder" Background="{TemplateBinding Background}" CornerRadius="0">
                    <Path Data="M 1,1 L 11,1 L 7.2,5.4 L 7.2,9.5 L 4.8,10.8 L 4.8,5.4 Z" Fill="#60727D" Width="12" Height="11" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFilterBorder" Property="Background" Value="#E2E9EB"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CopyValueButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Width" Value="22"/><Setter Property="Height" Value="20"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="5,-3,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="ToolTip" Value="Copy value"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CopyBorder" Background="{TemplateBinding Background}" CornerRadius="0">
                    <Grid Width="12" Height="12"><Path Data="M3,2 L9,2 L9,11 L3,11 Z" Stroke="#60727D" StrokeThickness="1.2"/><Path Data="M1,0 L7,0 L7,2 M1,0 L1,9 L3,9" Stroke="#60727D" StrokeThickness="1.2"/></Grid>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CopyBorder" Property="Background" Value="#E2E9EB"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StockRangeTextBox" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="Height" Value="26"/><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Grid><Border Background="White" BorderBrush="#C9D4DA" BorderThickness="1" CornerRadius="0"/><ScrollViewer x:Name="PART_ContentHost" Margin="6,2"/>
                    <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Foreground="#98A4AC" Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="Text" Value=""/><Condition Property="IsKeyboardFocusWithin" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></MultiTrigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PhotoNavigationButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="PhotoButtonBorder" Background="{TemplateBinding Background}" CornerRadius="0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PhotoButtonBorder" Property="Background" Value="#26FFFFFF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="PhotoButtonBorder" Property="Background" Value="#3DFFFFFF"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CenteredGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CatalogTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#364049"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#C8CDD2"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="TabBorder" Property="Background" Value="#D3DFE8"/></MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#294C62"/><Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CatalogTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="#E4E7EA" CornerRadius="0" Padding="8,6,8,0">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                            </Border>
                            <Border Grid.Row="1" Background="#F2F3F4" BorderBrush="#C8CDD2" BorderThickness="1,0,1,1" CornerRadius="0" Padding="12">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CatalogGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C8CDD2"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8ECEF"/>
            <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFB"/><Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="RowHeight" Value="34"/><Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="ClipboardCopyMode" Value="ExcludeHeader"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SortableDataGridColumnHeaderStyle}">
            <Setter Property="Background" Value="#EAF1F2"/><Setter Property="Foreground" Value="#33434E"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/><Setter Property="BorderBrush" Value="#C8CDD2"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <TextBlock x:Name="MedicineRangeNotice" DockPanel.Dock="Top"
                   Text="Only medicine in AA-AV interval are included due to MIT version"
                   Foreground="Red" FontWeight="SemiBold" TextWrapping="Wrap" Margin="16,8,16,0"/>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="Auto"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="610"/></Grid.ColumnDefinitions>
        <Border x:Name="SidebarHost" Grid.Column="0" Width="344" Background="White" BorderBrush="#D6DDE3" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Height="34" Padding="9,6" VerticalContentAlignment="Center" ToolTip="Search name, barcode or active ingredient" TextChanged="OnFilterTextChanged"/>
                    <ToggleButton x:Name="FilterToggle" Grid.Column="1" Style="{StaticResource IconFilterToggle}" Margin="7,0,0,0" Checked="OnFilterToggleChanged" Unchecked="OnFilterToggleChanged"/>
                </Grid>
                <WrapPanel x:Name="ActiveFilterChipsPanel" Grid.Row="1">
                    <Border x:Name="ActiveHeaderFilterChip" Style="{StaticResource FilterChip}"><StackPanel Orientation="Horizontal"><Button Content="×" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" FontWeight="SemiBold" Padding="0" Width="20" Height="19" Click="OnClearHeaderFilterClicked"/><TextBlock x:Name="ActiveHeaderFilterText" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0"/></StackPanel></Border>
                    <Border x:Name="ProductPrefixFilterChip" Style="{StaticResource FilterChip}"><StackPanel Orientation="Horizontal"><Button Tag="ProductPrefix" Content="×" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" FontWeight="SemiBold" Padding="0" Width="20" Height="19" Click="OnClearStandardFilterClicked"/><TextBlock x:Name="ProductPrefixFilterChipText" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0"/></StackPanel></Border>
                    <Border x:Name="IngredientFilterChip" Style="{StaticResource FilterChip}"><StackPanel Orientation="Horizontal"><Button Tag="Ingredient" Content="×" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" FontWeight="SemiBold" Padding="0" Width="20" Height="19" Click="OnClearStandardFilterClicked"/><TextBlock x:Name="IngredientFilterChipText" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0"/></StackPanel></Border>
                    <Border x:Name="PrescriptionFilterChip" Style="{StaticResource FilterChip}"><StackPanel Orientation="Horizontal"><Button Tag="Prescription" Content="×" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="15" FontWeight="SemiBold" Padding="0" Width="20" Height="19" Click="OnClearStandardFilterClicked"/><TextBlock x:Name="PrescriptionFilterChipText" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0"/></StackPanel></Border>
                    <Border x:Name="IgnoredFiltersSearchChip" Background="#F4C542" CornerRadius="0" Padding="6,4" Margin="0,0,5,5" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><Button Content="×" Foreground="#4A3A00" Background="Transparent" BorderThickness="0" FontSize="15" FontWeight="SemiBold" Padding="0" Width="20" Height="19" Click="OnClearIgnoredFilterSearchClicked"/><TextBlock Text="No results. Searching without filters." Foreground="#4A3A00" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" TextWrapping="Wrap"/></StackPanel></Border>
                </WrapPanel>
                <Border x:Name="FilterPanel" Grid.Row="2" Visibility="Collapsed" Background="#F5F8F9" BorderBrush="#DCE4E8" BorderThickness="1" CornerRadius="0" Padding="8" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <CheckBox x:Name="OnlyInStockToggle" Grid.ColumnSpan="2" Content="In-stock Products Only" FontSize="11" Margin="0,0,0,5" Checked="OnFilterChanged" Unchecked="OnFilterChanged" ToolTip="The initial value is set by the module's launch source."/>
                        <CheckBox x:Name="OnlyOnMarketToggle" Grid.Row="1" Grid.ColumnSpan="2" Content="Marketed Products Only" FontSize="11" Margin="0,0,0,5" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                        <CheckBox x:Name="OnlyWithMovementsToggle" Grid.Row="6" Grid.ColumnSpan="2" Content="Only show medication with movements" IsChecked="True" FontSize="11" Margin="0,7,0,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                        <TextBlock Grid.Row="2" Text="Product Prefix" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ProductPrefixFilter" Grid.Row="2" Grid.Column="1" Height="27" MaxDropDownHeight="230" ToolTip="Leave blank for all" SelectionChanged="OnFilterChanged"/>
                        <TextBlock Grid.Row="3" Text="Active Ingredient" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,6,5,0"/>
                        <ComboBox x:Name="IngredientFilter" Grid.Row="3" Grid.Column="1" Height="27" Margin="0,5,0,0" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="250" ToolTip="Leave blank for all" SelectionChanged="OnFilterChanged">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Width="190" MaxWidth="190" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="4" Text="Prescription Type" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,6,5,0"/>
                        <ComboBox x:Name="PrescriptionFilter" Grid.Row="4" Grid.Column="1" Height="27" Margin="0,5,0,0" MaxDropDownHeight="230" ToolTip="Leave blank for all" SelectionChanged="OnFilterChanged"/>
                        <TextBlock Grid.Row="5" Text="Stock Quantity" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,7,5,0"/>
                        <Grid Grid.Row="5" Grid.Column="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="StockRangeToggle" Width="20" VerticalAlignment="Center" ToolTip="Enable stock range filter" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                            <TextBox x:Name="StockMinimumFilter" Grid.Column="1" Tag="min" Style="{StaticResource StockRangeTextBox}" IsEnabled="{Binding IsChecked, ElementName=StockRangeToggle}" TextChanged="OnStockRangeTextChanged"/>
                            <TextBlock Grid.Column="2" Text="–" Margin="5,0" VerticalAlignment="Center" Foreground="#65717E"/>
                            <TextBox x:Name="StockMaximumFilter" Grid.Column="3" Tag="max" Style="{StaticResource StockRangeTextBox}" IsEnabled="{Binding IsChecked, ElementName=StockRangeToggle}" TextChanged="OnStockRangeTextChanged"/>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Row="3" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Tag="Name" Click="OnListSortClicked" Background="#EAF1F2" BorderBrush="#C8CDD2" BorderThickness="1" Padding="7,5" HorizontalContentAlignment="Left"><TextBlock x:Name="NameSortHeader" FontSize="11" FontWeight="SemiBold" Foreground="#33434E"/></Button>
                    <Button Grid.Column="1" Tag="Price" Click="OnListSortClicked" Background="#EAF1F2" BorderBrush="#C8CDD2" BorderThickness="0,1,1,1" Padding="5" HorizontalContentAlignment="Center"><TextBlock x:Name="PriceSortHeader" FontSize="11" FontWeight="SemiBold" Foreground="#33434E"/></Button>
                    <Button Grid.Column="2" Tag="Stock" Click="OnListSortClicked" Background="#EAF1F2" BorderBrush="#C8CDD2" BorderThickness="0,1,1,1" Padding="5" HorizontalContentAlignment="Center"><TextBlock x:Name="StockSortHeader" FontSize="11" FontWeight="SemiBold" Foreground="#33434E"/></Button>
                </Grid>
                <Grid Grid.Row="4">
                    <ListBox x:Name="ProductList" BorderThickness="0" Background="Transparent" SelectionChanged="OnProductSelected" PreviewMouseRightButtonDown="OnProductListPreviewMouseRightButtonDown" PreviewMouseLeftButtonDown="OnProductScrollMouseDown" PreviewMouseLeftButtonUp="OnProductScrollMouseUp" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"><Setter Property="ContextMenu" Value="{StaticResource ProductActionMenu}"/></Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="5,6" Width="278">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="#1D2935" TextWrapping="Wrap" Text="{Binding DisplayName}"/>
                                    <TextBlock Grid.Column="1" Text="○" Foreground="#7C8891" Opacity="0.72" FontSize="11" Margin="5,1,0,0" VerticalAlignment="Top" Visibility="{Binding IsInactive, Converter={StaticResource BooleanVisibility}}"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PurchasePriceDisplay}" Foreground="{Binding PurchasePriceBrush}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StockDisplay}" Foreground="{Binding StockBrush}" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                </Grid>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"><ProgressBar Width="140" Height="4" IsIndeterminate="True"/><TextBlock Text="Loading products…" Margin="0,10,0,0" Foreground="#63717D"/></StackPanel>
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Product not found" FontWeight="SemiBold" Foreground="#47545F"/><TextBlock x:Name="EmptyMessage" Text="Change your search or filters." Foreground="#7B8791" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center"/>
                        <Button x:Name="RetryButton" Content="Retry" Margin="0,12,0,0" Padding="12,6" Visibility="Collapsed" Click="OnRetryClicked"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ResultCount" Grid.Row="5" Margin="2,7,0,0" Foreground="#73808C" FontSize="11"/>
            </Grid>
        </Border>
        <Border x:Name="SidebarSeparator" Grid.Column="1" Width="5" Background="#CED2D6"/>
        <Grid Grid.Column="2">
            <Grid x:Name="NoSelectionPanel" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="No Medicine Selected" FontSize="18" FontWeight="SemiBold" Foreground="#33414D"/></Grid>
            <Grid x:Name="DetailHost" Visibility="Collapsed" Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="2,0,2,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="SidebarToggleButton" VerticalAlignment="Top" Width="28" Height="28" Margin="0,0,6,0" Padding="5" ToolTip="Show / hide sidebar" Click="OnToggleSidebarClicked"><Path x:Name="SidebarToggleIcon" Data="M2,2 L14,2 L14,14 L2,14 Z M6,2 L6,14" Stroke="#40535E" StrokeThickness="1.5" Stretch="Uniform"/></Button>
