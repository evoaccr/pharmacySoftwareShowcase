                                    <DataGridTemplateColumn Header="Product" SortMemberPath="DisplayName" ClipboardContentBinding="{Binding DisplayName}" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" ContextMenu="{StaticResource ProductActionMenu}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Price Difference" Binding="{Binding PriceDifference}" SortMemberPath="PriceDifferenceValue" SortDirection="Ascending" Width="95" MinWidth="75"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="60" MinWidth="50"/>
                                    <DataGridTextColumn Header="Current Purchase Price" Binding="{Binding InstantOrderPrice}" Width="95" MinWidth="75"/>
                                    <DataGridTemplateColumn Header="Promotional Purchase Price" ClipboardContentBinding="{Binding CampaignOrderPrice}" Width="110" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CampaignOrderPrice}" Foreground="{Binding CampaignBrush}" HorizontalAlignment="Center" TextAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="3" Text="Equivalents" FontSize="16" FontWeight="SemiBold" Foreground="#273640" Margin="2,12,0,7"/>
                            <DataGrid x:Name="GeneralEquivalentGrid" Grid.Row="4" Style="{StaticResource CatalogGrid}" MouseDoubleClick="OnEquivalentDoubleClicked" MinHeight="130">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Product" SortMemberPath="DisplayName" ClipboardContentBinding="{Binding DisplayName}" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" ContextMenu="{StaticResource ProductActionMenu}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Price Difference" Binding="{Binding PriceDifference}" SortMemberPath="PriceDifferenceValue" SortDirection="Ascending" Width="95" MinWidth="75"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="60" MinWidth="50"/>
                                    <DataGridTextColumn Header="Current Purchase Price" Binding="{Binding InstantOrderPrice}" Width="95" MinWidth="75"/>
                                    <DataGridTemplateColumn Header="Promotional Purchase Price" ClipboardContentBinding="{Binding CampaignOrderPrice}" Width="110" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CampaignOrderPrice}" Foreground="{Binding CampaignBrush}" HorizontalAlignment="Center" TextAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="KubTab" Header="SmPC" Visibility="{Binding HasKubDocument, Converter={StaticResource BooleanVisibility}}">
                        <Grid Background="#E9EDF0">
                            <wv2:WebView2 x:Name="KubPdfViewer" Visibility="Collapsed"/>
                            <Border x:Name="KubPdfStatus" Background="#F7F9FA" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="KubPdfStatusText" Text="Preparing SmPC document…" Foreground="#52616C"/></Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="KitTab" Header="Patient Leaflet" Visibility="{Binding HasKitDocument, Converter={StaticResource BooleanVisibility}}">
                        <Grid Background="#E9EDF0">
                            <wv2:WebView2 x:Name="KitPdfViewer" Visibility="Collapsed"/>
                            <Border x:Name="KitPdfStatus" Background="#F7F9FA" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="KitPdfStatusText" Text="Preparing patient leaflet…" Foreground="#52616C"/></Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="QR Codes">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <WrapPanel Margin="2,0,0,9">
                                <CheckBox x:Name="InactiveQrToggle" Content="Show inactive items" Margin="0,0,18,0" VerticalAlignment="Center" Checked="OnQrFilterChanged" Unchecked="OnQrFilterChanged"/>
                                <StackPanel x:Name="InactiveQrQuickDates" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed">
                                    <Button Content="Today" Tag="Day" Style="{StaticResource QrPresetButton}" Click="OnQrPeriodPresetClicked"/>
                                    <Button Content="This Week" Tag="Week" Style="{StaticResource QrPresetButton}" Click="OnQrPeriodPresetClicked"/>
                                    <Button Content="This Month" Tag="Month" Style="{StaticResource QrPresetButton}" Click="OnQrPeriodPresetClicked"/>
                                    <Button Content="This Year" Tag="Year" Style="{StaticResource QrPresetButton}" Click="OnQrPeriodPresetClicked"/>
                                </StackPanel>
                                <TextBlock x:Name="InactiveQrDateLabel" Text="Start:" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <DatePicker x:Name="InactiveQrSincePicker" Width="125" Height="32" VerticalContentAlignment="Center" SelectedDateChanged="OnQrFilterChanged" Visibility="Collapsed"/>
                            </WrapPanel>
                            <DataGrid x:Name="QrCodeGrid" Grid.Row="1" Style="{StaticResource CatalogGrid}" PreviewMouseRightButtonDown="OnQrGridPreviewMouseRightButtonDown" ContextMenuOpening="OnQrGridContextMenuOpening">
                                <DataGrid.ContextMenu><ContextMenu><MenuItem x:Name="QrOpenMovementsMenuItem" Header="View Movements" Click="OnOpenQrMovementsClicked"/><MenuItem x:Name="QrCopySingleMenuItem" Header="Copy QR Code" Click="OnCopyQrCodeClicked"/><MenuItem x:Name="QrCopyMultipleMenuItem" Header="Copy QR Codes" Click="OnCopyQrCodesClicked" Visibility="Collapsed"/></ContextMenu></DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="QR Codes" Binding="{Binding QrCode}" Width="*"/>
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDateDisplay}" ElementStyle="{StaticResource CenteredGridText}" Width="110"/>
                                    <DataGridTextColumn Header="Purchase Price" Binding="{Binding PurchasePriceDisplay}" ElementStyle="{StaticResource CenteredGridText}" Width="115"/>
                                    <DataGridTextColumn x:Name="QrMovementDateColumn" Header="Entry Date" Binding="{Binding MovementDateDisplay}" ElementStyle="{StaticResource CenteredGridText}" Width="145"/>
                                    <DataGridTextColumn x:Name="QrExitPriceColumn" Header="Issue Price" Binding="{Binding ExitPriceDisplay}" ElementStyle="{StaticResource CenteredGridText}" Width="115" Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="QrProfitColumn" Header="Profit" Binding="{Binding ProfitDisplay}" ElementStyle="{StaticResource CenteredGridText}" Width="100" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Details">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0"><WrapPanel>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HeaderFilterButton}" Tag="ProductPrefix" Click="OnHeaderFilterClicked"/><Button Style="{StaticResource CopyValueButton}" Tag="{Binding ProductPrefixDisplay}" Click="OnCopyValueClicked"/></StackPanel><TextBlock Text="Product Prefix" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding ProductPrefixDisplay, Mode=OneWay}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="{Binding OldNameDisplay}" Click="OnCopyValueClicked"/><TextBlock Text="Previous Name" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding OldNameDisplay, Mode=OneWay}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HeaderFilterButton}" Tag="SgkCode" Click="OnHeaderFilterClicked"/><Button Style="{StaticResource CopyValueButton}" Tag="{Binding SgkCode}" Click="OnCopyValueClicked"/></StackPanel><TextBlock Text="SGK Code" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding SgkCode, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HeaderFilterButton}" Tag="AtcCode" Click="OnHeaderFilterClicked"/><Button Style="{StaticResource CopyValueButton}" Tag="{Binding AtcCode}" Click="OnCopyValueClicked"/></StackPanel><TextBlock Text="ATC Code" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding AtcCode, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HeaderFilterButton}" Tag="CompanyName" Click="OnHeaderFilterClicked"/><Button Style="{StaticResource CopyValueButton}" Tag="{Binding CompanyName}" Click="OnCopyValueClicked"/></StackPanel><TextBlock Text="Company" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding CompanyName, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="{Binding PregnancyCategory}" Click="OnCopyValueClicked"/><TextBlock Text="Pregnancy Category" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding PregnancyCategory, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="{Binding Origin}" Click="OnCopyValueClicked"/><TextBlock Text="Originator" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding Origin, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="{Binding ShelfLife}" Click="OnCopyValueClicked"/><TextBlock Text="Shelf Life" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding ShelfLife, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HeaderFilterButton}" Tag="GenericCode" Click="OnHeaderFilterClicked"/><Button Style="{StaticResource CopyValueButton}" Tag="{Binding GenericCode}" Click="OnCopyValueClicked"/></StackPanel><TextBlock Text="Generic Code" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding GenericCode, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="{Binding EquivalentClassification}" Click="OnCopyValueClicked"/><TextBlock Text="Reference / Equivalent" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding EquivalentClassification, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HeaderFilterButton}" Tag="EquivalentGroupCode" Click="OnHeaderFilterClicked"/><Button Style="{StaticResource CopyValueButton}" Tag="{Binding EquivalentGroupCode}" Click="OnCopyValueClicked"/></StackPanel><TextBlock Text="Equivalent Code" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding EquivalentGroupCode, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250" Visibility="{Binding IsBrandNameMissing, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="—" Click="OnCopyValueClicked"/><TextBlock Text="Brand Name" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="—" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250" Visibility="{Binding IsBarcodeMissing, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="—" Click="OnCopyValueClicked"/><TextBlock Text="Barcode" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="—" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250" Visibility="{Binding IsPackageDescriptionMissing, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="—" Click="OnCopyValueClicked"/><TextBlock Text="Package Quantity" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="—" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250" Visibility="{Binding IsPharmaceuticalFormMissing, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="—" Click="OnCopyValueClicked"/><TextBlock Text="Pharmaceutical Form" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="—" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250" Visibility="{Binding IsActiveIngredientMissing, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="—" Click="OnCopyValueClicked"/><TextBlock Text="Active Ingredient" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="—" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250" Visibility="{Binding IsPrescriptionTypeMissing, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="—" Click="OnCopyValueClicked"/><TextBlock Text="Prescription Color" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="—" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250" Visibility="{Binding IsReimbursementStatusMissing, Converter={StaticResource BooleanVisibility}}"><StackPanel><TextBlock Text="Payment Status" Style="{StaticResource FieldLabel}"/><TextBox Text="—" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250" Visibility="{Binding IsIndicationMissing, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="—" Click="OnCopyValueClicked"/><TextBlock Text="Indication" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="—" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource FieldCard}" Width="250" Visibility="{Binding IsDosageInstructionsMissing, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="—" Click="OnCopyValueClicked"/><TextBlock Text="Medicine Instructions" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="—" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                        </WrapPanel></ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="SutTab" Header="SUT" Visibility="{Binding HasSutContent, Converter={StaticResource BooleanVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0"><StackPanel>
                            <TextBlock Text="SUT Summary" FontSize="18" FontWeight="SemiBold" Foreground="#273640" Margin="2,0,0,2"/>
                            <TextBlock Text="{Binding SutOverviewDateDisplay}" Foreground="#697782" FontSize="11" Margin="2,0,0,9"/>
                            <ItemsControl ItemsSource="{Binding VisibleSutOverviewSections}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Expander Margin="0,0,0,8" Background="White" BorderBrush="#C8CDD2" BorderThickness="1" Padding="12">
                                    <Expander.Header><DockPanel MinWidth="320"><Border DockPanel.Dock="Right" CornerRadius="0" Padding="7,2" Margin="12,0,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BooleanVisibility}}"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EAF1F2"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Ödenir"><Setter Property="Background" Value="#D9F0E2"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Ödenmez"><Setter Property="Background" Value="#F8DAD7"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Status}" Foreground="#40535E" FontSize="11"/></Border><TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="#263740"/></DockPanel></Expander.Header>
                                    <StackPanel Margin="6,10,4,4">
                                        <TextBox Text="{Binding Content, Mode=OneWay}" TextWrapping="Wrap" Foreground="#26333D" FontSize="13"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SelectableFieldValue}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasDetails}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                                        <ItemsControl ItemsSource="{Binding DetailItems}"><ItemsControl.ItemTemplate><DataTemplate>
                                            <Expander Margin="0,0,0,7" Background="#F5F8F9" BorderBrush="#D5DEE3" BorderThickness="1" Padding="10">
                                                <Expander.Header><TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="#334751"/></Expander.Header>
                                                <TextBox Text="{Binding Content, Mode=OneWay}" Margin="8,8,4,3" TextWrapping="Wrap" Foreground="#34434E" FontSize="12" Style="{StaticResource SelectableFieldValue}"/>
                                            </Expander>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Separator Margin="0,5,0,12"/>
                            <ItemsControl ItemsSource="{Binding SutRuleItems}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" Foreground="#263740" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,6,0,10">
                                            <Border Background="#EAF4F3" CornerRadius="0" Padding="8,3" Margin="0,0,7,0"><TextBox Text="{Binding Reference, Mode=OneWay, StringFormat=Referans: {0}}" Style="{StaticResource SelectableFieldValue}" Foreground="#306B67" FontSize="11"/></Border>
                                            <Border Background="#F0F2F4" CornerRadius="0" Padding="8,3"><TextBox Text="{Binding EffectiveDate, Mode=OneWay, StringFormat=Geçerlilik: {0}}" Style="{StaticResource SelectableFieldValue}" Foreground="#586671" FontSize="11"/></Border>
                                        </WrapPanel>
                                        <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" Foreground="#26333D" FontSize="13" Style="{StaticResource SelectableFieldValue}"/>
                                        <Expander Header="Archive information" Margin="0,10,0,0" Foreground="#52616C"><TextBox Text="{Binding Archive, Mode=OneWay}" TextWrapping="Wrap" Foreground="#66747F" Margin="10,5,0,0" Style="{StaticResource SelectableFieldValue}"/></Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
    </DockPanel>
</UserControl>
