                                <WrapPanel>
                                    <Border Style="{StaticResource FieldCard}" Width="195">
                                        <StackPanel><TextBlock Text="Shelf Stock" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Analysis.ShelfStockDisplay, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCard}" Width="195">
                                        <StackPanel><TextBlock Text="Consignment Stock" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Analysis.ConsignedStockDisplay, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCard}" Width="195" Background="#F8F9FA">
                                        <StackPanel><TextBlock Text="In Transit" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Analysis.NotImplementedDisplay, Mode=OneWay, TargetNullValue='Henüz uygulanmadı'}" Style="{StaticResource SelectableFieldValue}" Foreground="#89939B"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCard}" Width="195">
                                        <StackPanel><TextBlock Text="Average Monthly Sales" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Analysis.AverageMonthlySalesDisplay, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                    </Border>
