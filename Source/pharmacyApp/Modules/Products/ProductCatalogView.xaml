                                                <TextBlock Text="Month" Margin="6,0,8,0" VerticalAlignment="Center" Foreground="#52616C"/>
                                                <Button Content="Save" Height="29" Padding="9,0" Click="OnSaveCurrentProductAnalysisMonthsClicked"
                                                        Background="#315A73" Foreground="White" BorderThickness="0"/>
                                            </DockPanel>
                                            <TextBlock x:Name="AnalysisSaveStatusText" FontSize="10" Foreground="#237A57" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCard}" Width="195">
                                        <StackPanel><TextBlock Text="Target Stock" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Analysis.TargetStockDisplay, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCard}" Width="195">
                                        <StackPanel><TextBlock Text="Stock Shortfall" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Analysis.MissingStockDisplay, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}" FontSize="18" FontWeight="SemiBold" Foreground="#B42318"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCard}" Width="195" Background="#EFF8F5" BorderBrush="#B7DAD0">
                                        <StackPanel><TextBlock Text="Recommendation" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Analysis.StockComment, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}" FontSize="16" FontWeight="SemiBold" Foreground="#315A73"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCard}" Width="195" Background="#F8F9FA">
                                        <StackPanel><TextBlock Text="Reserved Stock" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Analysis.NotImplementedDisplay, Mode=OneWay, TargetNullValue='Henüz uygulanmadı'}" Style="{StaticResource SelectableFieldValue}" Foreground="#89939B"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource FieldCard}" Width="195" Background="#F8F9FA">
                                        <StackPanel><TextBlock Text="Loyal Patient Stock Shortfall" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Analysis.NotImplementedDisplay, Mode=OneWay, TargetNullValue='Henüz uygulanmadı'}" Style="{StaticResource SelectableFieldValue}" Foreground="#89939B"/></StackPanel>
                                    </Border>
