                    </TabItem>
                    <TabItem Header="Price History">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="2,0,2,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Price History" FontSize="18" FontWeight="SemiBold" Foreground="#273640"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Rectangle Width="14" Height="3" Fill="#315A73" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Retail Sale" Foreground="#52616C" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <Rectangle Width="14" Height="3" Fill="#42709C" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Wholesale Selling Price" Foreground="#52616C" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="VatLegend" Orientation="Horizontal" Visibility="Collapsed">
