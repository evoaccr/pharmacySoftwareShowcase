                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}"><Setter Property="Foreground" Value="#273640"/><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLowestPrice}" Value="True"><Setter Property="Background" Value="#B9DFC9"/></DataTrigger>
