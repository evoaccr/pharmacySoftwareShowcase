                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <StackPanel Grid.Column="1">
                                    <Border Background="White" BorderBrush="#CED2D6" BorderThickness="1" CornerRadius="0" Padding="10" Margin="0,0,0,10" MinHeight="210">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding PhotoSource}" Stretch="Uniform"/>
                                            <TextBlock Text="No photo" Foreground="#8A949D" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PhotoSource}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
