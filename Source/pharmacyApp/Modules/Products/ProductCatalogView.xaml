                                    <DataGridTextColumn Header="Wholesale Selling Price" Binding="{Binding WarehousePrice, StringFormat={}{0:N2}}" ElementStyle="{StaticResource CenteredGridText}" Width="140"/>
                                    <DataGridTextColumn Header="Manufacturer Selling Price" Binding="{Binding ManufacturerPrice, StringFormat={}{0:N2}}" ElementStyle="{StaticResource CenteredGridText}" Width="140"/>
                                    <DataGridTextColumn Header="Public" Binding="{Binding PublicPrice, StringFormat={}{0:N2}}" ElementStyle="{StaticResource CenteredGridText}" Width="100"/>
                                    <DataGridTextColumn Header="Public Payment" Binding="{Binding PublicPaidPrice, StringFormat={}{0:N2}}" ElementStyle="{StaticResource CenteredGridText}" Width="125"/>
                                    <DataGridTextColumn Header="Price Difference" Binding="{Binding PriceDifferenceDisplay}" SortMemberPath="PriceDifferenceSortValue" ElementStyle="{StaticResource CenteredGridText}" Width="105"/>
                                    <DataGridTextColumn Header="Discount %" Binding="{Binding DiscountRate, StringFormat={}{0:N2}}" ElementStyle="{StaticResource CenteredGridText}" Width="95"/>
                                    <DataGridTextColumn Header="VAT %" Binding="{Binding VatRate, StringFormat={}{0:N2}}" ElementStyle="{StaticResource CenteredGridText}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
