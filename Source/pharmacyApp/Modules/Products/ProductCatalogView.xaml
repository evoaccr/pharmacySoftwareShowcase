                                    <Border Style="{StaticResource FieldCard}" Width="230" Visibility="{Binding HasPackageDescription, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="{Binding PackageDescription}" Click="OnCopyValueClicked"/><TextBlock Text="Package Quantity" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding PackageDescription, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                                    <Border Style="{StaticResource FieldCard}" Width="230" Visibility="{Binding HasPharmaceuticalForm, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HeaderFilterButton}" Tag="PharmaceuticalForm" Click="OnHeaderFilterClicked"/><Button Style="{StaticResource CopyValueButton}" Tag="{Binding PharmaceuticalForm}" Click="OnCopyValueClicked"/></StackPanel><TextBlock Text="Pharmaceutical Form" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding PharmaceuticalForm, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                                    <Border Style="{StaticResource FieldCard}" Width="230" Visibility="{Binding HasPrescriptionType, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource CopyValueButton}" Tag="{Binding PrescriptionTypeName}" Click="OnCopyValueClicked"/><TextBlock Text="Prescription Color" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding PrescriptionTypeName, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                                    <Border Style="{StaticResource FieldCard}" Width="230" Visibility="{Binding HasReimbursementStatus, Converter={StaticResource BooleanVisibility}}"><StackPanel><TextBlock Text="Payment Status" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReimbursementDisplay, Mode=OneWay}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
                                    <Border Style="{StaticResource FieldCard}" Width="230" Visibility="{Binding HasBrandName, Converter={StaticResource BooleanVisibility}}"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource HeaderFilterButton}" Tag="BrandName" Click="OnHeaderFilterClicked"/><Button Style="{StaticResource CopyValueButton}" Tag="{Binding BrandNameDisplay}" Click="OnCopyValueClicked"/></StackPanel><TextBlock Text="Brand Name" Style="{StaticResource FieldLabel}"/></DockPanel><TextBox Text="{Binding BrandNameDisplay, Mode=OneWay}" Style="{StaticResource SelectableFieldValue}"/></StackPanel></Border>
