                                                            <Image Source="{Binding Icon, Converter={StaticResource WarningIconConverter}}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Panel.ZIndex="11" Margin="0,0,0,7" Padding="2" Background="#B31D2A33" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="0" Visibility="{Binding HasMultiplePhotos, Converter={StaticResource BooleanVisibility}}">
                                                <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="34"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource PhotoNavigationButton}" ToolTip="Previous photo" Click="OnPreviousPhotoClicked"><Path Data="M7,3 L3,7 L7,11" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                                                    <TextBlock Grid.Column="1" Text="{Binding PhotoPositionDisplay}" Foreground="White" FontWeight="SemiBold" FontSize="10" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Style="{StaticResource PhotoNavigationButton}" ToolTip="Next photo" Click="OnNextPhotoClicked"><Path Data="M3,3 L7,7 L3,11" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Background="White" BorderBrush="#CED2D6" BorderThickness="1" CornerRadius="0" Padding="14">
                                        <StackPanel>
                                            <DockPanel><Border DockPanel.Dock="Right" Background="#E6E9EC" CornerRadius="0" Padding="9,4"><TextBox Text="{Binding StockDisplay, Mode=OneWay}" Style="{StaticResource SelectableFieldValue}" Foreground="{Binding StockBrush}" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock Text="Current Retail Price" FontWeight="SemiBold" Foreground="#34434E" VerticalAlignment="Center"/></DockPanel>
                                            <TextBox Text="{Binding PurchasePriceOnlyDisplay, Mode=OneWay}" Style="{StaticResource SelectableFieldValue}" FontSize="25" Foreground="{Binding PurchasePriceBrush}" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                            <Separator Margin="0,12,0,9"/><TextBlock Text="Promotional unit price" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding CampaignPurchasePriceDisplay, Mode=OneWay}" Style="{StaticResource SelectableFieldValue}" Foreground="#22845F" FontWeight="SemiBold" FontSize="15"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Analysis">
