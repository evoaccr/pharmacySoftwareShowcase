<UserControl x:Class="pharmacyApp.Modules.StockMovements.UnnotifiedItsMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Background="#F2F3F4">
    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65717E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#294C62"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#294C62"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#115E59"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArrowToggle" TargetType="ToggleButton" BasedOn="{StaticResource SquareToggleButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="0">
                            <Path x:Name="Arrow" Data="M0,0 L6,6.5 L0,13" Stroke="#4F626D" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E7F1F1"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MovementActionCardTemplate">
            <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                    CornerRadius="0" Padding="12,10" MinHeight="88">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="0" Background="{Binding IconBackground}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{Binding DirectionIcon}" Foreground="{Binding AccentBrush}" FontSize="16"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock Text="{Binding DirectionDisplay}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CreatedAtDisplay}" Foreground="#7D8A91" FontSize="11"/>
                        </DockPanel>
                        <TextBlock Text="{Binding NotificationDisplay}" Foreground="#263640" FontWeight="SemiBold" Margin="0,5,0,2"/>
                        <TextBlock Text="{Binding ReferenceDisplay}" Foreground="#61717A" FontSize="12"/>
                        <TextBlock Text="{Binding UserDisplay}" Foreground="#8A969D" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="12">
            <DockPanel LastChildFill="True">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource RefreshButtonStyle}"
                        Margin="12,15,0,0" VerticalAlignment="Top" ToolTip="Refresh"
                        AutomationProperties.Name="Refresh" Click="OnRefreshClicked">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="QR code or reference" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="SearchBox" Width="390" Height="32" Padding="9,5"
                                 VerticalContentAlignment="Center" TextChanged="OnFilterChanged"
                                 ToolTip="Search QR codes or movement references"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Status" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="StatusFilter" Width="230" Height="32" SelectedIndex="0"
                                  VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="All movements" Tag="All"/>
                            <ComboBoxItem Content="Pending Notification" Tag="Pending"/>
                            <ComboBoxItem Content="Balanced by Reverse Movement" Tag="Reversed"/>
                            <ComboBoxItem Content="ITS Notified" Tag="Notified"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E1D1CE" BorderThickness="1" CornerRadius="0" Padding="12,9">
                <DockPanel><TextBlock Text="!" Width="26" Height="26" Background="#FBE8E6" Foreground="#B33A32"
                                      FontWeight="Bold" TextAlignment="Center" Padding="0,4"/>
                    <StackPanel Margin="9,0,0,0"><TextBlock Text="Pending Notification" Foreground="#71808A" FontSize="11"/>
                        <TextBlock x:Name="PendingCountText" Text="0" Foreground="#A43731" FontSize="19" FontWeight="SemiBold"/></StackPanel></DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#CFE1E1" BorderThickness="1" CornerRadius="0" Padding="12,9">
                <DockPanel><TextBlock Text="⇄" Width="26" Height="26" Background="#E7F2F2" Foreground="#294C62"
                                      FontWeight="Bold" TextAlignment="Center" Padding="0,4"/>
                    <StackPanel Margin="9,0,0,0"><TextBlock Text="Balanced by Reverse Movement" Foreground="#71808A" FontSize="11"/>
                        <TextBlock x:Name="ReversedCountText" Text="0" Foreground="#294C62" FontSize="19" FontWeight="SemiBold"/></StackPanel></DockPanel>
            </Border>
            <Border Grid.Column="4" Background="White" BorderBrush="#CEE4D9" BorderThickness="1" CornerRadius="0" Padding="12,9">
                <DockPanel><TextBlock Text="✓" Width="26" Height="26" Background="#E5F4EC" Foreground="#167D4E"
                                      FontWeight="Bold" TextAlignment="Center" Padding="0,4"/>
                    <StackPanel Margin="9,0,0,0"><TextBlock Text="ITS Notified" Foreground="#71808A" FontSize="11"/>
                        <TextBlock x:Name="NotifiedCountText" Text="0" Foreground="#167D4E" FontSize="19" FontWeight="SemiBold"/></StackPanel></DockPanel>
            </Border>
            <Border Grid.Column="6" Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="12,9">
                <DockPanel><TextBlock Text="▦" Width="26" Height="26" Background="#EEF2F3" Foreground="#52646D"
                                      FontWeight="Bold" TextAlignment="Center" Padding="0,4"/>
                    <StackPanel Margin="9,0,0,0"><TextBlock Text="Total QR Codes" Foreground="#71808A" FontSize="11"/>
                        <TextBlock x:Name="TotalCountText" Text="0" Foreground="#52646D" FontSize="19" FontWeight="SemiBold"/></StackPanel></DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" MinHeight="18" Margin="2,0,0,8"
                   Foreground="#65717E" FontSize="13" TextWrapping="Wrap"/>

        <Grid Grid.Row="3">
            <ListBox x:Name="GroupsList" BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseRightButtonDown="OnPreviewRightClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,9"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="SelectionSurface" Background="Transparent" BorderBrush="Transparent"
                                            BorderThickness="2" CornerRadius="0" Padding="2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SelectionSurface" Property="BorderBrush" Value="#C9DADB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionSurface" Property="BorderBrush" Value="#72A9A5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0">
                            <StackPanel>
                                <Grid MinHeight="52" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource ArrowToggle}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QrCode}" FontFamily="Consolas" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#263640" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ReferenceSummary}" FontSize="11" Foreground="#849199"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="0"
                                            Padding="10,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusBrush}" FontWeight="Bold" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="4" Text="{Binding CaseCountDisplay}" VerticalAlignment="Center"
                                               Foreground="#71808A" Margin="0,0,5,0"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Cases}" Visibility="{Binding DetailsVisibility}" Margin="12,0,12,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="32,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource MovementActionCardTemplate}"/>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ConnectorIcon}" Foreground="{Binding ConnectorBrush}"
                                                               FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ConnectorText}" Foreground="{Binding ConnectorBrush}"
                                                               FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <ContentControl Grid.Column="2" Content="{Binding Right}"
                                                                ContentTemplate="{StaticResource MovementActionCardTemplate}"
                                                                Visibility="{Binding RightVisibility}"/>

                                                <Border Grid.Column="2" Visibility="{Binding PendingVisibility}" Background="#FFF8E7"
                                                        BorderBrush="#E8D39A" BorderThickness="1" CornerRadius="0" Padding="12,10" MinHeight="88">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Notification pending" Foreground="#956315" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Right-click and select Send ITS Notification."
                                                                   Foreground="#7A6A4A" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Visibility="{Binding NotifiedVisibility}" Background="#EAF7F0"
                                                        BorderBrush="#BFDCCF" BorderThickness="1" CornerRadius="0" Padding="12,10" MinHeight="88">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="✓ ITS notification sent" Foreground="#167D4E" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding CompletionDetail}" Foreground="#4D6F5E" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Visibility="Collapsed">
                <Border Width="54" Height="54" Background="#E7F2F2" CornerRadius="0" HorizontalAlignment="Center">
                    <TextBlock Text="✓" FontSize="25" Foreground="#294C62" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No movements to display" Margin="0,12,0,4" FontSize="16"
                           FontWeight="SemiBold" Foreground="#52646D" HorizontalAlignment="Center"/>
                <TextBlock Text="Change your search or status filter." Foreground="#849199"/>
            </StackPanel>

            <Border x:Name="BusyOverlay" Background="#EFFFFFFF" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                    <ProgressBar Height="5" IsIndeterminate="True" Foreground="#315A73"/>
                    <TextBlock x:Name="BusyText" Text="Loading movements..." Margin="0,12,0,0"
                               HorizontalAlignment="Center" Foreground="#52646D"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="2,8,2,0">
            <TextBlock x:Name="ResultCountText" Text="0 QR Code" Foreground="#65717E"/>
            <TextBlock DockPanel.Dock="Right" Text="Right-click a record awaiting notification." Foreground="#849199"/>
        </DockPanel>
    </Grid>
</UserControl>
