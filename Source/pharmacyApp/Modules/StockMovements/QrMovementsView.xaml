<UserControl x:Class="pharmacyApp.Modules.StockMovements.QrMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65717E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#F0F2F4"/>
            <Setter Property="Foreground" Value="#315A73"/>
            <Setter Property="BorderBrush" Value="#C6D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MovementGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8CDD2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8ECEF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style x:Key="MovementRow" TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#27343E"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Direction}" Value="Entry">
                    <Setter Property="Background" Value="#EAF7F0"/>
                    <Setter Property="Foreground" Value="#17613D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Direction}" Value="Exit">
                    <Setter Property="Background" Value="#FDEEEE"/>
                    <Setter Property="Foreground" Value="#8D2E2E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MovementCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SuggestionListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MaxHeight" Value="145"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#C8CDD2" BorderThickness="1"
                CornerRadius="0" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Width="42" Height="32"
                        Margin="12,15,0,8" VerticalAlignment="Top"
                        Background="#294C62" Foreground="White" BorderBrush="#294C62"
                        ToolTip="Refresh" AutomationProperties.Name="Refresh" Click="OnRefreshClicked">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="QR code, barcode or product name" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="SearchBox" Width="420" Height="32" Padding="9,5"
                                 VerticalContentAlignment="Center" TextChanged="OnSearchTextChanged"
                                 LostKeyboardFocus="OnSearchLostKeyboardFocus" KeyDown="OnSearchKeyDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTip="QR codes and barcodes require exact matches; product names and brands can be selected from suggestions."/>
                        <Popup x:Name="SearchSuggestionsPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="480" MaxHeight="380" Background="White" BorderBrush="#AEBCC4"
                                    BorderThickness="1" CornerRadius="0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Medicine Names" Foreground="#65717E" FontSize="11"
                                               FontWeight="SemiBold" Margin="5,2,5,3"/>
                                    <ListBox x:Name="MedicineSuggestionList" Style="{StaticResource SuggestionListStyle}"
                                             SelectionChanged="OnSuggestionSelected"
                                             PreviewKeyDown="OnSearchSuggestionListKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" Margin="7,5" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#18212B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasStock}" Value="False">
                                                                    <Setter Property="Foreground" Value="#98A1A8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Separator Margin="4,5"/>
                                    <TextBlock Text="Brands" Foreground="#65717E" FontSize="11"
                                               FontWeight="SemiBold" Margin="5,2,5,3"/>
                                    <ListBox x:Name="BrandSuggestionList" Style="{StaticResource SuggestionListStyle}"
                                             SelectionChanged="OnSuggestionSelected"
                                             PreviewKeyDown="OnSearchSuggestionListKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#18212B"
                                                           FontWeight="Bold" Margin="7,5" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Quick Date" Style="{StaticResource FilterLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Today" Tag="Day" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClicked"/>
                            <Button Content="This Week" Tag="Week" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClicked"/>
                            <Button Content="This Month" Tag="Month" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClicked"/>
                            <Button Content="This Year" Tag="Year" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClicked"/>
                            <TextBox x:Name="CustomRangeBox" Width="46" Height="32" Padding="7,5" Margin="3,0,5,0"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     PreviewTextInput="OnCustomRangePreviewTextInput"
                                     DataObject.Pasting="OnCustomRangePasting"
                                     LostKeyboardFocus="OnCustomRangeLostKeyboardFocus"
                                     KeyDown="OnCustomRangeKeyDown" ToolTip="Enter a number greater than zero."/>
                            <ComboBox x:Name="CustomRangeUnit" Width="72" Height="32" SelectedIndex="1"
                                      SelectionChanged="OnCustomRangeUnitChanged">
                                <ComboBoxItem Content="Hour" Tag="Hour"/>
                                <ComboBoxItem Content="Day" Tag="Day"/>
                                <ComboBoxItem Content="Week" Tag="Week"/>
                                <ComboBoxItem Content="Month" Tag="Month"/>
                                <ComboBoxItem Content="Year" Tag="Year"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Start" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="StartDatePicker" Width="130" Height="32"
                                    VerticalContentAlignment="Center" SelectedDateChanged="OnDateChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="End" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="EndDatePicker" Width="130" Height="32"
                                    VerticalContentAlignment="Center" SelectedDateChanged="OnDateChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Movement types" Style="{StaticResource FilterLabel}"/>
                        <ToggleButton x:Name="MovementTypeButton" Width="155" Height="32"
                                      HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="9,4"
                                      Background="#F5F8F9" BorderBrush="#CDD7DC"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=MovementTypeButton, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=MovementTypeButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="245" MaxHeight="390" Background="White" BorderBrush="#BFCBD1"
                                    BorderThickness="1" CornerRadius="0" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="MovementTypeList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Tag="{Binding Code}" Margin="2,4" VerticalContentAlignment="Center"
                                                              Click="OnMovementTypeChanged"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="Select All" Padding="9,4" Margin="0,0,6,0" Click="OnSelectAllMovementTypes"/>
                                        <Button Content="Clear" Padding="9,4" Click="OnClearMovementTypes"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Movement Address" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="AddressTypeFilter" Width="105" Height="32" SelectedIndex="0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnAddressTypeChanged"
                                  ToolTip="Select an address source.">
                            <ComboBoxItem Content="All" Tag=""/>
                            <ComboBoxItem Content="Patient" Tag="Patient"/>
                            <ComboBoxItem Content="Pharmacy" Tag="Pharmacy"/>
                            <ComboBoxItem Content="Warehouse (Depot)" Tag="Depot"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Address selection" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="AddressLookupBox" Width="190" Height="32" Padding="9,5"
                                 VerticalContentAlignment="Center" IsEnabled="False" Background="#E2E6E9"
                                 TextChanged="OnAddressSearchTextChanged"
                                 PreviewKeyDown="OnAddressSearchKeyDown"
                                 ToolTip="Select a movement address from the suggestions."/>
                        <Popup x:Name="AddressSuggestionsPopup" PlacementTarget="{Binding ElementName=AddressLookupBox}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="330" MaxHeight="260" Background="White" BorderBrush="#AEBCC4"
                                    BorderThickness="1" CornerRadius="0" Padding="6">
                                <ListBox x:Name="AddressSuggestionList" Style="{StaticResource SuggestionListStyle}"
                                         DisplayMemberPath="DisplayText" SelectionChanged="OnAddressSuggestionSelected"
                                         PreviewKeyDown="OnAddressSuggestionKeyDown"/>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="User" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="UserFilter" Width="175" Height="32" SelectedIndex="0"
                                  VerticalContentAlignment="Center" DisplayMemberPath="DisplayText"
                                  SelectionChanged="OnUserFilterChanged"
                                  ToolTip="Filter movements by user."/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid x:Name="MovementGrid" Style="{StaticResource MovementGrid}"
                      RowStyle="{StaticResource MovementRow}" MouseDoubleClick="OnMovementDoubleClicked"
                      ScrollViewer.ScrollChanged="OnMovementGridScrollChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding DisplayName}" ElementStyle="{StaticResource MovementCellText}" Width="2*" MinWidth="150"/>
                    <DataGridTextColumn Header="Movement Address" Binding="{Binding MovementAddressDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Movement Type" Binding="{Binding MovementTypeDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="*" MinWidth="135"/>
                    <DataGridTextColumn Header="Reference Code" Binding="{Binding ReferenceCodeDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="125" MinWidth="125"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding NotesDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="*" MinWidth="130"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="105" MinWidth="105"/>
                    <DataGridTextColumn Header="Movement Date" Binding="{Binding MovementDateDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="155" MinWidth="155" CanUserResize="False"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid x:Name="SplitGridHost" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Incoming Movements" Foreground="#17613D" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,7" VerticalAlignment="Center"/>
                    <DataGrid x:Name="EntryGrid" Grid.Row="1" Style="{StaticResource MovementGrid}" RowStyle="{StaticResource MovementRow}"
                              MouseDoubleClick="OnMovementDoubleClicked" ScrollViewer.ScrollChanged="OnMovementGridScrollChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding DisplayName}" ElementStyle="{StaticResource MovementCellText}" Width="2*" MinWidth="120"/>
                            <DataGridTextColumn Header="Movement Address" Binding="{Binding MovementAddressDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="*" MinWidth="95"/>
                            <DataGridTextColumn Header="Movement Type" Binding="{Binding MovementTypeDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="*" MinWidth="115"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceCodeDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="95" MinWidth="95"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding NotesDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="*" MinWidth="100"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="85" MinWidth="85"/>
                            <DataGridTextColumn Header="Movement Date" Binding="{Binding MovementDateDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="155" MinWidth="155" CanUserResize="False"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EntryCountText" Grid.Row="2" Text="Total Movements: 0" Foreground="#53616B" Margin="2,7,0,0" VerticalAlignment="Center"/>
                </Grid>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#C8CDD2"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Outgoing Movements" Foreground="#8D2E2E" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,7" VerticalAlignment="Center"/>
                    <DataGrid x:Name="ExitGrid" Grid.Row="1" Style="{StaticResource MovementGrid}" RowStyle="{StaticResource MovementRow}"
                              MouseDoubleClick="OnMovementDoubleClicked" ScrollViewer.ScrollChanged="OnMovementGridScrollChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding DisplayName}" ElementStyle="{StaticResource MovementCellText}" Width="2*" MinWidth="120"/>
                            <DataGridTextColumn Header="Movement Address" Binding="{Binding MovementAddressDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="*" MinWidth="95"/>
                            <DataGridTextColumn Header="Movement Type" Binding="{Binding MovementTypeDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="*" MinWidth="115"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceCodeDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="95" MinWidth="95"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding NotesDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="*" MinWidth="100"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="85" MinWidth="85"/>
                            <DataGridTextColumn Header="Movement Date" Binding="{Binding MovementDateDisplay}" ElementStyle="{StaticResource MovementCellText}" Width="155" MinWidth="155" CanUserResize="False"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ExitCountText" Grid.Row="2" Text="Total Movements: 0" Foreground="#53616B" Margin="2,7,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Border x:Name="StatusOverlay" Background="#EFFFFFFF" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                    <TextBlock x:Name="StatusMessage" Text="Loading..." Foreground="#52616B" FontSize="14"
                               TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="RetryButton" Content="Retry" Width="105" Height="32" Margin="0,12,0,0"
                            Visibility="Collapsed" Click="OnRefreshClicked"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,10,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="MedicineTypeCountText" Text="Medicine Types: 0" Foreground="#B42318"
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock x:Name="TotalCountText" Text="Total Movements: 0" Foreground="#53616B"
                           FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="DistinctQrCountText" Text="Distinct QR Codes: 0" Foreground="#53616B"
                           FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="SplitDirectionToggle" Grid.Column="1" Content="Separate Incoming / Outgoing"
                      Foreground="#33434E" VerticalContentAlignment="Center" VerticalAlignment="Center"
                      Checked="OnSplitDirectionChanged" Unchecked="OnSplitDirectionChanged"/>
        </Grid>
    </Grid>
</UserControl>
