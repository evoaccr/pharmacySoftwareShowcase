                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ItsQrBackendTextBox" Visibility="Collapsed"/>
                            <TextBox x:Name="ItsQrEntryTextBox" Height="40" Padding="11,8" FontSize="14"
                                     BorderBrush="#CBD7DB" BorderThickness="1" Background="White"
                                     ToolTip="Enter a QR code" PreviewKeyDown="OnItsQrEntryKeyDown"/>
                            <Button Grid.Column="2" Width="40" Height="40" Content="+" FontSize="22" FontWeight="SemiBold"
                                    Background="#315A73" Foreground="White" BorderThickness="0"
                                    ToolTip="Add QR code and list in Medula" Click="OnItsQrAddClick"/>
                        </Grid>
                        <TextBlock x:Name="ItsQrRetailMessageText" Grid.Row="1" MinHeight="18" Margin="0,7,0,8"
                                   Foreground="#B33A32" FontSize="13" TextWrapping="Wrap"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="560"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="270"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid x:Name="ItsQrMedicationTableHost">
                                    <Border VerticalAlignment="Top"
                                            MaxHeight="{Binding ActualHeight, ElementName=ItsQrMedicationTableHost}"
                                            Background="White" BorderBrush="#D5E0E3" BorderThickness="1"
                                            CornerRadius="0" ClipToBounds="True">
                                        <DataGrid x:Name="ItsQrMedicationGrid" ItemsSource="{Binding ItsQrMedicationRows}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                              CanUserSortColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E7EDEF"
                                              BorderThickness="0" RowHeight="44" ColumnHeaderHeight="38"
                                              SelectionMode="Single" SelectionUnit="FullRow">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}">
                                                <Setter Property="DetailsVisibility" Value="Collapsed"/>
                                                <Setter Property="Background" Value="#FCE8E8"/>
                                                <Setter Property="Foreground" Value="#7F2525"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBalanced}" Value="True">
                                                        <Setter Property="Background" Value="#E2F4E8"/>
                                                        <Setter Property="Foreground" Value="#225E39"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                            <Condition Binding="{Binding HasQrCodes}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="DetailsVisibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Product Name" Width="*" MinWidth="260">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <DockPanel LastChildFill="True">
                                                            <ToggleButton DockPanel.Dock="Left" Width="28" Height="28" Margin="4,0,7,0"
                                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                          Click="OnItsQrMedicationExpandClick"
                                                                          ToolTip="Show QR codes">
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource SquareToggleButtonStyle}">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderThickness" Value="0"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasQrCodes}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                                <Path Data="M0,0 L6,6.5 L0,13" Stroke="#4F626D" StrokeThickness="2.2"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round" HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </ToggleButton>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="135"/>
                                            <DataGridTextColumn Header="Prescription Count" Binding="{Binding PrescribedQuantity}" Width="95"/>
                                            <DataGridTextColumn Header="QR Code Count" Binding="{Binding QrQuantity}" Width="95"/>
                                            <DataGridTextColumn Header="ITS Sale Notification" Binding="{Binding SaleStatusText}" Width="125"/>
                                        </DataGrid.Columns>
                                        <DataGrid.RowDetailsTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding QrCodes}" Margin="38,0,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F4F8F9" BorderBrush="#E0E9EB"
                                                                    BorderThickness="0,1,0,0" Padding="12,8">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Copy QR Code" Click="OnCopyItsQrCodeClick"/>
                                                                        <MenuItem Header="Remove QR Code" Click="OnRemoveItsQrCodeClick"/>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="125"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Code}" FontFamily="Consolas"
                                                                               Foreground="#53656F" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SaleStatusText}"
                                                                               Foreground="#53656F" Padding="10,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </DataGrid.RowDetailsTemplate>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                                <WrapPanel x:Name="ItsQrPaymentPanel" Grid.Row="1" Margin="0,14,0,0"/>
                            </Grid>
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly">
                                <StackPanel Margin="0,0,3,0">
                                    <Border Background="White" BorderBrush="#D5E0E3" BorderThickness="1" CornerRadius="0" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Patient" Foreground="#71808A" FontSize="12" Margin="0,0,0,7"/>
                                        <TextBlock Text="Full name" Foreground="#71808A" FontSize="11"/>
                                        <TextBlock x:Name="ItsQrPatientNameText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#263640" Margin="0,2,0,7" TextWrapping="Wrap"/>
                                        <TextBlock Text="National ID No." Foreground="#71808A" FontSize="11"/>
                                        <TextBlock x:Name="ItsQrPatientIdentityText" Text="—" Foreground="#52616C" Margin="0,2,0,7"/>
                                        <StackPanel x:Name="ItsQrPatientPhonePanel">
                                            <TextBlock Text="Primary Phone" Foreground="#71808A" FontSize="11"/>
                                            <TextBlock x:Name="ItsQrPatientPhoneText" Text="—" Foreground="#52616C" Margin="0,2,0,7"/>
                                        </StackPanel>
                                        <StackPanel x:Name="ItsQrPatientFamilyPanel">
                                            <TextBlock Text="Family Group" Foreground="#71808A" FontSize="11"/>
                                            <TextBlock x:Name="ItsQrPatientFamilyText" Text="—" Foreground="#52616C" Margin="0,2,0,7" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                            <CheckBox x:Name="ItsQrTotalDebtCheckBox" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ItsQrPatientDebtText" Text="Total debt: TRY 0.00" Foreground="#1769AA" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="ItsQrOwnerDebtCheckBox" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ItsQrOwnerDebtText" Text="Prescription owner debt: TRY 0.00" Foreground="#1769AA" FontSize="11" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <CheckBox x:Name="ItsQrRecipientDebtCheckBox" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ItsQrRecipientDebtText" Text="Recipient debt: —" Foreground="#1769AA" FontSize="11" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="ItsQrFamilyDebtPanel" Orientation="Horizontal" Margin="0,2,0,0">
                                            <CheckBox x:Name="ItsQrFamilyDebtCheckBox" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ItsQrFamilyDebtText" Text="Family group debt: TRY 0.00" Foreground="#1769AA" FontSize="11" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </Border>
                                    <Border Background="White" BorderBrush="#D5E0E3" BorderThickness="1"
                                            CornerRadius="0" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Prescription" Foreground="#71808A" FontSize="12" Margin="0,0,0,7"/>
                                            <TextBlock x:Name="ItsQrPrescriptionText" Text="—" Foreground="#263640" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="ItsQrBalanceText" Text="0 / 0 QR Code" Foreground="#B33A32" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <WrapPanel x:Name="ItsQrActionsPanel" Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Popup x:Name="InlineRemotePopup" Grid.ColumnSpan="3" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom"
                   Closed="OnInlineRemotePopupClosed">
                <Border x:Name="InlineRemoteCard" Width="760" MaxHeight="620" Margin="8" Padding="16"
                        Background="White" BorderBrush="#BFCED4" BorderThickness="1" CornerRadius="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="InlineRemoteTitleText" FontSize="19" FontWeight="SemiBold" Foreground="#263A47"/>
                                <TextBlock x:Name="InlineRemoteMessageText" Margin="0,3,0,0" Foreground="#52616C" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="InlineRemoteDismissHint" Grid.Column="1" Text="Click outside to close" Foreground="#75838C"
                                       FontSize="10" VerticalAlignment="Top" Margin="14,4,0,0"/>
                            <Button x:Name="InlineRemoteCloseButton" Grid.Column="1" Content="×" Visibility="Collapsed"
                                    Width="32" Height="32" Margin="12,-5,-5,-5" FontSize="20"
                                    Foreground="#344852" Background="Transparent" BorderThickness="0"
                                    ToolTip="Close" Click="OnInlineRemoteCloseClick"/>
                        </Grid>
                        <WrapPanel x:Name="InlineRemoteActionsPanel" Grid.Row="1" Margin="0,10,0,5"/>
                        <ScrollViewer Grid.Row="2" MaxHeight="500" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <WrapPanel x:Name="InlineRemoteFieldsPanel" Margin="0,0,0,10"/>
                                <StackPanel x:Name="InlineRemoteTablesPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                        <WrapPanel x:Name="InlineRemoteBottomActionsPanel" Grid.Row="3"
                                   HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </Popup>
        </Grid>

        <Border x:Name="DocumentPopupLayer" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="35"
                Background="#660F1F26" Padding="24">
            <Border Width="960" MaxHeight="650" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="#BFCED4" BorderThickness="1" CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#DCEEF5" CornerRadius="0" Padding="16,11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Add Document to Prescription" FontSize="19" FontWeight="SemiBold" Foreground="#263A47"/>
                                <TextBlock x:Name="DocumentMessageText" Margin="0,3,0,0" Foreground="#52616C" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="×" Width="32" Height="32" Margin="12,-4,-4,-4"
                                    FontSize="20" Foreground="#344852" Background="Transparent" BorderThickness="0"
                                    ToolTip="Close" Click="OnCloseDocumentPopupClick"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" MaxHeight="570" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <Border BorderBrush="#D8E3E7" BorderThickness="1" CornerRadius="0" Background="#F9FBFB">
                                <StackPanel>
                                    <Border Background="#E7F2F6" CornerRadius="0" Padding="13,8">
                                        <TextBlock Text="Document Information" FontSize="14" FontWeight="SemiBold" Foreground="#294854"/>
                                    </Border>
                                    <Grid Margin="13,12,13,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Add Document" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Foreground="#52616C" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="DocumentTypeComboBox" Grid.Column="1" Height="32" Margin="0,0,8,0"
                                                  DisplayMemberPath="Text" SelectedValuePath="Value"/>
                                        <Button x:Name="DocumentSelectFileButton" Grid.Column="2" Content="Choose File" Height="32"
                                                Padding="13,0" Margin="0,0,8,0" Style="{StaticResource ActionButton}"
                                                Click="OnSelectDocumentFileClick"/>
                                        <TextBlock x:Name="DocumentFileNameText" Grid.Column="3" Text="No file selected"
                                                   VerticalAlignment="Center" Foreground="#6B7B84" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <Button x:Name="DocumentAddButton" Grid.Column="4" Content="Add Document" Height="32"
                                                Padding="15,0" Margin="10,0,0,0" Style="{StaticResource PrimaryActionButton}"
                                                Click="OnAddDocumentClick"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,13,0,0" BorderBrush="#D8E3E7" BorderThickness="1" CornerRadius="0" Background="White" Padding="0">
                                <Grid MinHeight="190">
                                    <DataGrid x:Name="DocumentTable" AutoGenerateColumns="True" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#E7ECEF" BorderThickness="0" RowHeight="36"
                                              ColumnHeaderHeight="38"/>
                                    <TextBlock x:Name="DocumentEmptyText" Text="No documents attached to this prescription"
                                               Foreground="#C43D3D" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <StackPanel x:Name="DirectoryNotificationStack" Grid.RowSpan="2" Width="410"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18"
                    Panel.ZIndex="20"/>
    </Grid>
    </DockPanel>
</UserControl>
