<UserControl x:Class="pharmacyApp.Modules.Medula.MedulaPrescriptionEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded" Background="#F4F7F8">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="#E8EFF1"/>
            <Setter Property="Foreground" Value="#24333D"/>
            <Setter Property="BorderBrush" Value="#C8D5DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52616C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="EntryBox" TargetType="TextBox" BasedOn="{StaticResource SquareTextBoxStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#C9D4D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EntryCombo" TargetType="ComboBox" BasedOn="{StaticResource SquareComboBoxStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="BorderBrush" Value="#C9D4D9"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="EntryDate" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="#C9D4D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <EventSetter Event="PreviewTextInput" Handler="OnDateTextBoxPreviewTextInput"/>
            <EventSetter Event="PreviewKeyDown" Handler="OnDateTextBoxPreviewKeyDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid>
                            <TextBlock x:Name="DateEntryHelper" Text="__/__/__" Foreground="#91A0A8" Visibility="Collapsed"
                                       Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="DateEntryHelper" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="DateEntryHelper" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DateEntryHelper" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9E2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#DCEEF5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#263A47"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="PatientCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFA"/>
            <Setter Property="BorderBrush" Value="#CBD8DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="9"/>
        </Style>
        <Style x:Key="DrugErrorIndicator" TargetType="Border">
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Placement="Mouse" HorizontalOffset="12" VerticalOffset="10"
                             Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <Border MaxWidth="560" Padding="14,11" CornerRadius="0"
                                Background="#FFF7F7" BorderBrush="#C62828" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="Medicine Validation Error" Foreground="#A61F1F"
                                           FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding ErrorText}" Foreground="#532626"
                                           FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource MedulaDataGridRowStyle}"/>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource MedulaDataGridCellStyle}"/>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MedulaDataGridColumnHeaderStyle}"/>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <TextBlock x:Name="LocalPrescriptionNotice" DockPanel.Dock="Top"
                   Text="Only local(fake,) prescriptions due to MIT version"
                   Foreground="Red" FontWeight="SemiBold" TextWrapping="Wrap" Margin="16,8,16,0"/>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="PrescriptionStatusRow" Margin="0,0,0,8" Padding="10,7"
                Background="#EAF3F6" BorderBrush="#C8DADF" BorderThickness="1" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PrescriptionLockToggleButton" Width="32" Height="30" Padding="0"
                        Visibility="Collapsed" Background="#FFFFFFAA" BorderBrush="#9EB9C2"
                        ToolTip="Change prescription QR Code status" Click="OnActionClick">
                    <TextBlock x:Name="PrescriptionLockIcon" Text=""
                               FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <TextBlock x:Name="PrescriptionSummaryText" Grid.Column="2"
                           Text="Prescription No.: 0  •  QR Code Status: —  •  Invoice Group: —"
                           Foreground="#0C5E88" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel x:Name="BrowserMessageStack" Grid.Column="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Padding="12,7" CornerRadius="0" Background="#E8F5F2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#D28B2C" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ConnectionText" Text="Preparing prescription screen" Foreground="#31544F" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="MedulaRefreshButton" Width="32" Height="28" Margin="8,0,0,0"
                            Background="#294C62" Foreground="White" BorderBrush="#294C62"
                            ToolTip="Refresh Medula prescription screen" AutomationProperties.Name="Refresh"
                            Click="OnMedulaRefreshClick">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="820"/>
                <ColumnDefinition x:Name="DebugResponseSpacer" Width="0"/>
                <ColumnDefinition x:Name="DebugResponseColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="PrescriptionScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnPrescriptionMouseWheel">
                <StackPanel MinWidth="810" Width="{Binding ViewportWidth, ElementName=PrescriptionScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="PatientInformationCard" Grid.Column="0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Border Style="{StaticResource SectionHeader}" Padding="12,4" Height="40">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Patient Information" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PatientCompactSummaryText" Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"
                                               Foreground="#466472" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                    <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Medicine" Tag="PatientDrugs" Style="{StaticResource ActionButton}" Height="28" MinWidth="48" Padding="7,0" Margin="0,0,4,0" FontSize="11" Click="OnActionClick"/>
                                        <Button Content="Report" Tag="PatientReports" Style="{StaticResource ActionButton}" Height="28" MinWidth="48" Padding="7,0" Margin="0,0,4,0" FontSize="11" Click="OnActionClick"/>
                                        <Button Content="Examination" Tag="Examinations" Style="{StaticResource ActionButton}" Height="28" MinWidth="58" Padding="7,0" Margin="0,0,4,0" FontSize="11" Click="OnActionClick"/>
                                        <Button Content="Off-label" Tag="OffLabelCombined" Style="{StaticResource ActionButton}" Height="28" MinWidth="62" Padding="7,0" Margin="0" FontSize="11" Click="OnActionClick"/>
                                    </WrapPanel>
                                    <Button x:Name="PatientInformationToggleButton" Grid.Column="3" Content="▼" Width="28" Height="28"
                                            Margin="7,0,0,0" Padding="0" Background="Transparent" BorderThickness="0"
                                            ToolTip="Hide patient information" Click="OnPatientInformationToggleClick" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="PatientInformationContent" Margin="12,9,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Prescription Owner" Style="{StaticResource FieldLabel}"/>
                                    <Border x:Name="OwnerPatientCard" Grid.Row="1" Style="{StaticResource PatientCard}" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition x:Name="OwnerPhotoSpacerColumn" Width="0"/><ColumnDefinition x:Name="OwnerPhotoColumn" Width="0"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="4"/><RowDefinition/></Grid.RowDefinitions>
                                                <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="PatientIdentityBox" Tag="owner" MaxLength="11" Style="{StaticResource EntryBox}" HorizontalAlignment="Stretch" ToolTip="National ID No." TextChanged="OnPatientLookupTextChanged"/><TextBlock Text="National ID No." Margin="9,0" VerticalAlignment="Center" Foreground="#91A0A8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PatientIdentityBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button x:Name="OwnerPatientLookupButton" Grid.Column="2" Tag="owner" Width="28" Height="28" Padding="0" Margin="0" Visibility="Collapsed" Style="{StaticResource ActionButton}" ToolTip="Verify patient with Medula and save" Click="OnPatientDirectoryLookupClick"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Button></Grid>
                                                <Grid Grid.Row="2" HorizontalAlignment="Stretch"><TextBox x:Name="OwnerPatientNameBox" Tag="owner" Style="{StaticResource EntryBox}" HorizontalAlignment="Stretch" ToolTip="Full name" TextChanged="OnPatientLookupTextChanged"/><TextBlock Text="Full name" Margin="9,0" VerticalAlignment="Center" Foreground="#91A0A8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=OwnerPatientNameBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                                            </Grid>
                                            <Border x:Name="OwnerPhotoContainer" Grid.Column="2" Width="48" Height="48" VerticalAlignment="Center" Background="#E8EFF1" CornerRadius="0" ClipToBounds="True" Visibility="Collapsed"><Image x:Name="OwnerPatientPhoto" Stretch="UniformToFill"/></Border>
                                            <Grid Grid.Row="2" Grid.ColumnSpan="3" Height="32" HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions>
                                                <DockPanel LastChildFill="True" VerticalAlignment="Center"><TextBlock DockPanel.Dock="Left" Text="Coverage:" Style="{StaticResource FieldLabel}" Margin="0" FontSize="13"/><TextBlock x:Name="CoverageValueText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#1769AA" TextTrimming="CharacterEllipsis"/></DockPanel>
                                                <DockPanel Grid.Column="1" LastChildFill="True" VerticalAlignment="Center"><TextBlock DockPanel.Dock="Left" Text="Patient Type:" Style="{StaticResource FieldLabel}" Margin="0" FontSize="13"/><TextBlock x:Name="PatientTypeValueText" Text="Normal" FontSize="13" FontWeight="SemiBold" Foreground="#1769AA" TextTrimming="CharacterEllipsis"/></DockPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Popup x:Name="OwnerSuggestionPopup" Grid.Row="1" Placement="Bottom" PlacementTarget="{Binding ElementName=OwnerPatientCard}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Width="390" MaxHeight="250" Background="White" BorderBrush="#BFCED4" BorderThickness="1" CornerRadius="0"><ListBox x:Name="OwnerSuggestionList" Tag="owner" DisplayMemberPath="DisplayText" SelectionChanged="OnPatientSuggestionSelected"/></Border>
                                    </Popup>
                                </Grid>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Medicine Recipient" Style="{StaticResource FieldLabel}"/>
                                    <Border x:Name="RecipientPatientCard" Style="{StaticResource PatientCard}">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="6"/><RowDefinition Height="32"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="RecipientPhotoColumn" Width="0"/><ColumnDefinition x:Name="RecipientPhotoSpacerColumn" Width="0"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border x:Name="RecipientPhotoContainer" Width="48" Height="48" VerticalAlignment="Center" Background="#E8EFF1" CornerRadius="0" ClipToBounds="True" Visibility="Collapsed"><Image x:Name="RecipientPatientPhoto" Stretch="UniformToFill"/></Border>
                                            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="4"/><RowDefinition/></Grid.RowDefinitions>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="RecipientIdentityBox" Tag="recipient" MaxLength="11" Style="{StaticResource EntryBox}" ToolTip="Recipient National ID" TextChanged="OnPatientLookupTextChanged" GotKeyboardFocus="OnRecipientLookupGotKeyboardFocus"/><TextBlock Text="Recipient National ID" Margin="9,0" VerticalAlignment="Center" Foreground="#91A0A8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RecipientIdentityBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button x:Name="RecipientPatientLookupButton" Grid.Column="2" Tag="recipient" Width="28" Height="28" Padding="0" Margin="0" Visibility="Collapsed" Style="{StaticResource ActionButton}" ToolTip="Verify recipient with Medula and save" Click="OnPatientDirectoryLookupClick"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Button></Grid>
                                                <Grid Grid.Row="2"><TextBox x:Name="RecipientPatientNameBox" Tag="recipient" Style="{StaticResource EntryBox}" ToolTip="Full name" TextChanged="OnPatientLookupTextChanged" GotKeyboardFocus="OnRecipientLookupGotKeyboardFocus"/><TextBlock Text="Full name" Margin="9,0" VerticalAlignment="Center" Foreground="#91A0A8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RecipientPatientNameBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                                            </Grid>
                                            <ComboBox x:Name="RecipientTypeBox" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource EntryCombo}" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="OnRecipientTypeChanged"><ComboBoxItem Content="Relationship" Tag="0"/><ComboBoxItem Content="Self" Tag="K"/><ComboBoxItem Content="Relative" Tag="Y"/><ComboBoxItem Content="Other" Tag="D"/></ComboBox>
                                        </Grid>
                                    </Border>
                                    <Popup x:Name="RecipientSuggestionPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=RecipientPatientCard}" StaysOpen="False" AllowsTransparency="True">
                                        <Border Width="390" MaxHeight="250" Background="White" BorderBrush="#BFCED4" BorderThickness="1" CornerRadius="0"><ListBox x:Name="RecipientSuggestionList" Tag="recipient" DisplayMemberPath="DisplayText" SelectionChanged="OnPatientSuggestionSelected"/></Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DoctorInformationCard" Grid.Column="2" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Border Style="{StaticResource SectionHeader}" Padding="12,4" Height="40">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Doctor Information" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DoctorCompactSummaryText" Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"
                                               Foreground="#466472" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                    <Button x:Name="DoctorInformationToggleButton" Grid.Column="2" Content="▼" Width="28" Height="24"
                                            Padding="0" Background="Transparent" BorderThickness="0"
                                            ToolTip="Hide doctor information" Click="OnDoctorInformationToggleClick" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="DoctorInformationContent" Margin="12,9,12,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="92"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Diploma Registration No." Style="{StaticResource FieldLabel}"/><TextBox x:Name="RegistrationNumberBox" MaxLength="16" Style="{StaticResource EntryBox}" KeyDown="OnRegistrationNumberKeyDown"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Doctor Type" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PhysicianTypeBox" Style="{StaticResource EntryCombo}" SelectedValuePath="Tag" SelectedIndex="0"><ComboBoxItem Content="Doctor" Tag="1"/><ComboBoxItem Content="Dentist" Tag="2"/></ComboBox></StackPanel>
                                <Button x:Name="DoctorSearchButton" Grid.Column="4" Content="Search" Tag="DoctorSearch" Style="{StaticResource ActionButton}" Margin="0,15,0,0" Click="OnActionClick"/>
                            </Grid>
                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Doctor Diploma / Registration No." Style="{StaticResource FieldLabel}"/><TextBox x:Name="PhysicianRegistrationBox" MaxLength="20" Style="{StaticResource EntryBox}"/></StackPanel>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Doctor's First Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="1" Text="/" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Doctor's Surname" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PhysicianFirstNameBox" Grid.Row="1" MaxLength="30" Style="{StaticResource EntryBox}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="/" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#52616C"/>
                                    <TextBox x:Name="PhysicianLastNameBox" Grid.Row="1" Grid.Column="2" MaxLength="30" Style="{StaticResource EntryBox}"/>
                                </Grid>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Specialty (*):" VerticalAlignment="Center" Foreground="#52616C" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BranchNameText" Text="General Practitioner" VerticalAlignment="Center" Foreground="#1769AA" FontWeight="SemiBold" Margin="4,0,8,6"/>
                                <Button Content="Select" Tag="BranchSelect" Style="{StaticResource ActionButton}" Click="OnActionClick"/>
                                <TextBlock Text="Certificate (*):" VerticalAlignment="Center" Foreground="#52616C" FontWeight="SemiBold" Margin="8,0,6,6"/>
                                <ComboBox x:Name="CertificateTypeBox" Width="145" Style="{StaticResource EntryCombo}" SelectedValuePath="Tag" SelectedIndex="0" Margin="0,0,8,6"><ComboBoxItem Content="None" Tag="0"/><ComboBoxItem Content="Hemodialysis" Tag="56"/><ComboBoxItem Content="Family Medicine" Tag="109"/></ComboBox>
                            </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Border x:Name="PrescriptionInformationHeader" Style="{StaticResource SectionHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PrescriptionInformationTitle" Text="Prescription Information" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="PrescriptionCompactSummaryText" Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"
                                               Foreground="#466472" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                    <Button x:Name="PrescriptionInformationToggleButton" Grid.Column="2" Content="▼" Width="28" Height="24"
                                            Padding="0" Background="Transparent" BorderThickness="0"
                                            ToolTip="Hide prescription information" Click="OnPrescriptionInformationToggleClick" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="PrescriptionInformationContent" Margin="12,9,12,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Coverage Type:" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/><ComboBox x:Name="ProvisionTypeBox" Grid.Column="2" Style="{StaticResource EntryCombo}" SelectedValuePath="Tag" SelectedIndex="0"><ComboBoxItem Content="Normal" Tag="1"/><ComboBoxItem Content="Traffic Accident" Tag="2"/><ComboBoxItem Content="Natural Disaster" Tag="3"/><ComboBoxItem Content="Forensic Case" Tag="4"/><ComboBoxItem Content="Workplace Accident" Tag="5"/><ComboBoxItem Content="Occupational Disease" Tag="6"/><ComboBoxItem Content="Maternity" Tag="7"/><ComboBoxItem Content="3713/21" Tag="8"/></ComboBox></Grid>
                                <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Protocol No. (*):" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/><TextBox x:Name="ProtocolNumberBox" Grid.Column="2" MaxLength="50" Style="{StaticResource EntryBox}"/></Grid>
