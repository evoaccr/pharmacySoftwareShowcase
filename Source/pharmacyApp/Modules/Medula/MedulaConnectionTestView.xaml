<UserControl x:Class="pharmacyApp.Modules.Medula.MedulaConnectionTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E8EFF1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#CAD6DC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Medula Connection Test" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Padding="12,7" CornerRadius="0" Background="#E8F5F2">
                    <TextBlock x:Name="ConnectionStateText" Text="Disconnected" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="#5E6770"/>
                </Border>
                <Button x:Name="RefreshButton" Width="34" Height="32" Margin="8,0,0,0"
                        Background="#294C62" Foreground="White" BorderBrush="#294C62"
                        ToolTip="Reconnect to Medula" AutomationProperties.Name="Refresh" Click="RefreshClick">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
            <Button x:Name="StartButton" Content="Connect" Style="{StaticResource PrimaryButton}"
                    Click="StartClick"/>
            <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource PrimaryButton}"
                    Margin="10,0,0,0" Visibility="Collapsed" Click="RetryClick"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#C8CDD2" BorderThickness="1"
                CornerRadius="0" Padding="18" MinHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Connection log" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="StatusLogText" Text="Connection has not started."
                               Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <Button Content="Show Background Browser" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" Click="ShowBrowserClick"/>
        </DockPanel>
    </Grid>
</UserControl>
