<UserControl x:Class="pharmacyApp.Modules.Medula.MedulaPrescriptionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4" Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#65717E"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Background" Value="#F0F2F4"/>
            <Setter Property="Foreground" Value="#315A73"/><Setter Property="BorderBrush" Value="#C6D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="94"/>
            <Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#294C62"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#294C62"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="RefreshButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="9,0,0,0"/><Setter Property="Background" Value="#294C62"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#294C62"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrescriptionGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MedulaDataGridStyle}">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C8CDD2"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8ECEF"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style x:Key="PrescriptionRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource MedulaDataGridRowStyle}">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#27343E"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="DetailsVisibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNoQrStatus}" Value="True">
                    <Setter Property="Background" Value="#F5E4D2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsQrFinalized}" Value="True">
                    <Setter Property="Background" Value="#DDF2DF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsQrUnfinalized}" Value="True">
                    <Setter Property="Background" Value="#F9DADA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                    <Setter Property="Background" Value="#D8DDE1"/>
                    <Setter Property="Foreground" Value="#626B72"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowMedulaDateSeparator}" Value="True">
                    <Setter Property="DetailsVisibility" Value="Visible"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="#294C62"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrescriptionCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource MedulaDataGridCellStyle}">
            <Setter Property="Padding" Value="14,0"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MedulaDataGridColumnHeaderStyle}"/>
        <Style x:Key="PrescriptionNumberCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLiveOnMedula}" Value="True">
                    <Setter Property="Background" Value="#DCEFFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrescriptionTypeCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypeI}" Value="True">
                    <Setter Property="Background" Value="#A9D3EA"/>
                    <Setter Property="Foreground" Value="#25495D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTypeK}" Value="True">
                    <Setter Property="Background" Value="#F5E4D2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrescriptionBarcodeCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBarcode}" Value="True">
                    <Setter Property="Background" Value="#F5E4D2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuggestionListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="MaxHeight" Value="210"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="ReturnStatusItemStyle" TargetType="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/><Setter Property="Padding" Value="7,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Foreground" Value="#9AA3A9"/><Setter Property="Background" Value="#F1F3F4"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <TextBlock x:Name="LocalPrescriptionNotice" DockPanel.Dock="Top"
                   Text="Only local(fake,) prescriptions due to MIT version"
                   Foreground="Red" FontWeight="SemiBold" TextWrapping="Wrap" Margin="16,8,16,0"/>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#D8E9ED" CornerRadius="0" Padding="14,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Padding="10,5" CornerRadius="0" Background="#E8F5F2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#D28B2C" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="ConnectionText" Text="Preparing" Foreground="#31544F" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="RefreshButton" Style="{StaticResource RefreshButton}" ToolTip="Refresh prescription list"
                                    AutomationProperties.Name="Refresh" Click="OnRefreshClick">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Prescription List" FontSize="16" FontWeight="SemiBold" Foreground="#294854" VerticalAlignment="Center"/>
                            <StackPanel x:Name="MergeProgressPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <ProgressBar Width="92" Height="4" IsIndeterminate="True" Foreground="#4D9FC5" Background="#D9E9F0"/>
                                <TextBlock x:Name="MergeProgressText" Margin="8,0,0,0" MaxWidth="360" TextTrimming="CharacterEllipsis"
                                           Foreground="#476672" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MergeWarningText" Visibility="Collapsed" Margin="10,0,0,0" MaxWidth="420"
                                           TextTrimming="CharacterEllipsis" Foreground="#B53C3C" FontSize="10"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <WrapPanel Grid.Row="1" Margin="12,10,12,0" VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Filter mode" Style="{StaticResource FilterLabel}"/>
                        <CheckBox x:Name="PrescriptionDateModeCheckBox" Content="Prescription Date Filter" IsChecked="True"
                                  Checked="OnFilterModeChanged" Unchecked="OnFilterModeChanged"/>
                        <CheckBox x:Name="MedulaModeCheckBox" Content="Medula Filter" Margin="0,4,0,0"
                                  Checked="OnFilterModeChanged" Unchecked="OnFilterModeChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="DateFilterPanel" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Quick Date" Style="{StaticResource FilterLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Today" Tag="Day" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClick"/>
                                <Button Content="This Week" Tag="Week" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClick"/>
                                <Button Content="This Month" Tag="Month" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClick"/>
                                <Button Content="This Year" Tag="Year" Style="{StaticResource PresetButton}" Click="OnPeriodPresetClick"/>
                                <TextBox x:Name="CustomRangeBox" Width="44" Height="32" Padding="6,4" Margin="3,0,5,0"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         PreviewTextInput="OnCustomRangePreviewTextInput" DataObject.Pasting="OnCustomRangePasting"
                                         LostKeyboardFocus="OnCustomRangeLostFocus" KeyDown="OnCustomRangeKeyDown"/>
                                <ComboBox x:Name="CustomRangeUnit" Width="72" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="Day" Tag="Day"/><ComboBoxItem Content="Week" Tag="Week"/>
                                    <ComboBoxItem Content="Month" Tag="Month"/><ComboBoxItem Content="Year" Tag="Year"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Start" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="StartDatePicker" Width="128" Height="32" VerticalContentAlignment="Center"
                                        SelectedDateChanged="OnDateFilterChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="End" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="EndDatePicker" Width="128" Height="32" VerticalContentAlignment="Center"
                                        SelectedDateChanged="OnDateFilterChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="MedulaFilterPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Medula filter type" Style="{StaticResource FilterLabel}"/>
                            <CheckBox x:Name="DailyModeCheckBox" Content="Daily" IsChecked="True"
                                      Checked="OnMedulaSubModeChanged" Unchecked="OnMedulaSubModeChanged"/>
                            <CheckBox x:Name="PeriodModeCheckBox" Content="Period" Margin="0,4,0,0"
                                      Checked="OnMedulaSubModeChanged" Unchecked="OnMedulaSubModeChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="DailyFilterPanel" Margin="0,0,12,8">
                            <TextBlock Text="Day" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="DayComboBox" Width="82" Height="32"
                                      SelectionChanged="OnMedulaFilterValueChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="PeriodFilterPanel" Margin="0,0,12,8" Visibility="Collapsed">
                            <TextBlock Text="Period" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="PeriodComboBox" Width="170" Height="32" DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectionChanged="OnMedulaFilterValueChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Prescription Group" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="GroupComboBox" Width="210" Height="32" DisplayMemberPath="Name" SelectedValuePath="Key"
                                  SelectionChanged="OnGroupChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Return Status" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="ReturnStatusComboBox" Width="160" Height="32" DisplayMemberPath="Name" SelectedValuePath="Key"
                                  ItemContainerStyle="{StaticResource ReturnStatusItemStyle}" SelectionChanged="OnReturnStatusChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Patient" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="PatientFilterBox" Width="230" Height="32" Padding="8,5" VerticalContentAlignment="Center"
                                 TextChanged="OnPatientFilterTextChanged" PreviewKeyDown="OnPatientFilterKeyDown" ToolTip="Enter at least 3 characters."/>
                        <Popup x:Name="PatientSuggestionPopup" PlacementTarget="{Binding ElementName=PatientFilterBox}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="340" MaxHeight="260" Background="White" BorderBrush="#AEBCC4" BorderThickness="1" CornerRadius="0" Padding="6">
                                <ListBox x:Name="PatientSuggestionList" Style="{StaticResource SuggestionListStyle}" DisplayMemberPath="DisplayText"
                                         SelectionChanged="OnPatientSuggestionSelected" PreviewKeyDown="OnPatientSuggestionKeyDown"/>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Type" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="TypeFilterComboBox" Width="125" Height="32" SelectionChanged="OnLocalFilterChanged">
                            <ComboBoxItem Content="All" Tag=""/>
                            <ComboBoxItem Content="Electronic" Tag="I"/>
                            <ComboBoxItem Content="Paper" Tag="K"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Prescription No." Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="PrescriptionNumberFilterBox" Width="125" Height="32" Padding="8,5"
                                 VerticalContentAlignment="Center" TextChanged="OnLocalFilterChanged"/>
                    </StackPanel>
                    <Button Content="Query" Style="{StaticResource PrimaryButton}" Margin="0,15,0,8" Click="OnSearchClick"/>
                    <Button x:Name="DetailedFilterButton" Content="Advanced Filters" Height="32" Padding="13,0"
                            Margin="8,15,0,8" Background="#F0F2F4" Foreground="#315A73" BorderBrush="#C6D0D8"
                            Click="OnDetailedFilterClick"/>
                </WrapPanel>

                <Border x:Name="DetailedFilterPanel" Grid.Row="2" Visibility="Collapsed" Margin="12,2,12,0"
                        Padding="10,9,10,1" Background="#F7F7F7" BorderBrush="#D8E4E8" BorderThickness="1" CornerRadius="0">
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Coverage" Style="{StaticResource FilterLabel}"/>
                            <TextBox x:Name="CoverageFilterBox" Width="135" Height="32" Padding="8,5"
                                     VerticalContentAlignment="Center" TextChanged="OnLocalFilterChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Last operation start date" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="LastTransactionStartPicker" Width="145" Height="32"
                                        SelectedDateChanged="OnLocalFilterChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Last operation end date" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="LastTransactionEndPicker" Width="145" Height="32"
                                        SelectedDateChanged="OnLocalFilterChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Medula filter start date" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="MedulaFilterStartPicker" Width="155" Height="32"
                                        SelectedDateChanged="OnLocalFilterChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Medula filter end date" Style="{StaticResource FilterLabel}"/>
                            <DatePicker x:Name="MedulaFilterEndPicker" Width="155" Height="32"
                                        SelectedDateChanged="OnLocalFilterChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="User" Style="{StaticResource FilterLabel}"/>
                            <TextBox x:Name="UserFilterBox" Width="145" Height="32" Padding="8,5"
                                     VerticalContentAlignment="Center" TextChanged="OnLocalFilterChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Containing this medicine (barcode or name)" Style="{StaticResource FilterLabel}"/>
                            <TextBox x:Name="MedicationFilterBox" Width="260" Height="32" Padding="8,5"
                                     VerticalContentAlignment="Center" TextChanged="OnLocalFilterChanged"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowPermanentlyDeletedCheckBox"
                                  Content="Show Permanently Deleted Prescriptions"
                                  Margin="16,19,0,8" VerticalAlignment="Center"
                                  Checked="OnPermanentDeleteFilterChanged"
                                  Unchecked="OnPermanentDeleteFilterChanged"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="WarningBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,9,0,0"
                Background="#FFF1E7" BorderBrush="#EDB484" BorderThickness="1" CornerRadius="0" Padding="11,7">
            <TextBlock x:Name="WarningText" Foreground="#943D16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="PrescriptionGrid" ItemsSource="{Binding PrescriptionView}" Style="{StaticResource PrescriptionGridStyle}"
                      RowStyle="{StaticResource PrescriptionRowStyle}" PreviewMouseLeftButtonDown="OnPrescriptionGridLeftClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Sorting="OnPrescriptionGridSorting"
                      MouseDoubleClick="OnPrescriptionRowDoubleClick"
                      PreviewMouseRightButtonDown="OnPrescriptionGridRightClick"
                      ContextMenuOpening="OnPrescriptionContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open Prescription" Click="OnOpenPrescriptionMenuClick"/>
                        <MenuItem x:Name="PrescriptionHistoryMenuItem" Header="Open Prescription Change History"
                                  Click="OnOpenPrescriptionHistoryMenuClick"/>
                        <Separator/>
                        <MenuItem x:Name="GoToPatientMenuItem" Header="Go to Patient" Tag="patient" Click="OnGoToRelatedCardClick"/>
                        <MenuItem x:Name="GoToDoctorMenuItem" Header="Go to Doctor" Tag="doctor" Click="OnGoToRelatedCardClick"/>
                        <MenuItem x:Name="GoToFacilityMenuItem" Header="Go to Facility" Tag="facility" Click="OnGoToRelatedCardClick"/>
                        <Separator/>
                        <MenuItem x:Name="PermanentDeleteMenuItem" Header="Permanently Delete Prescription"
                                  Foreground="#A12828" Visibility="Collapsed" Click="OnPermanentDeleteMenuClick"/>
                        <MenuItem x:Name="AdminDeleteMenuItem" Header="Delete Prescription as Admin"
                                  Foreground="#821A1A" FontWeight="SemiBold" Visibility="Collapsed"
                                  Click="OnAdminDeleteMenuClick"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Grid Height="25" Margin="0,1,0,2"
                              ToolTip="{Binding MedulaDateSeparatorTooltip}">
                            <Border Height="1" Margin="66,0,12,0" VerticalAlignment="Center"
                                    Background="#8DB7C1"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Border Width="55" Height="22" Background="#2F7885" CornerRadius="0">
                                    <TextBlock Text="{Binding MedulaDateSeparatorLabel}" Foreground="White"
                                               FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Path Width="11" Height="22" Stretch="Fill" Fill="#2F7885"
                                      Data="M 0,0 L 11,11 L 0,22 Z"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#E6F0F3" BorderBrush="#C8DCE2" BorderThickness="0,1,0,1"
                                        Padding="12,8" Margin="0,4,0,2">
                                    <TextBlock Text="{Binding Name}" Foreground="#294854" FontWeight="SemiBold" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Prescription No." SortMemberPath="PrescriptionNumber" Binding="{Binding PrescriptionNumber}" ElementStyle="{StaticResource PrescriptionCellText}" CellStyle="{StaticResource PrescriptionNumberCellStyle}" Width="105"/>
                    <DataGridTextColumn Header="Last Operation Date" SortMemberPath="LastTransactionDate" Binding="{Binding LastTransactionDate}" ElementStyle="{StaticResource PrescriptionCellText}" Width="110"/>
                    <DataGridTextColumn Header="Last User" SortMemberPath="LastUser" Binding="{Binding LastUser}" ElementStyle="{StaticResource PrescriptionCellText}" Width="145"/>
                    <DataGridTextColumn x:Name="MedulaFilterDateColumn" Header="Medula Filter Date" SortMemberPath="MedulaFilterDate" Binding="{Binding MedulaFilterDate}" ElementStyle="{StaticResource PrescriptionCellText}" Width="125"/>
                    <DataGridTextColumn Header="Prescription Date" SortMemberPath="PrescriptionDate" Binding="{Binding PrescriptionDate}" ElementStyle="{StaticResource PrescriptionCellText}" Width="105"/>
                    <DataGridTextColumn Header="Patient" SortMemberPath="PatientName" Binding="{Binding PatientName}" ElementStyle="{StaticResource PrescriptionCellText}" Width="2*" MinWidth="180"/>
                    <DataGridTextColumn Header="Coverage" SortMemberPath="CoverageDisplay" Binding="{Binding CoverageDisplay}" ElementStyle="{StaticResource PrescriptionCellText}" Width="90"/>
                    <DataGridTextColumn Header="QR Code" SortMemberPath="QrCodeStatusDisplay" Binding="{Binding QrCodeStatusDisplay}" ElementStyle="{StaticResource PrescriptionCellText}" Width="120"/>
                    <DataGridTextColumn Header="Type" SortMemberPath="TypeDisplay" Binding="{Binding TypeDisplay}" ElementStyle="{StaticResource PrescriptionCellText}" CellStyle="{StaticResource PrescriptionTypeCellStyle}" Width="95"/>
                    <DataGridTextColumn Header="Barcoded" SortMemberPath="BarcodeStatus" Binding="{Binding BarcodeStatus}" ElementStyle="{StaticResource PrescriptionCellText}" CellStyle="{StaticResource PrescriptionBarcodeCellStyle}" Width="85"/>
                    <DataGridTextColumn Header="Medication Report" SortMemberPath="MedicalReport" Binding="{Binding MedicalReport}" ElementStyle="{StaticResource PrescriptionCellText}" Width="88"/>
                    <DataGridTextColumn Header="Document" SortMemberPath="DocumentStatus" Binding="{Binding DocumentStatus}" ElementStyle="{StaticResource PrescriptionCellText}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Grid.Row="0" Text="No prescriptions match these criteria." Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#71818A" FontSize="14"/>
            <Border x:Name="PrescriptionDetailPanel" Grid.Row="1" Height="215" Margin="0,11,0,0" Visibility="Collapsed"
                    Background="White" BorderBrush="#C8CDD2" BorderThickness="1" CornerRadius="0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PrescriptionDetailTitle" Text="Prescription Contents" Foreground="#27343E"
                               FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <DataGrid x:Name="PrescriptionDrugDetailGrid" Grid.Row="1" Style="{StaticResource PrescriptionGridStyle}"
                              CanUserSortColumns="False" RowHeight="34" ColumnHeaderHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="150"/>
                            <DataGridTextColumn Header="Medicine Name" Binding="{Binding Name}" Width="*" MinWidth="300"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border x:Name="BusyLayer" Grid.RowSpan="2" Visibility="Collapsed" Background="#CCFFFFFF" CornerRadius="0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="190" Height="5" IsIndeterminate="True" Foreground="#294C62"/>
                    <TextBlock x:Name="BusyText" Text="Loading prescriptions…" Margin="0,10,0,0" Foreground="#405761" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock x:Name="CountText" Grid.Row="3" Text="0 Prescription" Margin="2,8,0,0" Foreground="#53616B" FontSize="12"/>

        <Popup x:Name="PrescriptionHistoryPopup" Grid.RowSpan="4"
               Placement="Center" PlacementTarget="{Binding ElementName=PrescriptionGrid}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="1040" Height="620" Background="White" BorderBrush="#B9C9CF"
                    BorderThickness="1" CornerRadius="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="#D8E9ED" CornerRadius="0" Padding="16,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HistoryTitleText" Text="Prescription Change History"
                                           Foreground="#294854" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Double-click a row to open that version."
                                           Foreground="#607B84" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30"
                                    Content="×" FontSize="18" Background="Transparent" BorderThickness="0"
                                    Foreground="#405761" ToolTip="Close" Click="OnClosePrescriptionHistoryClick"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="#F7F9FA" BorderBrush="#E1E8EB" BorderThickness="0,0,0,1" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Start" Style="{StaticResource FilterLabel}"/>
                                <DatePicker x:Name="HistoryStartDatePicker" Width="135" Height="32"
                                            SelectedDateChanged="OnHistoryDateFilterChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="End" Style="{StaticResource FilterLabel}"/>
                                <DatePicker x:Name="HistoryEndDatePicker" Width="135" Height="32"
                                            SelectedDateChanged="OnHistoryDateFilterChanged"/>
                            </StackPanel>
                            <Button Content="Clear Date Filter" Height="32" Margin="0,15,0,0" Padding="12,0"
                                    Background="#F0F2F4" BorderBrush="#C6D0D8" Foreground="#315A73"
                                    Click="OnClearHistoryDateFilterClick"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="PrescriptionHistoryGrid" Grid.Row="2" Margin="14,12,14,0"
                              ItemsSource="{Binding PrescriptionHistoryEntries}"
                              Style="{StaticResource PrescriptionGridStyle}" CanUserSortColumns="False"
                              MouseDoubleClick="OnPrescriptionHistoryRowDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource SubtleDataGridRowStyle}">
                                <Setter Property="MinHeight" Value="42"/>
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="#DDF2DF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#294C62"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Version" Binding="{Binding VersionDisplay}" Width="85"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="145"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Operation" Binding="{Binding ActionDisplay}" Width="115"/>
                            <DataGridTemplateColumn Header="Changes" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Changes}" TextWrapping="Wrap" Margin="6,7"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="HistoryCountText" Grid.Row="3" Margin="16,9,16,12"
                               Foreground="#60717A" FontSize="11"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
    </DockPanel>
</UserControl>
