<UserControl x:Class="pharmacyApp.Modules.Medula.LoyalPatientUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F3F4">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C8CDD2"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SquareButtonStyle}">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#294C62"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#294C62"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Update Loyal Patients" FontSize="18" FontWeight="SemiBold" Foreground="#18323B"/>
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Stop" Width="100" Height="38" IsEnabled="False" Click="OnCancelClicked"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel>
                    <Button Content="Save Settings" DockPanel.Dock="Right" Width="125" Height="34"
                            Click="OnSaveSettingsClicked"/>
                    <TextBlock Text="Mechanism 1 — Prescription Frequency" FontSize="17" FontWeight="SemiBold" Foreground="#18323B" VerticalAlignment="Center"/>
                </DockPanel>
                <UniformGrid Columns="5" Margin="0,14,0,0">
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Monthly frequency" Foreground="#65717E"/><TextBox x:Name="MonthlyFrequencyBox" Margin="0,5,0,0" ToolTip="1 = once a month; 0.5 = once every two months"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Minimum visit days" Foreground="#65717E"/><TextBox x:Name="MinimumVisitDaysBox" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Minimum observation period" Foreground="#65717E"/><TextBox x:Name="MinimumObservationIntervalsBox" Margin="0,5,0,0" ToolTip="Number of target prescription intervals to observe"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Frequency tolerance (%)" Foreground="#65717E"/><TextBox x:Name="FrequencyTolerancePercentBox" Margin="0,5,0,0" ToolTip="55 accepts 55% of the target frequency"/></StackPanel>
                    <StackPanel><TextBlock Text="Recency tolerance" Foreground="#65717E"/><TextBox x:Name="RecentGraceIntervalsBox" Margin="0,5,0,0" ToolTip="Allowed target intervals since the last visit"/></StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel><TextBlock x:Name="ClassificationCountText" DockPanel.Dock="Right" Text="0 / 0" Foreground="#5E6770"/><TextBlock Text="Calculate patient loyalty" FontSize="17" FontWeight="SemiBold" Foreground="#18323B"/></DockPanel>
                    <TextBlock x:Name="ClassificationMessageText" Margin="0,6,0,0" Foreground="#65717E" Text="Counts prescriptions on the same day as one visit and evaluates regular, continuous history."/>
                    <ProgressBar x:Name="ClassificationProgressBar" Height="12" Minimum="0" Maximum="1" Margin="0,12,0,0" Foreground="#294C62"/>
                </StackPanel>
                <Button x:Name="UpdatePatientsButton" Grid.Column="1" Margin="18,0,0,0" Content="Update Local Patients" Style="{StaticResource PrimaryButton}" Click="OnUpdatePatientsClicked"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel><TextBlock x:Name="HistoryCountText" DockPanel.Dock="Right" Text="0 / 0" Foreground="#5E6770"/><TextBlock Text="Synchronize loyal-patient Medula data" FontSize="17" FontWeight="SemiBold" Foreground="#18323B"/></DockPanel>
                    <TextBlock x:Name="HistoryMessageText" Margin="0,6,0,0" Foreground="#65717E" Text="Synchronizes active reports and medication history with Medula, including removing locally stored records deleted from Medula."/>
                    <ProgressBar x:Name="HistoryProgressBar" Height="12" Minimum="0" Maximum="1" Margin="0,12,0,0" Foreground="#2563A5"/>
                </StackPanel>
                <Button x:Name="UpdateHistoryButton" Grid.Column="1" Margin="18,0,0,0" Content="Update Record Data" Style="{StaticResource PrimaryButton}" Click="OnUpdateHistoryClicked"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="RunReportSampleButton" Content="Run Hybrid Sample" DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}" Click="OnRunReportSampleClicked"/>
                    <StackPanel>
                        <TextBlock Text="Mechanisms 1 + 2 + 3 — Fixed Comparison Cohort" FontSize="17" FontWeight="SemiBold" Foreground="#18323B"/>
                    </StackPanel>
                </DockPanel>
                <UniformGrid Columns="4" Margin="0,14,0,0">
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Sample patient count" Foreground="#65717E"/><TextBox x:Name="ReportSampleSizeBox" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Loyalty threshold (%)" Foreground="#65717E"/><TextBox x:Name="ReportThresholdPercentBox" Margin="0,5,0,0" ToolTip="The fulfilled-report ratio must exceed this value."/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Query interval (seconds)" Foreground="#65717E"/><TextBox x:Name="ReportDelaySecondsBox" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel><TextBlock Text="Random jitter ± (seconds)" Foreground="#65717E"/><TextBox x:Name="ReportJitterSecondsBox" Margin="0,5,0,0"/></StackPanel>
                </UniformGrid>
                <UniformGrid Columns="6" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Minimum report evidence" Foreground="#65717E"/><TextBox x:Name="MinimumReportEvidenceBox" Margin="0,5,0,0" ToolTip="Fewer reports than this are evaluated using the hybrid score."/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Hybrid threshold (points)" Foreground="#65717E"/><TextBox x:Name="HybridScoreThresholdBox" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Loyal-family bonus" Foreground="#65717E"/><TextBox x:Name="FamilyLoyalBonusBox" Margin="0,5,0,0" ToolTip="One loyal family member may be enough for a relative without history to meet the threshold."/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Additional loyal-family bonus" Foreground="#65717E"/><TextBox x:Name="FamilyAdditionalLoyalBonusBox" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Confirmed non-loyal family penalty" Foreground="#65717E"/><TextBox x:Name="FamilyUnloyalPenaltyBox" Margin="0,5,0,0" ToolTip="Only family members confirmed as non-loyal after evaluation are counted."/></StackPanel>
                    <StackPanel>
                        <CheckBox x:Name="WearOffEnabledBox" Content="Loyalty Decay" Foreground="#65717E"/>
                        <DockPanel Margin="0,5,0,0"><TextBlock Text="Day" Margin="0,2,6,0"/><TextBox x:Name="WearOffDaysBox" MinWidth="58"/></DockPanel>
                    </StackPanel>
                </UniformGrid>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock x:Name="ReportSampleCountText" DockPanel.Dock="Right" Text="0 / 0" Foreground="#5E6770"/>
                    <TextBlock x:Name="ReportSampleMessageText" Text="No sample run yet." Foreground="#65717E" TextWrapping="Wrap"/>
                </DockPanel>
                <ProgressBar x:Name="ReportSampleProgressBar" Height="12" Minimum="0" Maximum="1" Margin="0,8,0,0" Foreground="#7C3AED"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Import One Patient's History"
                               FontSize="17" FontWeight="SemiBold" Foreground="#18323B"/>
                    <TextBlock x:Name="SingleHistoryMessageText"
                               Margin="0,6,18,0" Foreground="#65717E" TextWrapping="Wrap"
                               Text="Synchronizes Medula medication and active-report history only for this patient's national ID."/>
                </StackPanel>
                <TextBox x:Name="SinglePatientTcBox" Grid.Column="1" Height="34"
                         MaxLength="11" Margin="0,0,10,0" Padding="8,5"
                         VerticalAlignment="Center" ToolTip="National ID No."/>
                <Button x:Name="SingleHistoryButton" Grid.Column="2"
                        Content="Import" Style="{StaticResource PrimaryButton}"
                        Click="OnSingleHistoryClicked"/>
            </Grid>
        </Border>
        <Border x:Name="StatusPanel" Grid.Row="6" Style="{StaticResource Card}" Margin="0,12,0,0" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#334A55"/>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
