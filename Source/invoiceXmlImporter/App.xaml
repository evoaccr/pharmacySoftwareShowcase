<Application x:Class="invoiceXmlImporter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#F3F5F7"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border" Color="#D8E0E5"/>
        <SolidColorBrush x:Key="Ink" Color="#182033"/>
        <SolidColorBrush x:Key="Muted" Color="#697386"/>
        <SolidColorBrush x:Key="Accent" Color="#0D9488"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/>
        </Style>
    </Application.Resources>
</Application>
