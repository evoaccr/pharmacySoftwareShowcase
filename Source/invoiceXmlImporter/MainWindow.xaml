<Window x:Class="invoiceXmlImporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eczacı Kart Fatura XML Aktarıcı" Width="1220" Height="760" MinWidth="1040" MinHeight="660"
        Background="{StaticResource Canvas}" FontFamily="Segoe UI" Foreground="{StaticResource Ink}"
        Closing="OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="İlk Kurulum Fatura XML Aktarıcı" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="Eski eczane programı aktarımından sonra çalışır; XML içeriğini yetkili kayıt olarak ekler veya günceller, kaydedilme durumu gibi yalnızca önceki programda bulunan bilgileri korur." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Çalışma süresi" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Fatura başına ortalama" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AverageText" Text="0,00 sn" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <Border x:Name="IncomingCard" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="Gelen Fatura" FontWeight="Bold" FontSize="14"/><TextBlock x:Name="IncomingCounts" Text="Portal 0 • Bulunan 0&#x0a;İndirilen 0 • Paketlenen 0 • Aktarılan 0" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border x:Name="OutgoingCard" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="Giden Fatura" FontWeight="Bold" FontSize="14"/><TextBlock x:Name="OutgoingCounts" Text="Portal 0 • Bulunan 0&#x0a;İndirilen 0 • Paketlenen 0 • Aktarılan 0" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border x:Name="ArchiveCard" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="E-Arşiv Faturası" FontWeight="Bold" FontSize="14"/><TextBlock x:Name="ArchiveCounts" Text="Portal 0 • Bulunan 0&#x0a;İndirilen 0 • Paketlenen 0 • Aktarılan 0" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                    <StackPanel><TextBlock Text="Aktarım sırası ve güvenli devam" FontWeight="SemiBold"/><TextBlock Text="Önce Farmassist gibi eski eczane programının aktarımını tamamlayın. Bu araç XML ayrıntılarını üzerine işler; eski programdaki kaydedilme durumu ve ilk veritabanı giriş zamanını korur. Her güvenli adım kaydedilir ve kesinti sonrası Başlat / Devam Et ile sürdürülür." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12">
                    <StackPanel>
                        <CheckBox x:Name="DebugModeCheckBox" Content="Debug modu" FontWeight="SemiBold"
                                  Checked="OnDebugOptionsChanged" Unchecked="OnDebugOptionsChanged"/>
                        <StackPanel x:Name="DebugOptionsPanel" Margin="0,10,0,0" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="OnlyTypeCheckBox" Content="Yalnızca bu türü indir"
                                          VerticalAlignment="Center" Checked="OnDebugOptionsChanged"
                                          Unchecked="OnDebugOptionsChanged"/>
                                <ComboBox x:Name="InvoiceTypeCombo" Width="145" Height="29" Margin="8,0,0,0"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Gelen Fatura" Tag="incoming-invoice"/>
                                    <ComboBoxItem Content="Giden Fatura" Tag="outgoing-invoice"/>
                                    <ComboBoxItem Content="E-Arşiv Faturası" Tag="archive-invoice"/>
                                </ComboBox>
                            </StackPanel>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Fatura sınırı (boş = tümü)" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                <TextBox x:Name="MaximumInvoicesBox" Grid.Column="1" Height="29" Padding="7,3"/>
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                                <TextBlock Text="İndirme sırası" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                <ComboBox x:Name="DownloadOrderCombo" Grid.Column="1" Height="29" SelectedIndex="0">
                                    <ComboBoxItem Content="Yeniden eskiye" Tag="NewestFirst"/>
                                    <ComboBoxItem Content="Eskiden yeniye" Tag="OldestFirst"/>
                                    <ComboBoxItem Content="Rastgele" Tag="Random"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="WithoutFarmassistCheckBox" Margin="0,9,0,0"
                                      Content="Farmassist kayıtları olmadan aktar"
                                      ToolTip="XML kayıtlarını Farmassist başlıkları ve kaydedilme durumuyla birleştirmez."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PhaseText" Text="Hazır" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="MessageText" Grid.Row="1" Text="Kaydedilmiş bir aktarımı sürdürün veya yeni aktarım başlatın." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,16"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Tür" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentTypeText" Text="—" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Ay" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentMonthText" Text="—" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="250'li paket / Alt paket" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentPageText" Text="—" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="0,20,0,0">
                        <Grid><TextBlock Text="Toplam ilerleme" FontWeight="SemiBold"/><TextBlock x:Name="ProgressCountText" Text="0 / 0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
                        <ProgressBar x:Name="OverallProgress" Height="12" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource Accent}" Background="#E5ECEF" BorderThickness="0" Margin="0,8,0,0"/>
                        <TextBlock x:Name="QrProgressText" Text="Karekod: 0 • Eksik kaynak satırı: 0 • Tekil XML kontrolü: 0"
                                   Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="4" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="#F7F9FA" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="Geçerli fatura / XML" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentInvoiceText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Background="#F7F9FA" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0"><StackPanel><TextBlock Text="Adres / taraf" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CurrentAddressText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                    </Grid>
                    <Border x:Name="ErrorPanel" Grid.Row="5" Background="#FFF1F0" BorderBrush="#E6A5A0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,20,0,0" Visibility="Collapsed" VerticalAlignment="Top">
                        <StackPanel><TextBlock Text="İşlem durduruldu" FontWeight="Bold" Foreground="#A33A32"/><TextBlock x:Name="ErrorText" Foreground="#87342E" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CheckpointText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="ClearInvoiceTablesButton" Grid.Column="1" Content="Fatura Tablolarını Temizle" Background="#B42318" Foreground="White"
                    Click="OnClearInvoiceTables" ToolTip="Yapılandırılmış veritabanındaki tüm fatura verilerini kalıcı olarak siler."/>
            <Button x:Name="NewButton" Grid.Column="3" Content="Yeni Aktarım" Background="#E3EAED" Foreground="{StaticResource Ink}" Click="OnNew"/>
            <Button x:Name="RecheckQrButton" Grid.Column="5" Content="Karekodları Yeniden Kontrol Et" Background="#E3EAED" Foreground="{StaticResource Ink}"
                    IsEnabled="False" Click="OnRecheckQr" ToolTip="İndirilmiş paketleri yeniden işler ve eksik karekodlar için tekil Eczacı Kart XML dosyasını kontrol eder."/>
            <Button x:Name="PauseButton" Grid.Column="7" Content="Duraklat" Background="#E3EAED" Foreground="{StaticResource Ink}" IsEnabled="False" Click="OnPause"/>
            <Button x:Name="StartButton" Grid.Column="9" Content="Başlat / Devam Et" Background="{StaticResource Accent}" Foreground="White" Click="OnStart"/>
        </Grid>
    </Grid>
</Window>
